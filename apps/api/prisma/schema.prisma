  warehouseTransfersTo          WarehouseTransfer[]          @relation("WarehouseTransferDestination")
  warehouseTransferLinesFrom    WarehouseTransferLine[]      @relation("WarehouseTransferLineSource")
  warehouseTransferLinesTo      WarehouseTransferLine[]      @relation("WarehouseTransferLineDestination")
  cycleCounts                   CycleCount[]
  cycleCountLines               CycleCountLine[]
