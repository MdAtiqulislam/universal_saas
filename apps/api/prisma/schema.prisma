  productionOrders              ProductionOrder[]
  productionMaterialIssues      ProductionMaterialIssue[]
  productionOutputs             ProductionOutput[]
  planningConfigurations        PlanningConfiguration[]
  planningRuns                  PlanningRun[]
  planningDemands               PlanningDemand[]
  planningSupplies              PlanningSupply[]
  planningResults               PlanningResult[]
  plannedOrders                 PlannedOrder[]
  purchaseRequisitions          PurchaseRequisition[]
  purchaseReturns               PurchaseReturn[]
  warehouseZones                WarehouseZone[]
  warehouseTasks                WarehouseTask[]
  putawayTasksAsWarehouse       PutawayTask[]                @relation("PutawayWarehouse")
  putawayTasksAsSource          PutawayTask[]                @relation("PutawaySourceLocation")
  putawayTasksAsTarget          PutawayTask[]                @relation("PutawayTargetLocation")
