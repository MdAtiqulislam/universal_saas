// ==============================================================================
// UNIVERSAL BUSINESS OPERATIONS SAAS - PRISMA SCHEMA
// Architecture: Multi-Tenant Modular Monolith with PostgreSQL
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

