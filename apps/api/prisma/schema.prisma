  item         Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant      ItemVariant?    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location     Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  batch        InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([organizationId, itemId, locationId])
  @@index([organizationId, remainingQuantity])
  @@index([organizationId, createdAt])
  @@index([organizationId, sourceDocument, sourceDocumentId])
  @@map("inventory_cost_layers")
}

/// Tenant location-aware inventory valuation summary (Weighted Average Cost & Totals).
model InventoryValuation {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  itemId           String   @map("item_id") @db.Uuid
  variantId        String?  @map("variant_id") @db.Uuid
  locationId       String   @map("location_id") @db.Uuid
  quantityOnHand   Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(18, 4)
  averageCost      Decimal  @default(0) @map("average_cost") @db.Decimal(18, 4)
  totalValue       Decimal  @default(0) @map("total_value") @db.Decimal(20, 4)
  lastCost         Decimal? @map("last_cost") @db.Decimal(18, 4)
