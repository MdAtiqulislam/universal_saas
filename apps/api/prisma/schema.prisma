/// Tenant CRM lead record tracking prospective clients and qualification lifecycle.
model Lead {
  id                     String       @id @default(uuid()) @db.Uuid
  organizationId         String       @map("organization_id") @db.Uuid
  leadNumber             String       @map("lead_number") @db.VarChar(50)
  source                 LeadSource   @default(WEBSITE)
  status                 LeadStatus   @default(NEW)
  priority               LeadPriority @default(MEDIUM)
  name                   String       @db.VarChar(200)
  companyName            String?      @map("company_name") @db.VarChar(200)
  email                  String?      @db.VarChar(255)
  phone                  String?      @db.VarChar(50)
  mobile                 String?      @db.VarChar(50)
  designation            String?      @db.VarChar(100)
  assignedEmployeeId     String?      @map("assigned_employee_id") @db.Uuid
  estimatedValue         Decimal      @default(0) @map("estimated_value") @db.Decimal(18, 4)
  expectedConversionDate DateTime?    @map("expected_conversion_date") @db.Date
  notes                  String?
  qualificationNotes     String?      @map("qualification_notes")
  lostReason             String?      @map("lost_reason")
  convertedCustomerId    String?      @map("converted_customer_id") @db.Uuid
  convertedOpportunityId String?      @map("converted_opportunity_id") @db.Uuid
  convertedAt            DateTime?    @map("converted_at") @db.Timestamptz(6)
  convertedByUserId      String?      @map("converted_by_user_id") @db.Uuid
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedEmployee     Employee?     @relation("LeadAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  convertedCustomer    Customer?     @relation(fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  convertedOpportunity Opportunity?  @relation("LeadConvertedOpportunity", fields: [convertedOpportunityId], references: [id], onDelete: SetNull)
  opportunities        Opportunity[] @relation("OpportunitySourceLead")
  crmActivities        CrmActivity[]

  @@unique([organizationId, leadNumber])
  @@index([organizationId, status])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, source])
  @@index([organizationId, priority])
  @@index([organizationId, assignedEmployeeId])
  @@index([organizationId, convertedCustomerId])
  @@map("crm_leads")
}

/// Tenant sales deal opportunity aggregate with pipeline stages and commercial value.
model Opportunity {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  opportunityNumber String            @map("opportunity_number") @db.VarChar(50)
  customerId        String            @map("customer_id") @db.Uuid
  primaryContactId  String?           @map("primary_contact_id") @db.Uuid
  leadId            String?           @map("lead_id") @db.Uuid
  ownerEmployeeId   String?           @map("owner_employee_id") @db.Uuid
  title             String            @db.VarChar(200)
  description       String?
  status            OpportunityStatus @default(OPEN)
  stage             OpportunityStage  @default(PROSPECTING)
  probability       Decimal           @default(10) @db.Decimal(5, 2)
  estimatedValue    Decimal           @default(0) @map("estimated_value") @db.Decimal(18, 4)
  expectedCloseDate DateTime?         @map("expected_close_date") @db.Date
  source            LeadSource        @default(WEBSITE)
  currencyId        String?           @map("currency_id") @db.Uuid
  lostReason        String?           @map("lost_reason")
  wonDate           DateTime?         @map("won_date") @db.Timestamptz(6)
  lostDate          DateTime?         @map("lost_date") @db.Timestamptz(6)
  closedDate        DateTime?         @map("closed_date") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  primaryContact    CustomerContact?  @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  sourceLead        Lead?             @relation("OpportunitySourceLead", fields: [leadId], references: [id], onDelete: SetNull)
  leadConvertedFrom Lead[]            @relation("LeadConvertedOpportunity")
  ownerEmployee     Employee?         @relation("OpportunityOwnerEmployee", fields: [ownerEmployeeId], references: [id], onDelete: SetNull)
  currency          Currency?         @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  lines             OpportunityLine[]
  quotations        Quotation[]
  crmActivities     CrmActivity[]

  @@unique([organizationId, opportunityNumber])
  @@index([organizationId, customerId])
  @@index([organizationId, status])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, stage])
  @@index([organizationId, ownerEmployeeId])
  @@index([organizationId, expectedCloseDate])
  @@map("crm_opportunities")
}

/// Itemized products and variants associated with an opportunity.
model OpportunityLine {
