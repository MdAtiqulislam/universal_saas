  locationId       String   @map("location_id") @db.Uuid
  stockMovementId  String?  @map("stock_movement_id") @db.Uuid
  deliveryOrderId  String?  @map("delivery_order_id") @db.Uuid
  journalEntryId   String?  @map("journal_entry_id") @db.Uuid
  quantity         Decimal  @db.Decimal(18, 4)
  unitCost         Decimal  @map("unit_cost") @db.Decimal(18, 4)
  totalCost        Decimal  @map("total_cost") @db.Decimal(20, 4)
  sourceDocument   String   @map("source_document") @db.VarChar(50)
  sourceDocumentId String?  @map("source_document_id") @db.VarChar(100)
  recordedAt       DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
