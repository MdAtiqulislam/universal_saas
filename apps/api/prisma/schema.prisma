// ------------------------------------------------------------------------------
// PERFORMANCE, SCALABILITY & CONCURRENCY FOUNDATIONS (M36)
// ------------------------------------------------------------------------------

/// Tenant idempotency key registry guaranteeing replay safety and zero duplicate financial / fulfillment mutations.
model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(255)
  action         String   @db.VarChar(100)
  resource       String?  @db.VarChar(100)
  resourceId     String?  @map("resource_id") @db.VarChar(100)
  requestHash    String?  @map("request_hash") @db.VarChar(255)
  status         String   @default("PENDING") @db.VarChar(50)
  statusCode     Int?     @map("status_code")
  responseBody   Json?    @map("response_body")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, action])
  @@index([organizationId, status])
  @@index([expiresAt])
  @@map("idempotency_records")
}

/// Tenant background job queue for asynchronous long-running reports, MRP runs, and reconciliations.
model BackgroundJob {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  jobType        String    @map("job_type") @db.VarChar(100)
  status         String    @default("PENDING") @db.VarChar(50)
  priority       Int       @default(0)
  payload        Json?
  result         Json?
  error          String?
  progress       Int       @default(0)
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, jobType])
  @@index([organizationId, createdAt])
  @@map("background_jobs")
}

// ------------------------------------------------------------------------------
// SECURITY, COMPLIANCE & PLATFORM HARDENING FOUNDATIONS (M37)
// ------------------------------------------------------------------------------

/// Append-only log of authentication attempts for brute-force detection and progressive throttling.
model LoginAttempt {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @db.VarChar(255)
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  status         String   @db.VarChar(50) // SUCCESS, FAILED, LOCKED, BLOCKED
  failureReason  String?  @map("failure_reason")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("login_attempts")
}

/// Centralized append-only security event audit repository across categorized threat domains.
model SecurityEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  category       String   @db.VarChar(50) // AUTHENTICATION, AUTHORIZATION, SESSION, TENANT_SECURITY, API_ABUSE, DATA_ACCESS, ADMINISTRATION, CONFIGURATION, INTEGRATION, SYSTEM_SECURITY
  eventType      String   @map("event_type") @db.VarChar(100)
  severity       String   @default("INFO") @db.VarChar(20) // INFO, LOW, MEDIUM, HIGH, CRITICAL
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  resource       String?  @db.VarChar(100)
  resourceId     String?  @map("resource_id") @db.VarChar(100)
  details        Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, category, createdAt])
  @@index([organizationId, severity, createdAt])
  @@index([organizationId, eventType])
  @@index([actorUserId, createdAt])
  @@map("security_events")
}

/// Tenant security policies, lockout thresholds, session lifetimes, and rate limiting parameters.
model SecurityPolicy {
  id                        String   @id @default(uuid()) @db.Uuid
  organizationId            String   @unique @map("organization_id") @db.Uuid
  maxFailedLogins           Int      @default(5) @map("max_failed_logins")
  lockoutDurationMinutes    Int      @default(15) @map("lockout_duration_minutes")
  sessionLifetimeHours      Int      @default(24) @map("session_lifetime_hours")
  sessionIdleTimeoutMinutes Int      @default(60) @map("session_idle_timeout_minutes")
  passwordMinLength         Int      @default(12) @map("password_min_length")
  passwordRequireUppercase  Boolean  @default(true) @map("password_require_uppercase")
  passwordRequireNumbers    Boolean  @default(true) @map("password_require_numbers")
  passwordRequireSymbols    Boolean  @default(true) @map("password_require_symbols")
  passwordHistoryRetention  Int      @default(5) @map("password_history_retention")
  apiRateLimitPerMinute     Int      @default(120) @map("api_rate_limit_per_minute")
  mfaEnforced               Boolean  @default(false) @map("mfa_enforced")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("security_policies")
}

// ==============================================================================
// M38 — OPERATIONAL INCIDENT MANAGEMENT MODELS
// INV-331: incidentNumber unique per platform (global sequence).
// INV-332: lifecycle: OPEN → ACKNOWLEDGED → INVESTIGATING → MITIGATED → RESOLVED → CLOSED.
// INV-333: RESOLVED/CLOSED incidents must have resolvedAt populated.
// INV-334: CLOSED incidents are immutable — no further status changes.
// ==============================================================================

/// Operational incident records for platform-level reliability management.
/// organizationId is nullable — platform-level incidents have no tenant scope.
/// INV-331: incidentNumber is globally unique.
model OperationalIncident {
  id             String           @id @default(uuid()) @db.Uuid
  /// INV-331: Globally unique incident number (auto-assigned).
  incidentNumber String           @unique @map("incident_number")
  organizationId String?          @map("organization_id") @db.Uuid
  title          String
  description    String?
  severity       IncidentSeverity
  status         IncidentStatus   @default(OPEN)
  source         IncidentSource   @default(MANUAL)
  detectedAt     DateTime         @map("detected_at") @db.Timestamptz(6)
  acknowledgedAt DateTime?        @map("acknowledged_at") @db.Timestamptz(6)
  /// INV-333: Must be populated when status transitions to RESOLVED or CLOSED.
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(6)
  closedAt       DateTime?        @map("closed_at") @db.Timestamptz(6)
  ownerUserId    String?          @map("owner_user_id") @db.Uuid
  rootCause      String?          @map("root_cause")
  resolution     String?
  /// Sanitized operational metadata — must not contain credentials or secrets.
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ownerUser    User?                   @relation("IncidentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  alertEvents  OperationalAlertEvent[]

  @@index([organizationId, status, detectedAt])
  @@index([status, severity, detectedAt])
  @@index([ownerUserId])
  @@map("operational_incidents")
}

// ==============================================================================
// M38 — OPERATIONAL ALERT RULES & EVENTS
// INV-335: Alert rule threshold must be a positive numeric value.
// INV-336: Alert deduplication prevents multiple active alerts for same rule.
// INV-337: Alert lifecycle: NORMAL → TRIGGERED → ACKNOWLEDGED → RESOLVED.
// INV-338: Resolved alert events must have resolvedAt populated.
// ==============================================================================

/// Configurable alert rule definitions for threshold-based operational monitoring.
/// INV-335: threshold must be > 0. windowSeconds must be > 0.
model OperationalAlertRule {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String?         @map("organization_id") @db.Uuid
  name            String
  description     String?
  metricKey       String          @map("metric_key")
  /// INV-335: Must be a positive numeric threshold value.
  threshold       Float
  /// Evaluation window in seconds. INV-335: Must be > 0.
  windowSeconds   Int             @map("window_seconds")
  severity        AlertSeverity
  status          AlertRuleStatus @default(ACTIVE)
  /// Cooldown period in seconds to prevent alert storms. INV-336.
  cooldownSeconds Int             @default(300) @map("cooldown_seconds")
  /// Destination metadata for notification routing (sanitized).
  destinationMeta Json?           @map("destination_meta")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alertEvents  OperationalAlertEvent[]

  @@index([organizationId, status])
  @@index([metricKey, status])
  @@map("operational_alert_rules")
}

/// Triggered alert event instances — tracks each alert activation/resolution.
/// INV-337: Lifecycle: NORMAL → TRIGGERED → ACKNOWLEDGED → RESOLVED.
/// INV-338: resolvedAt must be set when status = RESOLVED.
model OperationalAlertEvent {
  id             String           @id @default(uuid()) @db.Uuid
  alertRuleId    String           @map("alert_rule_id") @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  status         AlertEventStatus @default(TRIGGERED)
  triggeredAt    DateTime         @default(now()) @map("triggered_at") @db.Timestamptz(6)
  acknowledgedAt DateTime?        @map("acknowledged_at") @db.Timestamptz(6)
  /// INV-338: Must be populated when status = RESOLVED.
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(6)
  triggeredValue Float            @map("triggered_value")
  incidentId     String?          @map("incident_id") @db.Uuid
  /// Sanitized context snapshot at time of trigger.
  context        Json?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  alertRule    OperationalAlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  incident     OperationalIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([alertRuleId, status, triggeredAt])
  @@index([organizationId, status])
  @@index([incidentId])
  @@map("operational_alert_events")
}

// ==============================================================================
// M38 — SERVICE LEVEL OBJECTIVES
// INV-348: SLO targetValue must be a valid percentage (0–100) or positive threshold.
// INV-349: SLO compliance calculation must be deterministic.
// INV-350: TENANT-scoped SLO records must not expose cross-tenant measurements.
// ==============================================================================

/// Service Level Objective definitions and tracking.
/// INV-348: targetValue for percentage-based SLOs must be 0–100.
/// INV-350: organizationId enforces tenant scoping for TENANT scope SLOs.
model ServiceLevelObjective {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String?   @map("organization_id") @db.Uuid
  name            String
  description     String?
  metricKey       String    @map("metric_key")
  scope           SloScope
  /// INV-348: Must be a positive value; for percentage SLOs must be 0–100.
  targetValue     Float     @map("target_value")
  unit            String    @default("percent")
  windowDays      Int       @default(30) @map("window_days")
  currentValue    Float?    @map("current_value")
  status          SloStatus @default(HEALTHY)
  breachCount     Int       @default(0) @map("breach_count")
  lastEvaluatedAt DateTime? @map("last_evaluated_at") @db.Timestamptz(6)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, scope, isActive])
  @@index([metricKey, scope])
  @@map("service_level_objectives")
}

// ==============================================================================
// M38 — OPERATIONAL ERROR RECORDS
// INV-328: category and severity must use valid enum values.
// INV-329: OperationalError records must never persist plaintext credentials.
// INV-330: stackHash is a deterministic fingerprint: hash(module+errorCode+sanitizedStackSignature).
// ==============================================================================

/// Lightweight operational error records for error trend monitoring.
/// Raw stack traces are NOT stored — only sanitized fingerprints.
/// INV-329: message and metadata fields must be sanitized before persistence.
/// INV-330: stackHash is a deterministic SHA-256 fingerprint.
model OperationalError {
  id             String                   @id @default(uuid()) @db.Uuid
  /// Nullable — platform errors have no tenant scope.
  organizationId String?                  @map("organization_id") @db.Uuid
  requestId      String?                  @map("request_id")
  correlationId  String?                  @map("correlation_id")
  errorCode      String                   @map("error_code")
  category       OperationalErrorCategory
  severity       OperationalErrorSeverity
  module         String
  /// Sanitized public-safe error message — no secrets or stack traces.
  message        String
  /// INV-330: Deterministic fingerprint: SHA-256(module+errorCode+sanitizedStackSignature).
  stackHash      String?                  @map("stack_hash")
  occurredAt     DateTime                 @map("occurred_at") @db.Timestamptz(6)
  resolvedAt     DateTime?                @map("resolved_at") @db.Timestamptz(6)
  resolutionNote String?                  @map("resolution_note")
  /// Sanitized contextual metadata — must not contain credentials. INV-329.
  metadata       Json?
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, category, occurredAt])
  @@index([stackHash, occurredAt])
  @@index([module, errorCode, occurredAt])
  @@index([severity, occurredAt])
  @@map("operational_errors")
}

// ==============================================================================
// M39 — INTEGRATION PLATFORM, WEBHOOKS & EXTERNAL API FOUNDATION
// Enums for integration providers, connections, API keys, and webhook delivery
// ==============================================================================

/// INV-351: Integration provider status must use a valid lifecycle value.
enum IntegrationProviderStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
}

/// INV-352: Integration connection status must reflect actual connectivity state.
enum IntegrationConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING
}

/// INV-353: Credential type must be one of the supported authentication schemes.
enum IntegrationCredentialType {
  API_KEY
  BEARER_TOKEN
  BASIC_AUTH
  OAUTH2
  WEBHOOK_SECRET
}

/// INV-356: Webhook subscription status must be ACTIVE, INACTIVE, or FAILED.
enum WebhookSubscriptionStatus {
  ACTIVE
  INACTIVE
  FAILED
}

/// INV-360: Webhook delivery status must follow PENDING → IN_PROGRESS → SUCCESS | FAILED | DEAD_LETTER.
enum WebhookDeliveryStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
  DEAD_LETTER
}

/// INV-363: Inbound webhook event must have a valid processing status.
enum InboundWebhookStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  FAILED
  DEAD_LETTER
}

// ==============================================================================
// M39 — INTEGRATION PLATFORM MODELS
// INV-351: Provider catalog is globally shared (no organization scope).
// INV-352: IntegrationConnection is tenant-scoped with unique name per org.
// INV-353: Credentials are AES-256-GCM encrypted; only fingerprint stored.
// INV-354: API keys store only SHA-256 hash — raw key shown once on creation.
// INV-355: WebhookSubscription endpoint must pass SSRF validation before saving.
// INV-356: IntegrationEvent is immutable after creation.
// INV-357: WebhookDelivery is unique per (subscriptionId, integrationEventId).
// INV-358: InboundWebhookEvent is idempotent per (connectionId, providerEventId).
// ==============================================================================

/// Global catalog of supported third-party integration providers.
/// INV-351: providerKey is globally unique and immutable after creation.
model IntegrationProvider {
  id           String                    @id @default(uuid()) @db.Uuid
  providerKey  String                    @map("provider_key") @db.VarChar(100)
  name         String                    @db.VarChar(200)
  description  String?
  logoUrl      String?                   @map("logo_url")
  category     String                    @db.VarChar(100)
  status       IntegrationProviderStatus @default(ACTIVE)
  capabilities String[]                  @default([])
  configSchema Json?                     @map("config_schema")
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  connections IntegrationConnection[]

  @@unique([providerKey])
  @@index([status, category])
  @@map("integration_providers")
}

/// Tenant-scoped connection to a specific integration provider.
/// INV-352: Name must be unique per organization for clarity.
model IntegrationConnection {
  id              String                      @id @default(uuid()) @db.Uuid
  organizationId  String                      @map("organization_id") @db.Uuid
  providerId      String                      @map("provider_id") @db.Uuid
  name            String                      @db.VarChar(200)
  description     String?
  status          IntegrationConnectionStatus @default(PENDING)
  configData      Json?                       @map("config_data")
  lastHealthCheck DateTime?                   @map("last_health_check") @db.Timestamptz(6)
  lastError       String?                     @map("last_error")
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?                   @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider        IntegrationProvider     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  credentials     IntegrationCredential[]
  inboundWebhooks InboundWebhookEvent[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([providerId])
  @@map("integration_connections")
}

/// Encrypted integration credentials (AES-256-GCM).
/// INV-353: Raw credentials are NEVER stored — only encrypted ciphertext.
/// The fingerprint field stores a truncated SHA-256 of the plaintext for lookup.
model IntegrationCredential {
  id             String                    @id @default(uuid()) @db.Uuid
  connectionId   String                    @map("connection_id") @db.Uuid
  credentialType IntegrationCredentialType @map("credential_type")
  /// AES-256-GCM encrypted credential value. NEVER plaintext.
  encryptedValue String                    @map("encrypted_value")
  /// IV for AES-GCM decryption (hex encoded).
  iv             String                    @db.VarChar(64)
  /// Auth tag for AES-GCM (hex encoded).
  authTag        String                    @map("auth_tag") @db.VarChar(64)
  /// Truncated SHA-256 fingerprint (first 16 chars) for UI display only.
  fingerprint    String                    @db.VarChar(64)
  expiresAt      DateTime?                 @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, credentialType])
  @@map("integration_credentials")
}

/// Tenant API keys for programmatic external access.
/// INV-354: Only SHA-256 hash of the key is stored. Raw key shown ONCE on creation.
/// INV-354: keyPrefix allows users to identify keys without exposing the full hash.
model ApiKey {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  name            String    @db.VarChar(200)
  description     String?
  /// First 8 characters of the raw key, used for identification only.
  keyPrefix       String    @map("key_prefix") @db.VarChar(8)
  /// SHA-256 hash of the full raw key. NEVER store raw key.
  sha256Hash      String    @map("sha256_hash") @db.VarChar(64)
  scopes          String[]  @default([])
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason   String?   @map("revoked_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  usageRecords  ApiUsageRecord[]

  @@unique([organizationId, keyPrefix])
  @@index([sha256Hash])
  @@index([organizationId, revokedAt])
  @@map("api_keys")
}

/// Outbound webhook subscription — delivers platform events to external endpoints.
/// INV-355: endpoint must pass SSRF validation (no private IPs/loopback) before storage.
model WebhookSubscription {
  id               String                    @id @default(uuid()) @db.Uuid
  organizationId   String                    @map("organization_id") @db.Uuid
  name             String                    @db.VarChar(200)
  /// SSRF-validated HTTPS endpoint URL.
  endpoint         String
  /// HMAC-SHA256 signing secret (encrypted at rest).
  signingSecret    String                    @map("signing_secret")
  subscribedEvents String[]                  @default([]) @map("subscribed_events")
  status           WebhookSubscriptionStatus @default(ACTIVE)
  retryPolicy      Json?                     @map("retry_policy")
  timeoutSeconds   Int                       @default(30) @map("timeout_seconds")
  failureCount     Int                       @default(0) @map("failure_count")
  lastDeliveredAt  DateTime?                 @map("last_delivered_at") @db.Timestamptz(6)
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?                 @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId, status])
  @@map("webhook_subscriptions")
}

/// Immutable platform event record for outbound webhook delivery.
/// INV-356: Records are immutable. eventId is globally unique per organization.
model IntegrationEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Unique event identifier (UUID from domain event publisher).
  eventId        String   @map("event_id")
  eventType      String   @map("event_type")
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  payload        Json
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@unique([organizationId, eventId])
  @@index([organizationId, eventType, occurredAt])
  @@index([occurredAt])
  @@map("integration_events")
}

/// Outbound webhook delivery attempt record.
/// INV-357: Each (subscriptionId, integrationEventId) pair is unique.
model WebhookDelivery {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  subscriptionId     String                @map("subscription_id") @db.Uuid
  integrationEventId String                @map("integration_event_id") @db.Uuid
  status             WebhookDeliveryStatus @default(PENDING)
  attemptCount       Int                   @default(0) @map("attempt_count")
  maxAttempts        Int                   @default(5) @map("max_attempts")
  nextRetryAt        DateTime?             @map("next_retry_at") @db.Timestamptz(6)
  lastAttemptAt      DateTime?             @map("last_attempt_at") @db.Timestamptz(6)
  lastHttpStatus     Int?                  @map("last_http_status")
  lastResponseBody   String?               @map("last_response_body")
  lastErrorMessage   String?               @map("last_error_message")
  durationMs         Int?                  @map("duration_ms")
  deliveredAt        DateTime?             @map("delivered_at") @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription     WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  integrationEvent IntegrationEvent    @relation(fields: [integrationEventId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, integrationEventId])
  @@index([organizationId, status, nextRetryAt])
  @@index([subscriptionId, status])
  @@map("webhook_deliveries")
}

/// Inbound webhook event received from an external provider.
/// INV-358: (connectionId, providerEventId) is unique for idempotency.
model InboundWebhookEvent {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  connectionId    String               @map("connection_id") @db.Uuid
  /// Provider-assigned event ID for deduplication.
  providerEventId String               @map("provider_event_id")
  eventType       String               @map("event_type")
  /// Raw payload received from provider (stored for reprocessing).
  rawPayload      Json                 @map("raw_payload")
  status          InboundWebhookStatus @default(RECEIVED)
  processingError String?              @map("processing_error")
  processedAt     DateTime?            @map("processed_at") @db.Timestamptz(6)
  receivedAt      DateTime             @map("received_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, providerEventId])
  @@index([organizationId, status, receivedAt])
  @@index([connectionId, eventType])
  @@map("inbound_webhook_events")
}

// ==============================================================================
// M40 — WORKFLOW AUTOMATION, RULES ENGINE & BUSINESS PROCESS ORCHESTRATION
// ==============================================================================

/// INV-376: Logical workflow status
enum WorkflowStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// INV-380: Workflow version status (published versions are immutable)
enum WorkflowVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

/// INV-382: Node types in workflow graph
enum WorkflowNodeType {
  START
  END
  CONDITION
  ACTION
  APPROVAL
  PARALLEL
  JOIN
  DELAY
  SCHEDULE
  SUB_WORKFLOW
}

/// INV-388: Trigger types
enum WorkflowTriggerType {
  EVENT
  SCHEDULE
  MANUAL
  API
}

/// INV-394: Execution lifecycle status
enum WorkflowExecutionStatus {
  PENDING
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

/// INV-395: Step execution status
enum WorkflowStepStatus {
  PENDING
  RUNNING
  WAITING
  SUCCESS
  FAILED
  SKIPPED
}

/// INV-397: Approval status
enum WorkflowApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
  ESCALATED
}

/// Approval multi-decision logic
enum WorkflowApprovalType {
  ANY_ONE
  ALL
  MINIMUM_COUNT
  SEQUENTIAL
}

/// Target approver category
enum WorkflowApproverType {
  USER
  ROLE
  MANAGER
  OWNER
}

/// Schedule frequency type
enum WorkflowScheduleType {
  CRON
  INTERVAL
  ONE_TIME
}

/// Schedule lifecycle status
enum WorkflowScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

/// Join continuation strategy
enum WorkflowJoinStrategy {
  ALL
  ANY
  QUORUM
}

/// Tenant-scoped logical workflow definition.
/// INV-376: key is unique within organization.
/// INV-377: WorkflowDefinition is tenant-scoped.
model WorkflowDefinition {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  key              String         @db.VarChar(100)
  name             String         @db.VarChar(200)
  description      String?
  category         String         @default("GENERAL") @db.VarChar(100)
  status           WorkflowStatus @default(DRAFT)
  currentVersionId String?        @map("current_version_id") @db.Uuid
  createdByUserId  String?        @map("created_by_user_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User?               @relation("WorkflowDefinitionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  versions      WorkflowVersion[]
  triggers      WorkflowTrigger[]
  executions    WorkflowExecution[]
  schedules     WorkflowSchedule[]

  @@unique([organizationId, key])
  @@index([organizationId, status])
  @@map("workflow_definitions")
}

/// Immutable version snapshot of a workflow definition.
/// INV-378: Belongs to exactly one WorkflowDefinition.
/// INV-379: Version number is unique per WorkflowDefinition.
/// INV-380: Published WorkflowVersion is immutable.
model WorkflowVersion {
  id                   String                @id @default(uuid()) @db.Uuid
  workflowDefinitionId String                @map("workflow_definition_id") @db.Uuid
  version              Int
  status               WorkflowVersionStatus @default(DRAFT)
  checksum             String?               @db.VarChar(64)
  definitionSnapshot   Json?                 @map("definition_snapshot")
  publishedAt          DateTime?             @map("published_at") @db.Timestamptz(6)
  publishedByUserId    String?               @map("published_by_user_id") @db.Uuid
  retiredAt            DateTime?             @map("retired_at") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  workflowDefinition WorkflowDefinition  @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  publishedByUser    User?               @relation("WorkflowVersionPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  nodes              WorkflowNode[]
  edges              WorkflowEdge[]
  rules              WorkflowRule[]
  actions            WorkflowAction[]
  executions         WorkflowExecution[]

  @@unique([workflowDefinitionId, version])
  @@index([status])
  @@map("workflow_versions")
}

/// Directed graph node in a workflow version.
/// INV-382: Belongs to exactly one WorkflowVersion.
model WorkflowNode {
  id                String           @id @default(uuid()) @db.Uuid
  workflowVersionId String           @map("workflow_version_id") @db.Uuid
  nodeKey           String           @map("node_key") @db.VarChar(100)
  nodeType          WorkflowNodeType @map("node_type")
  label             String           @db.VarChar(200)
  config            Json?
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  workflowVersion WorkflowVersion         @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  sourceEdges     WorkflowEdge[]          @relation("SourceNode")
  targetEdges     WorkflowEdge[]          @relation("TargetNode")
  steps           WorkflowExecutionStep[]
  rules           WorkflowRule[]
  actions         WorkflowAction[]
  approvals       WorkflowApproval[]

  @@unique([workflowVersionId, nodeKey])
  @@index([workflowVersionId, nodeType])
  @@map("workflow_nodes")
}

/// Directed edge connecting nodes within the same workflow version.
/// INV-383: Cannot reference nodes from another workflow version.
/// INV-387: Edges reference valid source and target nodes.
model WorkflowEdge {
  id                  String   @id @default(uuid()) @db.Uuid
  workflowVersionId   String   @map("workflow_version_id") @db.Uuid
  sourceNodeId        String   @map("source_node_id") @db.Uuid
  targetNodeId        String   @map("target_node_id") @db.Uuid
  conditionRuleId     String?  @map("condition_rule_id") @db.Uuid
  conditionExpression Json?    @map("condition_expression")
  priority            Int      @default(0)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  sourceNode      WorkflowNode    @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode      WorkflowNode    @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)
  conditionRule   WorkflowRule?   @relation(fields: [conditionRuleId], references: [id], onDelete: SetNull)

  @@index([workflowVersionId, sourceNodeId])
  @@index([targetNodeId])
  @@map("workflow_edges")
}

/// Workflow trigger subscription.
/// INV-388: Belongs to the same organization as its workflow.
/// INV-389: Supported public integration events only.
model WorkflowTrigger {
  id                   String              @id @default(uuid()) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  workflowDefinitionId String              @map("workflow_definition_id") @db.Uuid
  triggerType          WorkflowTriggerType @map("trigger_type")
  eventType            String?             @map("event_type") @db.VarChar(150)
  filterExpression     Json?               @map("filter_expression")
  config               Json?
  status               WorkflowStatus      @default(ACTIVE)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)

  @@index([organizationId, triggerType, eventType])
  @@index([workflowDefinitionId])
  @@map("workflow_triggers")
}

/// Declarative rule AST representation.
/// INV-390: Valid AST with supported operators only.
model WorkflowRule {
  id                String   @id @default(uuid()) @db.Uuid
  workflowVersionId String?  @map("workflow_version_id") @db.Uuid
  nodeId            String?  @map("node_id") @db.Uuid
  name              String   @db.VarChar(200)
  ast               Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  workflowVersion WorkflowVersion? @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  node            WorkflowNode?    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  edges           WorkflowEdge[]

  @@map("workflow_rules")
}

/// Declarative workflow action attached to a node.
model WorkflowAction {
  id                String   @id @default(uuid()) @db.Uuid
  workflowVersionId String?  @map("workflow_version_id") @db.Uuid
  nodeId            String?  @map("node_id") @db.Uuid
  actionType        String   @map("action_type") @db.VarChar(100)
  parameters        Json
  retryPolicy       Json?    @map("retry_policy")
  timeoutSeconds    Int      @default(60) @map("timeout_seconds")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  workflowVersion WorkflowVersion? @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  node            WorkflowNode?    @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@map("workflow_actions")
}

/// Runtime instance of a workflow execution.
/// INV-392: Belongs to the same organization as its WorkflowDefinition.
/// INV-393: References an immutable WorkflowVersion.
/// INV-394: Cannot transition from terminal state back to RUNNING.
model WorkflowExecution {
  id                   String                  @id @default(uuid()) @db.Uuid
  organizationId       String                  @map("organization_id") @db.Uuid
  workflowDefinitionId String                  @map("workflow_definition_id") @db.Uuid
  workflowVersionId    String                  @map("workflow_version_id") @db.Uuid
  triggerType          WorkflowTriggerType     @map("trigger_type")
  triggerEventId       String?                 @map("trigger_event_id")
  status               WorkflowExecutionStatus @default(PENDING)
  startedAt            DateTime?               @map("started_at") @db.Timestamptz(6)
  completedAt          DateTime?               @map("completed_at") @db.Timestamptz(6)
  failedAt             DateTime?               @map("failed_at") @db.Timestamptz(6)
  cancelledAt          DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  currentNodeId        String?                 @map("current_node_id") @db.Uuid
  correlationId        String?                 @map("correlation_id") @db.VarChar(100)
  causationId          String?                 @map("causation_id") @db.VarChar(100)
  idempotencyKey       String?                 @map("idempotency_key") @db.VarChar(255)
  inputContext         Json?                   @map("input_context")
  outputContext        Json?                   @map("output_context")
  variables            Json?
  errorCode            String?                 @map("error_code") @db.VarChar(100)
  errorMessage         String?                 @map("error_message")
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowDefinition WorkflowDefinition      @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  workflowVersion    WorkflowVersion         @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  steps              WorkflowExecutionStep[]
  approvals          WorkflowApproval[]
  logs               WorkflowExecutionLog[]
  compensations      WorkflowCompensation[]

  @@index([organizationId, status, createdAt])
  @@index([workflowDefinitionId, workflowVersionId])
  @@index([correlationId])
  @@map("workflow_executions")
}

/// Execution step recording node transition and outcomes.
/// INV-395: Belongs to exactly one execution.
/// INV-396: Action cannot execute more than once for the same idempotency key.
model WorkflowExecutionStep {
  id             String             @id @default(uuid()) @db.Uuid
  executionId    String             @map("execution_id") @db.Uuid
  nodeId         String             @map("node_id") @db.Uuid
  status         WorkflowStepStatus @default(PENDING)
  attempt        Int                @default(1)
  idempotencyKey String?            @map("idempotency_key") @db.VarChar(255)
  input          Json?
  output         Json?
  errorCode      String?            @map("error_code") @db.VarChar(100)
  errorMessage   String?            @map("error_message")
  durationMs     Int?               @map("duration_ms")
  startedAt      DateTime?          @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?          @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  node      WorkflowNode      @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([executionId, status])
  @@index([nodeId])
  @@map("workflow_execution_steps")
}

/// Human approval request created by an APPROVAL node.
/// INV-398: Only eligible approvers can approve/reject.
model WorkflowApproval {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  executionId      String                 @map("execution_id") @db.Uuid
  nodeId           String                 @map("node_id") @db.Uuid
  approvalType     WorkflowApprovalType   @default(ANY_ONE) @map("approval_type")
  approverType     WorkflowApproverType   @default(ROLE) @map("approver_type")
  approverTarget   String                 @map("approver_target") @db.VarChar(200)
  minimumApprovals Int                    @default(1) @map("minimum_approvals")
  status           WorkflowApprovalStatus @default(PENDING)
  expiresAt        DateTime?              @map("expires_at") @db.Timestamptz(6)
  escalateAt       DateTime?              @map("escalate_at") @db.Timestamptz(6)
  escalatedTo      String?                @map("escalated_to") @db.VarChar(200)
  resolvedAt       DateTime?              @map("resolved_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  execution    WorkflowExecution        @relation(fields: [executionId], references: [id], onDelete: Cascade)
  node         WorkflowNode             @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  actions      WorkflowApprovalAction[]

  @@index([organizationId, status, expiresAt])
  @@index([executionId])
  @@map("workflow_approvals")
}

/// Individual approver decision record.
/// INV-397: An approval decision cannot be recorded twice for same actor.
model WorkflowApprovalAction {
  id                  String                 @id @default(uuid()) @db.Uuid
  approvalId          String                 @map("approval_id") @db.Uuid
  actorUserId         String                 @map("actor_user_id") @db.Uuid
  decision            WorkflowApprovalStatus
  reason              String?
  delegatedFromUserId String?                @map("delegated_from_user_id") @db.Uuid
  decidedAt           DateTime               @default(now()) @map("decided_at") @db.Timestamptz(6)

  // Relationships
  approval          WorkflowApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  actorUser         User             @relation("ApprovalActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  delegatedFromUser User?            @relation("ApprovalDelegator", fields: [delegatedFromUserId], references: [id], onDelete: SetNull)

  @@unique([approvalId, actorUserId])
  @@index([actorUserId])
  @@map("workflow_approval_actions")
}

/// Recurring and one-time schedule definition.
/// INV-399: Unique concurrent schedule execution prevention.
model WorkflowSchedule {
  id                   String                 @id @default(uuid()) @db.Uuid
  organizationId       String                 @map("organization_id") @db.Uuid
  workflowDefinitionId String                 @map("workflow_definition_id") @db.Uuid
  scheduleType         WorkflowScheduleType   @map("schedule_type")
  cronExpression       String?                @map("cron_expression") @db.VarChar(100)
  intervalSeconds      Int?                   @map("interval_seconds")
  timezone             String                 @default("UTC") @db.VarChar(100)
  status               WorkflowScheduleStatus @default(ACTIVE)
  nextRunAt            DateTime?              @map("next_run_at") @db.Timestamptz(6)
  lastRunAt            DateTime?              @map("last_run_at") @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, nextRunAt])
  @@index([workflowDefinitionId])
  @@map("workflow_schedules")
}

/// Structured execution log for debugging and observability.
model WorkflowExecutionLog {
  id          String   @id @default(uuid()) @db.Uuid
  executionId String   @map("execution_id") @db.Uuid
  level       String   @db.VarChar(20)
  event       String   @db.VarChar(100)
  message     String
  metadata    Json?
  timestamp   DateTime @default(now()) @db.Timestamptz(6)

  // Relationships
  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, timestamp])
  @@map("workflow_execution_logs")
}

/// Compensation intent recorded when a multi-step workflow fails.
model WorkflowCompensation {
  id          String             @id @default(uuid()) @db.Uuid
  executionId String             @map("execution_id") @db.Uuid
  stepId      String?            @map("step_id") @db.Uuid
  actionType  String             @map("action_type") @db.VarChar(100)
  status      WorkflowStepStatus @default(PENDING)
  payload     Json?
  executedAt  DateTime?          @map("executed_at") @db.Timestamptz(6)
  error       String?
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("workflow_compensations")
}

// ==============================================================================
// M41 — PUBLIC API PLATFORM, DEVELOPER PORTAL & SDK FOUNDATION
// Telemetry and usage records for external API access
// ==============================================================================

/// Bounded API usage record for external and public API requests.
/// INV-401: Belongs strictly to exactly one Organization.
/// INV-404: Never stores raw API key or secrets.
/// INV-405: Never persists Authorization header.
model ApiUsageRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  apiKeyId       String?  @map("api_key_id") @db.Uuid
  requestId      String   @map("request_id") @db.VarChar(128)
  method         String   @db.VarChar(10)
  route          String   @db.VarChar(500)
  statusCode     Int      @map("status_code")
  durationMs     Int      @map("duration_ms")
  responseClass  String   @map("response_class") @db.VarChar(10)
  userAgent      String?  @map("user_agent") @db.VarChar(500)
  clientIpHash   String?  @map("client_ip_hash") @db.VarChar(64)
  apiVersion     String   @default("v1") @map("api_version") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKey       ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, apiKeyId, createdAt])
  @@index([organizationId, route, createdAt])
  @@index([organizationId, statusCode, createdAt])
  @@index([requestId])
  @@map("api_usage_records")
}

// ==============================================================================
// M42 — SAAS BILLING, SUBSCRIPTIONS, ENTITLEMENTS & USAGE METERING
// Enums for commercial SaaS plans, subscriptions, quotas, invoices, and payments
// ==============================================================================

enum BillingPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTHLY
  YEARLY
  CUSTOM
}

enum BillingPricingModel {
  FLAT
  PER_UNIT
  TIERED
  VOLUME
  USAGE_BASED
  HYBRID
  CUSTOM
}

enum BillingSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

enum BillingQuotaType {
  HARD_LIMIT
  SOFT_LIMIT
  UNLIMITED
}

enum BillingInvoiceStatus {
  DRAFT
  OPEN
  PAID
  PARTIALLY_PAID
  VOID
  UNCOLLECTIBLE
}

enum BillingPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum BillingCreditType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum BillingDiscountDuration {
  ONCE
  RECURRING
  FOREVER
}

enum BillingWebhookStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  FAILED
  IGNORED
}

// ==============================================================================
// M42 — SAAS BILLING MODELS
// INV-426: BillingPlan key is globally unique
// INV-427: BillingPlanVersion belongs to exactly one BillingPlan
// INV-428: Published BillingPlanVersion is immutable
// INV-429: BillingPrice belongs to exactly one valid plan version
// INV-430: Money amounts use valid non-negative minor-unit representation
// ==============================================================================

model BillingPlan {
  id          String            @id @default(uuid()) @db.Uuid
  key         String            @unique @db.VarChar(100)
  name        String            @db.VarChar(200)
  description String?
  status      BillingPlanStatus @default(DRAFT)
  isPublic    Boolean           @default(true) @map("is_public")
  sortOrder   Int               @default(0) @map("sort_order")
  metadata    Json?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  versions BillingPlanVersion[]

  @@map("billing_plans")
}

model BillingPlanVersion {
  id             String    @id @default(uuid()) @db.Uuid
  planId         String    @map("plan_id") @db.Uuid
  version        Int       @default(1)
  name           String    @db.VarChar(200)
  isPublished    Boolean   @default(false) @map("is_published")
  checksum       String?   @db.VarChar(64)
  effectiveFrom  DateTime? @map("effective_from") @db.Timestamptz(6)
  effectiveUntil DateTime? @map("effective_until") @db.Timestamptz(6)
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  plan          BillingPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  prices        BillingPrice[]
  features      BillingPlanFeature[]
  subscriptions BillingSubscription[]

  @@unique([planId, version])
  @@map("billing_plan_versions")
}

model BillingPrice {
  id            String              @id @default(uuid()) @db.Uuid
  planVersionId String              @map("plan_version_id") @db.Uuid
  currency      String              @default("USD") @db.VarChar(10)
  interval      BillingInterval     @default(MONTHLY)
  pricingModel  BillingPricingModel @default(FLAT) @map("pricing_model")
  unitAmount    Int                 @default(0) @map("unit_amount")
  tiers         Json?
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  planVersion   BillingPlanVersion    @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  subscriptions BillingSubscription[]

  @@index([planVersionId])
  @@map("billing_prices")
}

model BillingFeature {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  name        String   @db.VarChar(200)
  description String?
  valueType   String   @default("BOOLEAN") @map("value_type") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  planFeatures BillingPlanFeature[]

  @@map("billing_features")
}

model BillingPlanFeature {
  id            String  @id @default(uuid()) @db.Uuid
  planVersionId String  @map("plan_version_id") @db.Uuid
  featureId     String  @map("feature_id") @db.Uuid
  enabled       Boolean @default(true)
  numericLimit  Int?    @map("numeric_limit")
  isUnlimited   Boolean @default(false) @map("is_unlimited")

  // Relationships
  planVersion BillingPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  feature     BillingFeature     @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, featureId])
  @@map("billing_plan_features")
}

model BillingSubscription {
  id                     String                    @id @default(uuid()) @db.Uuid
  organizationId         String                    @map("organization_id") @db.Uuid
  planVersionId          String                    @map("plan_version_id") @db.Uuid
  priceId                String?                   @map("price_id") @db.Uuid
  status                 BillingSubscriptionStatus @default(TRIALING)
  scope                  String                    @default("PLATFORM") @db.VarChar(50)
  currentPeriodStart     DateTime                  @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime                  @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean                   @default(false) @map("cancel_at_period_end")
  cancelledAt            DateTime?                 @map("cancelled_at") @db.Timestamptz(6)
  endedAt                DateTime?                 @map("ended_at") @db.Timestamptz(6)
  trialStart             DateTime?                 @map("trial_start") @db.Timestamptz(6)
  trialEnd               DateTime?                 @map("trial_end") @db.Timestamptz(6)
  pausedAt               DateTime?                 @map("paused_at") @db.Timestamptz(6)
  providerSubscriptionId String?                   @map("provider_subscription_id") @db.VarChar(200)
  metadata               Json?
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planVersion  BillingPlanVersion        @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  price        BillingPrice?             @relation(fields: [priceId], references: [id], onDelete: SetNull)
  items        BillingSubscriptionItem[]
  periods      BillingPeriod[]
  invoices     BillingInvoice[]

  @@index([organizationId, status])
  @@index([status, currentPeriodEnd])
  @@map("billing_subscriptions")
}

model BillingSubscriptionItem {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  itemKey        String   @map("item_key") @db.VarChar(100)
  quantity       Int      @default(1)
  unitAmount     Int      @default(0) @map("unit_amount")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  subscription BillingSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("billing_subscription_items")
}

model BillingPeriod {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  periodStart    DateTime  @map("period_start") @db.Timestamptz(6)
  periodEnd      DateTime  @map("period_end") @db.Timestamptz(6)
  isClosed       Boolean   @default(false) @map("is_closed")
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription BillingSubscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoices     BillingInvoice[]
  aggregates   BillingUsageAggregate[]

  @@index([subscriptionId, periodStart, periodEnd])
  @@map("billing_periods")
}

model BillingUsageMetric {
  id              String   @id @default(uuid()) @db.Uuid
  metricKey       String   @unique @map("metric_key") @db.VarChar(100)
  name            String   @db.VarChar(200)
  description     String?
  unit            String   @default("count") @db.VarChar(50)
  aggregationType String   @default("SUM") @map("aggregation_type") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  records    BillingUsageRecord[]
  aggregates BillingUsageAggregate[]
  quotas     BillingQuota[]

  @@map("billing_usage_metrics")
}

model BillingUsageRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  metricKey      String   @map("metric_key") @db.VarChar(100)
  quantity       Int      @default(1)
  source         String   @default("api") @db.VarChar(100)
  sourceId       String?  @map("source_id") @db.VarChar(200)
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(200)
  timestamp      DateTime @default(now()) @db.Timestamptz(6)
  metadata       Json?

  // Relationships
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metric       BillingUsageMetric @relation(fields: [metricKey], references: [metricKey], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, metricKey, timestamp])
  @@map("billing_usage_records")
}

model BillingUsageAggregate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  periodId       String?  @map("period_id") @db.Uuid
  metricKey      String   @map("metric_key") @db.VarChar(100)
  totalQuantity  Int      @default(0) @map("total_quantity")
  date           DateTime @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  period       BillingPeriod?     @relation(fields: [periodId], references: [id], onDelete: SetNull)
  metric       BillingUsageMetric @relation(fields: [metricKey], references: [metricKey], onDelete: Restrict)

  @@unique([organizationId, metricKey, date])
  @@index([organizationId, date])
  @@map("billing_usage_aggregates")
}

model BillingQuota {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  metricKey          String           @map("metric_key") @db.VarChar(100)
  quotaType          BillingQuotaType @default(HARD_LIMIT) @map("quota_type")
  allocatedAmount    Int              @default(0) @map("allocated_amount")
  authorizedOverride Int?             @map("authorized_override")
  overrideReason     String?          @map("override_reason")
  currentUsage       Int              @default(0) @map("current_usage")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metric       BillingUsageMetric @relation(fields: [metricKey], references: [metricKey], onDelete: Restrict)

  @@unique([organizationId, metricKey])
  @@map("billing_quotas")
}

model BillingInvoice {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  subscriptionId String?              @map("subscription_id") @db.Uuid
  periodId       String?              @map("period_id") @db.Uuid
  invoiceNumber  String               @unique @map("invoice_number") @db.VarChar(100)
  status         BillingInvoiceStatus @default(DRAFT)
  currency       String               @default("USD") @db.VarChar(10)
  subtotal       Int                  @default(0)
  discountAmount Int                  @default(0) @map("discount_amount")
  taxAmount      Int                  @default(0) @map("tax_amount")
  creditApplied  Int                  @default(0) @map("credit_applied")
  totalAmount    Int                  @default(0) @map("total_amount")
  amountPaid     Int                  @default(0) @map("amount_paid")
  amountDue      Int                  @default(0) @map("amount_due")
  issueDate      DateTime             @default(now()) @map("issue_date") @db.Timestamptz(6)
  dueDate        DateTime             @map("due_date") @db.Timestamptz(6)
  finalizedAt    DateTime?            @map("finalized_at") @db.Timestamptz(6)
  paidAt         DateTime?            @map("paid_at") @db.Timestamptz(6)
  voidedAt       DateTime?            @map("voided_at") @db.Timestamptz(6)
  metadata       Json?
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription BillingSubscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  period       BillingPeriod?           @relation(fields: [periodId], references: [id], onDelete: SetNull)
  lineItems    BillingInvoiceLineItem[]
  payments     BillingPayment[]

  @@index([organizationId, status])
  @@index([organizationId, issueDate])
  @@map("billing_invoices")
}

model BillingInvoiceLineItem {
  id          String @id @default(uuid()) @db.Uuid
  invoiceId   String @map("invoice_id") @db.Uuid
  description String @db.VarChar(255)
  itemType    String @default("BASE_SUBSCRIPTION") @map("item_type") @db.VarChar(50)
  quantity    Int    @default(1)
  unitAmount  Int    @default(0) @map("unit_amount")
  totalAmount Int    @default(0) @map("total_amount")
  metadata    Json?

  // Relationships
  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("billing_invoice_line_items")
}

model BillingCredit {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  amount         Int       @default(0)
  currency       String    @default("USD") @db.VarChar(10)
  reason         String?   @db.VarChar(255)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  consumedAmount Int       @default(0) @map("consumed_amount")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("billing_credits")
}

model BillingDiscount {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String?                 @map("organization_id") @db.Uuid
  code           String                  @unique @db.VarChar(100)
  name           String                  @db.VarChar(200)
  discountType   BillingCreditType       @default(PERCENTAGE) @map("discount_type")
  value          Int                     @default(0)
  duration       BillingDiscountDuration @default(ONCE)
  validUntil     DateTime?               @map("valid_until") @db.Timestamptz(6)
  maxRedemptions Int?                    @map("max_redemptions")
  timesRedeemed  Int                     @default(0) @map("times_redeemed")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("billing_discounts")
}

model BillingPayment {
  id                    String               @id @default(uuid()) @db.Uuid
  organizationId        String               @map("organization_id") @db.Uuid
  invoiceId             String               @map("invoice_id") @db.Uuid
  amount                Int                  @default(0)
  currency              String               @default("USD") @db.VarChar(10)
  status                BillingPaymentStatus @default(PENDING)
  providerKey           String               @default("sandbox") @map("provider_key") @db.VarChar(100)
  providerTransactionId String?              @map("provider_transaction_id") @db.VarChar(200)
  failureReason         String?              @map("failure_reason")
  attemptNumber         Int                  @default(1) @map("attempt_number")
  paidAt                DateTime?            @map("paid_at") @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId, invoiceId])
  @@index([providerTransactionId])
  @@map("billing_payments")
}

model BillingWebhookEvent {
  id              String               @id @default(uuid()) @db.Uuid
  providerKey     String               @map("provider_key") @db.VarChar(100)
  providerEventId String               @map("provider_event_id") @db.VarChar(200)
  eventType       String               @map("event_type") @db.VarChar(100)
  status          BillingWebhookStatus @default(RECEIVED)
  payload         Json
  signature       String?              @db.VarChar(255)
  error           String?
  processedAt     DateTime?            @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([providerKey, providerEventId])
  @@map("billing_webhook_events")
}

// ==============================================================================
// M43 — NOTIFICATIONS, COMMUNICATIONS & OMNICHANNEL MESSAGING
// Enums for multi-channel communication, priority, delivery, and template lifecycle
// ==============================================================================

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum NotificationDeliveryStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  REJECTED
  CANCELLED
}

enum NotificationTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationScheduleStatus {
  PENDING
  EXECUTED
  CANCELLED
  FAILED
}

enum PushPlatform {
  ANDROID
  IOS
  WEB
}

enum CommunicationProviderType {
  IN_APP
  EMAIL
  PUSH
  SMS
}

// ==============================================================================
// M43 — NOTIFICATION MODELS
// INV-451: Notification template key is unique within its tenant scope.
// INV-452: Published notification template versions are immutable.
// INV-453: Notification template version belongs to exactly one template.
// INV-454: Notification event is strictly tenant scoped.
// INV-455: Notification recipient cannot access another tenant's notification.
// INV-456: Notification delivery belongs to exactly one notification and tenant.
// INV-457: Delivery attempt numbers are unique and sequential per delivery.
// INV-458: Terminal delivery statuses cannot transition illegally.
// ==============================================================================

model NotificationTemplate {
  id              String                     @id @default(uuid()) @db.Uuid
  organizationId  String?                    @map("organization_id") @db.Uuid
  key             String                     @db.VarChar(100)
  channel         NotificationChannel        @default(IN_APP)
  name            String                     @db.VarChar(200)
  description     String?
  status          NotificationTemplateStatus @default(DRAFT)
  activeVersionId String?                    @map("active_version_id") @db.Uuid
  metadata        Json?
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization  Organization?                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions      NotificationTemplateVersion[]
  notifications Notification[]

  @@unique([organizationId, key])
  @@index([organizationId, channel, status])
  @@map("notification_templates")
}

model NotificationTemplateVersion {
  id           String    @id @default(uuid()) @db.Uuid
  templateId   String    @map("template_id") @db.Uuid
  version      Int       @default(1)
  locale       String    @default("en") @db.VarChar(20)
  subject      String?   @db.VarChar(255)
  body         String    @db.Text
  variables    String[]  @default([])
  snapshotHash String    @map("snapshot_hash") @db.VarChar(64)
  isPublished  Boolean   @default(false) @map("is_published")
