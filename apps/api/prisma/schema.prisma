  defaultServiceRevenueAccount      Account?     @relation("ConfigServiceRevenueAccount", fields: [defaultServiceRevenueAccountId], references: [id], onDelete: SetNull)
  defaultWarrantyExpenseAccount     Account?     @relation("ConfigWarrantyExpenseAccount", fields: [defaultWarrantyExpenseAccountId], references: [id], onDelete: SetNull)
  defaultServicePartsExpenseAccount Account?     @relation("ConfigServicePartsExpenseAccount", fields: [defaultServicePartsExpenseAccountId], references: [id], onDelete: SetNull)

