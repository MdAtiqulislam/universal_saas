  PUBLIC
}

/// INV-508: Report share targets must be scoped to same tenant user/role/team.
enum ReportShareType {
  USER
  ROLE
  TEAM
}

/// INV-510: Report schedule frequency options.
enum ReportScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

/// INV-509: Report execution lifecycle status.
enum ReportExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

