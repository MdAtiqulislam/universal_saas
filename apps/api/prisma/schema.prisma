  estimate           ServiceEstimate?      @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  customerInvoice    CustomerInvoice?      @relation(fields: [customerInvoiceId], references: [id], onDelete: SetNull)
  sourceRma          ReturnRequest?        @relation(fields: [sourceRmaId], references: [id], onDelete: SetNull)
  inspectionLot      QualityInspectionLot? @relation(fields: [inspectionLotId], references: [id], onDelete: SetNull)

  assignments       ServiceAssignment[]
  partsRequirements ServicePartRequirement[]
  laborEntries      ServiceLaborEntry[]
  handovers         ServiceHandover[]

  @@unique([organizationId, serviceOrderNumber])
  @@index([organizationId, customerId])
