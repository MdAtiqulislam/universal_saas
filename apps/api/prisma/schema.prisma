  discountAmount      Decimal  @default(0) @map("discount_amount") @db.Decimal(20, 4)
  taxRate             Decimal  @default(0) @map("tax_rate") @db.Decimal(12, 4)
  taxAmount           Decimal  @default(0) @map("tax_amount") @db.Decimal(20, 4)
  lineTotal           Decimal  @map("line_total") @db.Decimal(20, 4)
  purchaseOrderLineId String?  @map("purchase_order_line_id") @db.Uuid
  goodsReceiptLineId  String?  @map("goods_receipt_line_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

