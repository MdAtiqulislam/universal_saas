  totalCost            Decimal            @default(0) @map("total_cost") @db.Decimal(20, 4)
  customerCharge       Decimal            @default(0) @map("customer_charge") @db.Decimal(20, 4)
  warrantyCost         Decimal            @default(0) @map("warranty_cost") @db.Decimal(20, 4)
  customerInvoiceId    String?            @map("customer_invoice_id") @db.Uuid
  sourceRmaId          String?            @map("source_rma_id") @db.Uuid
  inspectionLotId      String?            @map("inspection_lot_id") @db.Uuid
  isImmutable          Boolean            @default(false) @map("is_immutable")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

