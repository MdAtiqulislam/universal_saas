/// Tenant inventory cost layers for FIFO / specific lot costing tracking.
model InventoryCostLayer {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  itemId            String   @map("item_id") @db.Uuid
  variantId         String?  @map("variant_id") @db.Uuid
  locationId        String   @map("location_id") @db.Uuid
  batchId           String?  @map("batch_id") @db.Uuid
  receiptQuantity   Decimal  @map("receipt_quantity") @db.Decimal(18, 4)
  unitCost          Decimal  @map("unit_cost") @db.Decimal(18, 4)
  remainingQuantity Decimal  @map("remaining_quantity") @db.Decimal(18, 4)
  consumedQuantity  Decimal  @default(0) @map("consumed_quantity") @db.Decimal(18, 4)
  sourceDocument    String   @map("source_document") @db.VarChar(50)
  sourceDocumentId  String?  @map("source_document_id") @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
