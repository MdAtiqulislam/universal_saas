  SUPPLIER_RETURN
  INTERNAL_RETURN
  WARRANTY_RETURN
  REPLACEMENT_RETURN
}

enum ReturnStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  AUTHORIZED
  AWAITING_RETURN
  IN_TRANSIT
  RECEIVED
  INSPECTION_REQUIRED
  INSPECTING
  DISPOSITION_PENDING
  RESOLVED
  CLOSED
  REJECTED
  CANCELLED
  VOIDED
}

enum ReturnLineStatus {
  PENDING
  AUTHORIZED
  REJECTED
  IN_TRANSIT
  RECEIVED
  INSPECTED
  DISPOSITIONED
  RESOLVED
  CANCELLED
}

enum ReturnDispositionType {
