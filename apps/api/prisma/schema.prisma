  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("expense_categories")
}

/// Tenant employee / claimant profile for expense submissions.
model ExpenseClaimant {
  id                      String    @id @default(uuid()) @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  userId                  String?   @map("user_id") @db.Uuid
  employeeNumber          String?   @map("employee_number") @db.VarChar(50)
  name                    String    @db.VarChar(100)
  email                   String?   @db.VarChar(255)
  department              String?   @db.VarChar(100)
  defaultPaymentAccountId String?   @map("default_payment_account_id") @db.Uuid
  isActive                Boolean   @default(true) @map("is_active")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  defaultPaymentAccount PaymentAccount? @relation(fields: [defaultPaymentAccountId], references: [id], onDelete: SetNull)
  expenseClaims         ExpenseClaim[]
  payments              Payment[]

  @@unique([organizationId, employeeNumber])
  @@index([organizationId, userId])
  @@index([organizationId, isActive])
  @@map("expense_claimants")
}

/// Tenant expense claim aggregate representing an employee expense report.
model ExpenseClaim {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  claimNumber      String             @map("claim_number") @db.VarChar(50)
  claimantId       String             @map("claimant_id") @db.Uuid
  claimDate        DateTime           @map("claim_date") @db.Date
  description      String
  currencyId       String             @map("currency_id") @db.Uuid
  status           ExpenseClaimStatus @default(DRAFT)
  subtotal         Decimal            @default(0) @db.Decimal(20, 4)
  taxAmount        Decimal            @default(0) @map("tax_amount") @db.Decimal(20, 4)
  totalAmount      Decimal            @default(0) @map("total_amount") @db.Decimal(20, 4)
  approvedAmount   Decimal            @default(0) @map("approved_amount") @db.Decimal(20, 4)
  paidAmount       Decimal            @default(0) @map("paid_amount") @db.Decimal(20, 4)
  dueAmount        Decimal            @default(0) @map("due_amount") @db.Decimal(20, 4)
  submittedAt      DateTime?          @map("submitted_at") @db.Timestamptz(6)
  approvedAt       DateTime?          @map("approved_at") @db.Timestamptz(6)
  approvedByUserId String?            @map("approved_by_user_id") @db.Uuid
  rejectionReason  String?            @map("rejection_reason")
  postedAt         DateTime?          @map("posted_at") @db.Timestamptz(6)
  postedByUserId   String?            @map("posted_by_user_id") @db.Uuid
  paidAt           DateTime?          @map("paid_at") @db.Timestamptz(6)
  journalEntryId   String?            @map("journal_entry_id") @db.Uuid
  createdByUserId  String             @map("created_by_user_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claimant     ExpenseClaimant     @relation(fields: [claimantId], references: [id], onDelete: Restrict)
  currency     Currency            @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  lines        ExpenseClaimLine[]
  receipts     ExpenseReceipt[]
  allocations  PaymentAllocation[]

  @@unique([organizationId, claimNumber])
  @@index([organizationId, status])
  @@index([organizationId, claimantId])
  @@index([organizationId, claimDate])
  @@map("expense_claims")
}

/// Tenant line items belonging to an expense claim.
model ExpenseClaimLine {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  expenseClaimId   String   @map("expense_claim_id") @db.Uuid
  categoryId       String   @map("category_id") @db.Uuid
  description      String
  expenseDate      DateTime @map("expense_date") @db.Date
  quantity         Decimal  @default(1) @db.Decimal(20, 4)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(20, 4)
  subtotal         Decimal  @db.Decimal(20, 4)
  taxCodeId        String?  @map("tax_code_id") @db.Uuid
  taxRate          Decimal  @default(0) @map("tax_rate") @db.Decimal(12, 4)
  taxAmount        Decimal  @default(0) @map("tax_amount") @db.Decimal(20, 4)
  totalAmount      Decimal  @map("total_amount") @db.Decimal(20, 4)
  glAccountId      String?  @map("gl_account_id") @db.Uuid
  receiptReference String?  @map("receipt_reference") @db.VarChar(255)
  receiptFilename  String?  @map("receipt_filename") @db.VarChar(255)
  receiptMimeType  String?  @map("receipt_mime_type") @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenseClaim ExpenseClaim     @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)
  category     ExpenseCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  taxCode      TaxCode?         @relation(fields: [taxCodeId], references: [id], onDelete: SetNull)
  glAccount    Account?         @relation(fields: [glAccountId], references: [id], onDelete: SetNull)
  receipts     ExpenseReceipt[]

  @@index([organizationId, expenseClaimId])
  @@index([organizationId, categoryId])
  @@map("expense_claim_lines")
}

/// Tenant receipt attachment metadata associated with claims and claim lines.
model ExpenseReceipt {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  expenseClaimId     String   @map("expense_claim_id") @db.Uuid
  expenseClaimLineId String?  @map("expense_claim_line_id") @db.Uuid
  filename           String   @db.VarChar(255)
  mimeType           String   @map("mime_type") @db.VarChar(100)
  storageKey         String   @map("storage_key") @db.VarChar(500)
  fileSize           Int?     @map("file_size")
  uploadedByUserId   String   @map("uploaded_by_user_id") @db.Uuid
  uploadedAt         DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  // Relationships
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenseClaim ExpenseClaim      @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)
  claimLine    ExpenseClaimLine? @relation(fields: [expenseClaimLineId], references: [id], onDelete: SetNull)
  uploadedBy   User              @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, expenseClaimId])
  @@index([organizationId, expenseClaimLineId])
  @@map("expense_receipts")
}

// ------------------------------------------------------------------------------
// FIXED ASSETS & DEPRECIATION (M22)
// ------------------------------------------------------------------------------

/// Tenant asset categories defining default GL accounts, depreciation methods, and useful life.
model AssetCategory {
  id                               String                  @id @default(uuid()) @db.Uuid
  organizationId                   String                  @map("organization_id") @db.Uuid
  code                             String                  @db.VarChar(50)
  name                             String                  @db.VarChar(200)
  description                      String?
  assetAccountId                   String?                 @map("asset_account_id") @db.Uuid
  accumulatedDepreciationAccountId String?                 @map("accumulated_depreciation_account_id") @db.Uuid
  depreciationExpenseAccountId     String?                 @map("depreciation_expense_account_id") @db.Uuid
  depreciationMethod               AssetDepreciationMethod @default(STRAIGHT_LINE) @map("depreciation_method")
  defaultUsefulLifeMonths          Int                     @default(60) @map("default_useful_life_months")
  defaultResidualValuePercent      Decimal                 @default(0) @map("default_residual_value_percent") @db.Decimal(5, 2)
  isActive                         Boolean                 @default(true) @map("is_active")
  createdAt                        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                        DateTime?               @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  organization                   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetAccount                   Account?     @relation("AssetCategoryAssetAccount", fields: [assetAccountId], references: [id], onDelete: SetNull)
  accumulatedDepreciationAccount Account?     @relation("AssetCategoryAccumulatedDepAccount", fields: [accumulatedDepreciationAccountId], references: [id], onDelete: SetNull)
  depreciationExpenseAccount     Account?     @relation("AssetCategoryDepExpenseAccount", fields: [depreciationExpenseAccountId], references: [id], onDelete: SetNull)
  fixedAssets                    FixedAsset[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("asset_categories")
}

/// Tenant fixed asset master record tracking lifecycle, acquisition, depreciation, and disposal.
model FixedAsset {
  id                               String                  @id @default(uuid()) @db.Uuid
  organizationId                   String                  @map("organization_id") @db.Uuid
  assetNumber                      String                  @map("asset_number") @db.VarChar(50)
  name                             String                  @db.VarChar(200)
  description                      String?
  categoryId                       String                  @map("category_id") @db.Uuid
  serialNumber                     String?                 @map("serial_number") @db.VarChar(100)
  locationId                       String?                 @map("location_id") @db.Uuid
  supplierId                       String?                 @map("supplier_id") @db.Uuid
  purchaseOrderId                  String?                 @map("purchase_order_id") @db.Uuid
  goodsReceiptId                   String?                 @map("goods_receipt_id") @db.Uuid
  supplierInvoiceId                String?                 @map("supplier_invoice_id") @db.Uuid
  currencyId                       String                  @map("currency_id") @db.Uuid
  acquisitionDate                  DateTime                @map("acquisition_date") @db.Date
  placedInServiceDate              DateTime?               @map("placed_in_service_date") @db.Date
  acquisitionCost                  Decimal                 @map("acquisition_cost") @db.Decimal(20, 4)
  residualValue                    Decimal                 @default(0) @map("residual_value") @db.Decimal(20, 4)
  accumulatedDepreciation          Decimal                 @default(0) @map("accumulated_depreciation") @db.Decimal(20, 4)
  netBookValue                     Decimal                 @map("net_book_value") @db.Decimal(20, 4)
  usefulLifeMonths                 Int                     @map("useful_life_months")
  depreciationMethod               AssetDepreciationMethod @default(STRAIGHT_LINE) @map("depreciation_method")
  status                           FixedAssetStatus        @default(DRAFT)
  assetAccountId                   String?                 @map("asset_account_id") @db.Uuid
  accumulatedDepreciationAccountId String?                 @map("accumulated_depreciation_account_id") @db.Uuid
  depreciationExpenseAccountId     String?                 @map("depreciation_expense_account_id") @db.Uuid
  capitalizedAt                    DateTime?               @map("capitalized_at") @db.Timestamptz(6)
  capitalizedByUserId              String?                 @map("capitalized_by_user_id") @db.Uuid
  capitalizationJournalEntryId     String?                 @map("capitalization_journal_entry_id") @db.Uuid
  disposedAt                       DateTime?               @map("disposed_at") @db.Timestamptz(6)
  disposedByUserId                 String?                 @map("disposed_by_user_id") @db.Uuid
  disposalProceeds                 Decimal?                @map("disposal_proceeds") @db.Decimal(20, 4)
  disposalGainLoss                 Decimal?                @map("disposal_gain_loss") @db.Decimal(20, 4)
  disposalJournalEntryId           String?                 @map("disposal_journal_entry_id") @db.Uuid
  disposalReason                   String?                 @map("disposal_reason")
  createdByUserId                  String                  @map("created_by_user_id") @db.Uuid
  createdAt                        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                        DateTime?               @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  organization                   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category                       AssetCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location                       Location?                @relation(fields: [locationId], references: [id], onDelete: SetNull)
  supplier                       Supplier?                @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder                  PurchaseOrder?           @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceipt                   GoodsReceipt?            @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  supplierInvoice                SupplierInvoice?         @relation(fields: [supplierInvoiceId], references: [id], onDelete: SetNull)
  currency                       Currency                 @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  assetAccount                   Account?                 @relation("FixedAssetAssetAccount", fields: [assetAccountId], references: [id], onDelete: SetNull)
  accumulatedDepreciationAccount Account?                 @relation("FixedAssetAccumulatedDepAccount", fields: [accumulatedDepreciationAccountId], references: [id], onDelete: SetNull)
  depreciationExpenseAccount     Account?                 @relation("FixedAssetDepExpenseAccount", fields: [depreciationExpenseAccountId], references: [id], onDelete: SetNull)
  capitalizationJournalEntry     JournalEntry?            @relation("FixedAssetCapitalizationJournal", fields: [capitalizationJournalEntryId], references: [id], onDelete: SetNull)
  disposalJournalEntry           JournalEntry?            @relation("FixedAssetDisposalJournal", fields: [disposalJournalEntryId], references: [id], onDelete: SetNull)
  depreciationEntries            AssetDepreciationEntry[]
  transfers                      AssetTransferHistory[]

  @@unique([organizationId, assetNumber])
  @@index([organizationId, status])
  @@index([organizationId, categoryId])
  @@index([organizationId, locationId])
  @@index([organizationId, acquisitionDate])
  @@map("fixed_assets")
}

/// Tenant periodic depreciation schedules and postings.
model AssetDepreciationEntry {
  id                      String                       @id @default(uuid()) @db.Uuid
  organizationId          String                       @map("organization_id") @db.Uuid
  assetId                 String                       @map("asset_id") @db.Uuid
  fiscalPeriodId          String                       @map("fiscal_period_id") @db.Uuid
  periodStart             DateTime                     @map("period_start") @db.Date
  periodEnd               DateTime                     @map("period_end") @db.Date
  openingBookValue        Decimal                      @map("opening_book_value") @db.Decimal(20, 4)
  depreciationAmount      Decimal                      @map("depreciation_amount") @db.Decimal(20, 4)
  accumulatedDepreciation Decimal                      @map("accumulated_depreciation") @db.Decimal(20, 4)
  closingBookValue        Decimal                      @map("closing_book_value") @db.Decimal(20, 4)
  status                  AssetDepreciationEntryStatus @default(SCHEDULED)
  journalEntryId          String?                      @map("journal_entry_id") @db.Uuid
  postedAt                DateTime?                    @map("posted_at") @db.Timestamptz(6)
  postedByUserId          String?                      @map("posted_by_user_id") @db.Uuid
  createdAt               DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        FixedAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fiscalPeriod FiscalPeriod  @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@unique([organizationId, assetId, fiscalPeriodId])
  @@index([organizationId, status])
  @@index([organizationId, fiscalPeriodId])
  @@map("asset_depreciation_entries")
}

/// Tenant fixed asset location transfer history and movement audit trail.
model AssetTransferHistory {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  assetId             String   @map("asset_id") @db.Uuid
  fromLocationId      String?  @map("from_location_id") @db.Uuid
  toLocationId        String   @map("to_location_id") @db.Uuid
  transferDate        DateTime @map("transfer_date") @db.Date
  reason              String?
  transferredByUserId String   @map("transferred_by_user_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        FixedAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromLocation Location?    @relation("AssetTransferFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   Location     @relation("AssetTransferToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)

  @@index([organizationId, assetId])
  @@index([organizationId, transferDate])
  @@map("asset_transfer_histories")
}

// ------------------------------------------------------------------------------
// BUDGETING, FINANCIAL PLANNING & BUDGET CONTROL MODELS (M23)
// ------------------------------------------------------------------------------

/// Tenant budget aggregate header tracking fiscal planning, approval lifecycle, and control thresholds.
model Budget {
  id                   String              @id @default(uuid()) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  budgetNumber         String              @map("budget_number") @db.VarChar(50)
  name                 String              @db.VarChar(200)
  description          String?
  fiscalYear           Int                 @map("fiscal_year")
  startDate            DateTime            @map("start_date") @db.Date
  endDate              DateTime            @map("end_date") @db.Date
  currencyId           String              @map("currency_id") @db.Uuid
  status               BudgetStatus        @default(DRAFT)
  periodType           BudgetPeriodType    @default(MONTHLY) @map("period_type")
  version              Int                 @default(1)
  controlPolicy        BudgetControlPolicy @default(WARN) @map("control_policy")
  warnThresholdPercent Decimal             @default(90.00) @map("warn_threshold_percent") @db.Decimal(5, 2)
  totalBudget          Decimal             @default(0) @map("total_budget") @db.Decimal(20, 4)
  notes                String?
  createdByUserId      String              @map("created_by_user_id") @db.Uuid
  approvedByUserId     String?             @map("approved_by_user_id") @db.Uuid
  approvedAt           DateTime?           @map("approved_at") @db.Timestamptz(6)
  rejectionReason      String?             @map("rejection_reason")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?           @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currency     Currency     @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  lines        BudgetLine[]

  @@unique([organizationId, budgetNumber])
  @@index([organizationId, status])
  @@index([organizationId, fiscalYear])
  @@index([organizationId, startDate, endDate])
  @@map("budgets")
}

/// Tenant budget periodized allocation lines referencing GL accounts.
model BudgetLine {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  budgetId       String         @map("budget_id") @db.Uuid
  accountId      String         @map("account_id") @db.Uuid
  category       BudgetCategory @default(OTHER)
  fiscalPeriodId String?        @map("fiscal_period_id") @db.Uuid
  period         String         @db.VarChar(50)
  startDate      DateTime       @map("start_date") @db.Date
  endDate        DateTime       @map("end_date") @db.Date
  amount         Decimal        @db.Decimal(20, 4)
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budget       Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  fiscalPeriod FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id], onDelete: SetNull)

  @@unique([organizationId, budgetId, accountId, period])
  @@index([organizationId, budgetId])
  @@index([organizationId, accountId])
  @@index([organizationId, fiscalPeriodId])
  @@index([organizationId, category])
  @@index([organizationId, startDate, endDate])
  @@map("budget_lines")
}

// ------------------------------------------------------------------------------
// PAYROLL, EMPLOYEE & HR MANAGEMENT MODELS (M24)
// ------------------------------------------------------------------------------

/// Tenant organizational department hierarchy.
model Department {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  code               String   @db.VarChar(50)
  name               String   @db.VarChar(200)
  description        String?
  parentDepartmentId String?  @map("parent_department_id") @db.Uuid
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentDepartment     Department?           @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments     Department[]          @relation("DepartmentHierarchy")
  jobPositions         JobPosition[]
  employees            Employee[]
  purchaseRequisitions PurchaseRequisition[]

  @@unique([organizationId, code])
  @@index([organizationId, parentDepartmentId])
  @@index([organizationId, active])
  @@map("departments")
}

/// Tenant job positions and designations scoped by department.
model JobPosition {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(50)
  title          String   @db.VarChar(200)
  description    String?
  departmentId   String?  @map("department_id") @db.Uuid
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId, departmentId])
  @@index([organizationId, active])
  @@map("job_positions")
}

/// Tenant employee master record with employment classification and reporting hierarchy.
model Employee {
  id                      String           @id @default(uuid()) @db.Uuid
  organizationId          String           @map("organization_id") @db.Uuid
  employeeNumber          String           @map("employee_number") @db.VarChar(50)
  firstName               String           @map("first_name") @db.VarChar(100)
  lastName                String           @map("last_name") @db.VarChar(100)
  displayName             String           @map("display_name") @db.VarChar(200)
  email                   String?          @db.VarChar(255)
  phone                   String?          @db.VarChar(50)
  nationalIdReference     String?          @map("national_id_reference") @db.VarChar(100)
  hireDate                DateTime         @map("hire_date") @db.Date
  terminationDate         DateTime?        @map("termination_date") @db.Date
  employmentStatus        EmploymentStatus @default(ACTIVE) @map("employment_status")
  employmentType          EmploymentType   @default(FULL_TIME) @map("employment_type")
  departmentId            String?          @map("department_id") @db.Uuid
  jobPositionId           String?          @map("job_position_id") @db.Uuid
  designation             String?          @db.VarChar(200)
  managerEmployeeId       String?          @map("manager_employee_id") @db.Uuid
  defaultPaymentAccountId String?          @map("default_payment_account_id") @db.Uuid
  payrollCurrencyId       String?          @map("payroll_currency_id") @db.Uuid
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?        @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department            Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobPosition           JobPosition?           @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  manager               Employee?              @relation("EmployeeReportingHierarchy", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  directReports         Employee[]             @relation("EmployeeReportingHierarchy")
  defaultPaymentAccount PaymentAccount?        @relation("EmployeeDefaultPaymentAccount", fields: [defaultPaymentAccountId], references: [id], onDelete: SetNull)
  payrollCurrency       Currency?              @relation("EmployeePayrollCurrency", fields: [payrollCurrencyId], references: [id], onDelete: SetNull)
  compensations         EmployeeCompensation[]
  payrollEmployees      PayrollEmployee[]
  payrollInputs         PayrollInput[]
  ticketAssignments     ServiceTicket[]        @relation("TicketTechnician")
  orderAssignments      ServiceOrder[]         @relation("OrderTechnician")
  serviceAssignments    ServiceAssignment[]
  serviceDiagnoses      ServiceDiagnosis[]
  serviceLaborEntries   ServiceLaborEntry[]
  assignedLeads         Lead[]                 @relation("LeadAssignedEmployee")
  ownedOpportunities    Opportunity[]          @relation("OpportunityOwnerEmployee")
  assignedCrmActivities CrmActivity[]          @relation("ActivityAssignedEmployee")

  @@unique([organizationId, employeeNumber])
  @@index([organizationId, employmentStatus])
  @@index([organizationId, departmentId])
  @@index([organizationId, managerEmployeeId])
  @@index([organizationId, hireDate])
  @@map("employees")
}

/// Tenant effective-dated employee compensation history.
model EmployeeCompensation {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  employeeId         String    @map("employee_id") @db.Uuid
  effectiveFrom      DateTime  @map("effective_from") @db.Date
  effectiveUntil     DateTime? @map("effective_until") @db.Date
  baseSalary         Decimal   @default(0) @map("base_salary") @db.Decimal(20, 4)
  housingAllowance   Decimal   @default(0) @map("housing_allowance") @db.Decimal(20, 4)
  transportAllowance Decimal   @default(0) @map("transport_allowance") @db.Decimal(20, 4)
  medicalAllowance   Decimal   @default(0) @map("medical_allowance") @db.Decimal(20, 4)
  otherAllowance     Decimal   @default(0) @map("other_allowance") @db.Decimal(20, 4)
  overtimeRate       Decimal   @default(0) @map("overtime_rate") @db.Decimal(20, 4)
  paymentAccountId   String?   @map("payment_account_id") @db.Uuid
  currencyId         String?   @map("currency_id") @db.Uuid
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  paymentAccount PaymentAccount? @relation("EmployeeCompensationPaymentAccount", fields: [paymentAccountId], references: [id], onDelete: SetNull)
  currency       Currency?       @relation(fields: [currencyId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId])
  @@index([organizationId, effectiveFrom, effectiveUntil])
  @@map("employee_compensations")
}

/// Tenant-level payroll settings and General Ledger mapping configuration.
model PayrollConfiguration {
  id                         String              @id @default(uuid()) @db.Uuid
  organizationId             String              @unique @map("organization_id") @db.Uuid
  payrollFrequency           PayrollFrequency    @default(MONTHLY) @map("payroll_frequency")
  defaultCurrencyId          String              @map("default_currency_id") @db.Uuid
  workingDaysPerPeriod       Int                 @default(22) @map("working_days_per_period")
  standardWorkingHours       Decimal             @default(8.00) @map("standard_working_hours") @db.Decimal(5, 2)
  overtimeEnabled            Boolean             @default(true) @map("overtime_enabled")
  taxEnabled                 Boolean             @default(true) @map("tax_enabled")
  budgetControlPolicy        BudgetControlPolicy @default(WARN) @map("budget_control_policy")
  payrollExpenseAccountId    String?             @map("payroll_expense_account_id") @db.Uuid
  payrollPayableAccountId    String?             @map("payroll_payable_account_id") @db.Uuid
  payrollTaxPayableAccountId String?             @map("payroll_tax_payable_account_id") @db.Uuid
  overtimeExpenseAccountId   String?             @map("overtime_expense_account_id") @db.Uuid
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultCurrency          Currency     @relation(fields: [defaultCurrencyId], references: [id], onDelete: Restrict)
  payrollExpenseAccount    Account?     @relation("PayrollExpenseAccount", fields: [payrollExpenseAccountId], references: [id], onDelete: SetNull)
  payrollPayableAccount    Account?     @relation("PayrollPayableAccount", fields: [payrollPayableAccountId], references: [id], onDelete: SetNull)
  payrollTaxPayableAccount Account?     @relation("PayrollTaxPayableAccount", fields: [payrollTaxPayableAccountId], references: [id], onDelete: SetNull)
  overtimeExpenseAccount   Account?     @relation("OvertimeExpenseAccount", fields: [overtimeExpenseAccountId], references: [id], onDelete: SetNull)

  @@map("payroll_configurations")
}

/// Tenant payroll components defining earning/deduction/tax rules and account mappings.
model PayrollComponent {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizationId     String                 @map("organization_id") @db.Uuid
  code               String                 @db.VarChar(50)
  name               String                 @db.VarChar(200)
  componentType      PayrollComponentType   @map("component_type")
  calculationType    PayrollCalculationType @default(FIXED) @map("calculation_type")
  taxable            Boolean                @default(true)
  active             Boolean                @default(true)
  expenseAccountId   String?                @map("expense_account_id") @db.Uuid
  liabilityAccountId String?                @map("liability_account_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenseAccount   Account?     @relation("PayrollComponentExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: SetNull)
  liabilityAccount Account?     @relation("PayrollComponentLiabilityAccount", fields: [liabilityAccountId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, componentType])
  @@map("payroll_components")
}

/// Tenant payroll period schedules with status lifecycle transitions.
model PayrollPeriod {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  periodNumber   String              @map("period_number") @db.VarChar(50)
  name           String              @db.VarChar(200)
  startDate      DateTime            @map("start_date") @db.Date
  endDate        DateTime            @map("end_date") @db.Date
  paymentDate    DateTime            @map("payment_date") @db.Date
  status         PayrollPeriodStatus @default(DRAFT)
  processedAt    DateTime?           @map("processed_at") @db.Timestamptz(6)
  approvedAt     DateTime?           @map("approved_at") @db.Timestamptz(6)
  postedAt       DateTime?           @map("posted_at") @db.Timestamptz(6)
  closedAt       DateTime?           @map("closed_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollRuns   PayrollRun[]
  payrollInputs PayrollInput[]

  @@unique([organizationId, periodNumber])
  @@index([organizationId, status])
  @@index([organizationId, startDate, endDate])
  @@map("payroll_periods")
}

/// Tenant payroll calculation snapshot header linked to General Ledger and Payment transactions.
model PayrollRun {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  payrollPeriodId  String           @map("payroll_period_id") @db.Uuid
  runNumber        String           @map("run_number") @db.VarChar(50)
  status           PayrollRunStatus @default(DRAFT)
  employeeCount    Int              @default(0) @map("employee_count")
  grossPay         Decimal          @default(0) @map("gross_pay") @db.Decimal(20, 4)
  totalDeductions  Decimal          @default(0) @map("total_deductions") @db.Decimal(20, 4)
  totalTax         Decimal          @default(0) @map("total_tax") @db.Decimal(20, 4)
  netPay           Decimal          @default(0) @map("net_pay") @db.Decimal(20, 4)
  employerCost     Decimal          @default(0) @map("employer_cost") @db.Decimal(20, 4)
  journalEntryId   String?          @map("journal_entry_id") @db.Uuid
  paymentId        String?          @map("payment_id") @db.Uuid
  createdByUserId  String           @map("created_by_user_id") @db.Uuid
  approvedByUserId String?          @map("approved_by_user_id") @db.Uuid
  processedAt      DateTime?        @map("processed_at") @db.Timestamptz(6)
  postedAt         DateTime?        @map("posted_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollPeriod    PayrollPeriod     @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  journalEntry     JournalEntry?     @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  payment          Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  payrollEmployees PayrollEmployee[]

  @@unique([organizationId, runNumber])
  @@index([organizationId, payrollPeriodId])
  @@index([organizationId, status])
  @@map("payroll_runs")
}

/// Tenant individual employee payroll snapshot breakdown.
model PayrollEmployee {
  id                    String               @id @default(uuid()) @db.Uuid
  organizationId        String               @map("organization_id") @db.Uuid
  payrollRunId          String               @map("payroll_run_id") @db.Uuid
  employeeId            String               @map("employee_id") @db.Uuid
  baseSalary            Decimal              @default(0) @map("base_salary") @db.Decimal(20, 4)
  allowances            Decimal              @default(0) @map("allowances") @db.Decimal(20, 4)
  overtime              Decimal              @default(0) @map("overtime") @db.Decimal(20, 4)
  grossPay              Decimal              @default(0) @map("gross_pay") @db.Decimal(20, 4)
  taxableIncome         Decimal              @default(0) @map("taxable_income") @db.Decimal(20, 4)
  employeeTax           Decimal              @default(0) @map("employee_tax") @db.Decimal(20, 4)
  employeeDeductions    Decimal              @default(0) @map("employee_deductions") @db.Decimal(20, 4)
  employerContributions Decimal              @default(0) @map("employer_contributions") @db.Decimal(20, 4)
  netPay                Decimal              @default(0) @map("net_pay") @db.Decimal(20, 4)
  totalEmployerCost     Decimal              @default(0) @map("total_employer_cost") @db.Decimal(20, 4)
  paymentStatus         PayrollPaymentStatus @default(PENDING) @map("payment_status")
  paymentId             String?              @map("payment_id") @db.Uuid
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollRun   PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([payrollRunId, employeeId])
  @@index([organizationId, payrollRunId])
  @@index([organizationId, employeeId])
  @@map("payroll_employees")
}

/// Tenant variable payroll inputs (overtime hours, bonuses, deductions) feeding payroll calculations.
model PayrollInput {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  payrollPeriodId String           @map("payroll_period_id") @db.Uuid
  employeeId      String           @map("employee_id") @db.Uuid
  inputType       PayrollInputType @map("input_type")
  quantity        Decimal          @default(0) @db.Decimal(10, 2)
  amount          Decimal          @default(0) @db.Decimal(20, 4)
  description     String?
  sourceReference String?          @map("source_reference") @db.VarChar(100)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, payrollPeriodId])
  @@index([organizationId, employeeId])
  @@map("payroll_inputs")
}

// ------------------------------------------------------------------------------
// MANUFACTURING & PRODUCTION MANAGEMENT MODELS (M25)
// ------------------------------------------------------------------------------

/// Tenant Bill of Materials (BOM) master header aggregate.
model BillOfMaterial {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  bomNumber      String    @map("bom_number") @db.VarChar(50)
  name           String    @db.VarChar(200)
  description    String?
  itemId         String    @map("item_id") @db.Uuid
  variantId      String?   @map("variant_id") @db.Uuid
  quantity       Decimal   @default(1.0000) @db.Decimal(18, 4)
  uomId          String    @map("uom_id") @db.Uuid
  version        Int       @default(1)
  status         BomStatus @default(DRAFT)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item                 Item                  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant              ItemVariant?          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  uom                  UnitOfMeasure         @relation(fields: [uomId], references: [id], onDelete: Restrict)
  lines                BillOfMaterialLine[]
  productionOrders     ProductionOrder[]
  itemPlanningProfiles ItemPlanningProfile[]
  plannedOrders        PlannedOrder[]

  @@unique([organizationId, bomNumber])
  @@index([organizationId, itemId])
  @@index([organizationId, status])
  @@map("bill_of_materials")
}

/// Tenant Bill of Materials (BOM) itemized component line.
model BillOfMaterialLine {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  bomId           String   @map("bom_id") @db.Uuid
  itemId          String   @map("item_id") @db.Uuid
  variantId       String?  @map("variant_id") @db.Uuid
  quantity        Decimal  @db.Decimal(18, 4)
  uomId           String   @map("uom_id") @db.Uuid
  scrapPercentage Decimal  @default(0.00) @map("scrap_percentage") @db.Decimal(5, 2)
  lineNumber      Int      @default(1) @map("line_number")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bom          BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item         Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant      ItemVariant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  uom          UnitOfMeasure  @relation(fields: [uomId], references: [id], onDelete: Restrict)

  @@index([organizationId, bomId])
  @@index([organizationId, itemId])
  @@map("bill_of_material_lines")
}

/// Tenant-level manufacturing settings and General Ledger mapping configuration.
model ManufacturingConfiguration {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationId         String   @unique @map("organization_id") @db.Uuid
  wipAccountId           String?  @map("wip_account_id") @db.Uuid
  rawMaterialAccountId   String?  @map("raw_material_account_id") @db.Uuid
  finishedGoodsAccountId String?  @map("finished_goods_account_id") @db.Uuid
  laborAccountId         String?  @map("labor_account_id") @db.Uuid
  overheadAccountId      String?  @map("overhead_account_id") @db.Uuid
  varianceAccountId      String?  @map("variance_account_id") @db.Uuid
  allowReleaseOnShortage Boolean  @default(false) @map("allow_release_on_shortage")
  defaultLocationId      String?  @map("default_location_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wipAccount           Account?     @relation("WipAccount", fields: [wipAccountId], references: [id], onDelete: SetNull)
  rawMaterialAccount   Account?     @relation("RawMaterialAccount", fields: [rawMaterialAccountId], references: [id], onDelete: SetNull)
  finishedGoodsAccount Account?     @relation("FinishedGoodsAccount", fields: [finishedGoodsAccountId], references: [id], onDelete: SetNull)
  laborAccount         Account?     @relation("LaborAccount", fields: [laborAccountId], references: [id], onDelete: SetNull)
  overheadAccount      Account?     @relation("OverheadAccount", fields: [overheadAccountId], references: [id], onDelete: SetNull)
  varianceAccount      Account?     @relation("VarianceAccount", fields: [varianceAccountId], references: [id], onDelete: SetNull)
  defaultLocation      Location?    @relation(fields: [defaultLocationId], references: [id], onDelete: SetNull)

  @@map("manufacturing_configurations")
}

/// Tenant production order aggregate tracking manufacturing lifecycle, costs, and GL postings.
model ProductionOrder {
  id                       String                @id @default(uuid()) @db.Uuid
  organizationId           String                @map("organization_id") @db.Uuid
  orderNumber              String                @map("order_number") @db.VarChar(50)
  itemId                   String                @map("item_id") @db.Uuid
  variantId                String?               @map("variant_id") @db.Uuid
  bomId                    String                @map("bom_id") @db.Uuid
  plannedQuantity          Decimal               @map("planned_quantity") @db.Decimal(18, 4)
  producedQuantity         Decimal               @default(0.0000) @map("produced_quantity") @db.Decimal(18, 4)
  scrapQuantity            Decimal               @default(0.0000) @map("scrap_quantity") @db.Decimal(18, 4)
  locationId               String                @map("location_id") @db.Uuid
  status                   ProductionOrderStatus @default(DRAFT)
  plannedStartDate         DateTime              @map("planned_start_date") @db.Date
  plannedCompletionDate    DateTime              @map("planned_completion_date") @db.Date
  actualStartDate          DateTime?             @map("actual_start_date") @db.Timestamptz(6)
  actualCompletionDate     DateTime?             @map("actual_completion_date") @db.Timestamptz(6)
  materialCost             Decimal               @default(0.0000) @map("material_cost") @db.Decimal(20, 4)
  laborCost                Decimal               @default(0.0000) @map("labor_cost") @db.Decimal(20, 4)
  overheadCost             Decimal               @default(0.0000) @map("overhead_cost") @db.Decimal(20, 4)
  totalCost                Decimal               @default(0.0000) @map("total_cost") @db.Decimal(20, 4)
  unitCost                 Decimal               @default(0.0000) @map("unit_cost") @db.Decimal(20, 4)
  sourceDocument           String?               @map("source_document") @db.VarChar(100)
  sourceDocumentId         String?               @map("source_document_id") @db.Uuid
  issueJournalEntryId      String?               @map("issue_journal_entry_id") @db.Uuid
  completionJournalEntryId String?               @map("completion_journal_entry_id") @db.Uuid
  varianceJournalEntryId   String?               @map("variance_journal_entry_id") @db.Uuid
  notes                    String?
  createdByUserId          String                @map("created_by_user_id") @db.Uuid
  releasedByUserId         String?               @map("released_by_user_id") @db.Uuid
  completedByUserId        String?               @map("completed_by_user_id") @db.Uuid
  closedByUserId           String?               @map("closed_by_user_id") @db.Uuid
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization           Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item                   Item                      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant                ItemVariant?              @relation(fields: [variantId], references: [id], onDelete: Restrict)
  bom                    BillOfMaterial            @relation(fields: [bomId], references: [id], onDelete: Restrict)
  location               Location                  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  issueJournalEntry      JournalEntry?             @relation("ProductionIssueJournal", fields: [issueJournalEntryId], references: [id], onDelete: SetNull)
  completionJournalEntry JournalEntry?             @relation("ProductionCompletionJournal", fields: [completionJournalEntryId], references: [id], onDelete: SetNull)
  varianceJournalEntry   JournalEntry?             @relation("ProductionVarianceJournal", fields: [varianceJournalEntryId], references: [id], onDelete: SetNull)
  lines                  ProductionOrderLine[]
  materialIssues         ProductionMaterialIssue[]
  outputs                ProductionOutput[]
  qualityInspectionLots  QualityInspectionLot[]
  nonConformances        NonConformance[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([organizationId, itemId])
  @@index([organizationId, bomId])
  @@index([organizationId, locationId])
  @@map("production_orders")
}

/// Tenant production order component line with planned vs consumed quantity tracking.
model ProductionOrderLine {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  productionOrderId String               @map("production_order_id") @db.Uuid
  itemId            String               @map("item_id") @db.Uuid
  variantId         String?              @map("variant_id") @db.Uuid
  requiredQuantity  Decimal              @map("required_quantity") @db.Decimal(18, 4)
  issuedQuantity    Decimal              @default(0.0000) @map("issued_quantity") @db.Decimal(18, 4)
  returnedQuantity  Decimal              @default(0.0000) @map("returned_quantity") @db.Decimal(18, 4)
  consumedQuantity  Decimal              @default(0.0000) @map("consumed_quantity") @db.Decimal(18, 4)
  scrapQuantity     Decimal              @default(0.0000) @map("scrap_quantity") @db.Decimal(18, 4)
  unitCost          Decimal              @default(0.0000) @map("unit_cost") @db.Decimal(20, 4)
  totalCost         Decimal              @default(0.0000) @map("total_cost") @db.Decimal(20, 4)
  uomId             String               @map("uom_id") @db.Uuid
  status            ProductionLineStatus @default(PENDING)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionOrder ProductionOrder           @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  item            Item                      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant         ItemVariant?              @relation(fields: [variantId], references: [id], onDelete: Restrict)
  uom             UnitOfMeasure             @relation(fields: [uomId], references: [id], onDelete: Restrict)
  materialIssues  ProductionMaterialIssue[]

  @@index([organizationId, productionOrderId])
  @@index([organizationId, itemId])
  @@map("production_order_lines")
}

/// Tenant production raw material issuance transaction.
model ProductionMaterialIssue {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  productionOrderId     String   @map("production_order_id") @db.Uuid
  productionOrderLineId String   @map("production_order_line_id") @db.Uuid
  itemId                String   @map("item_id") @db.Uuid
  variantId             String?  @map("variant_id") @db.Uuid
  locationId            String   @map("location_id") @db.Uuid
  quantity              Decimal  @db.Decimal(18, 4)
  unitCost              Decimal  @default(0.0000) @map("unit_cost") @db.Decimal(20, 4)
  totalCost             Decimal  @default(0.0000) @map("total_cost") @db.Decimal(20, 4)
  batchId               String?  @map("batch_id") @db.Uuid
  serialId              String?  @map("serial_id") @db.Uuid
  stockMovementId       String?  @map("stock_movement_id") @db.Uuid
  issueDate             DateTime @default(now()) @map("issue_date") @db.Timestamptz(6)
  createdByUserId       String   @map("created_by_user_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionOrder     ProductionOrder     @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionOrderLine ProductionOrderLine @relation(fields: [productionOrderLineId], references: [id], onDelete: Cascade)
  item                Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant             ItemVariant?        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location            Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  batch               InventoryBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  serial              InventorySerial?    @relation(fields: [serialId], references: [id], onDelete: SetNull)
  stockMovement       StockMovement?      @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)

  @@index([organizationId, productionOrderId])
  @@index([organizationId, itemId])
  @@map("production_material_issues")
}

/// Tenant finished goods output / completion receipt transaction.
model ProductionOutput {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  productionOrderId String   @map("production_order_id") @db.Uuid
  itemId            String   @map("item_id") @db.Uuid
  variantId         String?  @map("variant_id") @db.Uuid
  locationId        String   @map("location_id") @db.Uuid
  quantity          Decimal  @db.Decimal(18, 4)
  scrapQuantity     Decimal  @default(0.0000) @map("scrap_quantity") @db.Decimal(18, 4)
  unitCost          Decimal  @default(0.0000) @map("unit_cost") @db.Decimal(20, 4)
  totalCost         Decimal  @default(0.0000) @map("total_cost") @db.Decimal(20, 4)
  batchId           String?  @map("batch_id") @db.Uuid
  serialId          String?  @map("serial_id") @db.Uuid
  stockMovementId   String?  @map("stock_movement_id") @db.Uuid
  outputDate        DateTime @default(now()) @map("output_date") @db.Timestamptz(6)
