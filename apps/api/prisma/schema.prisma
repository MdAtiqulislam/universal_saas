// ------------------------------------------------------------------------------
// GLOBAL MODELS (Platform & Authentication)
// ------------------------------------------------------------------------------

/// Global User Identity for authentication and platform-level credentials.
/// Access to specific tenant organizations is managed via OrganizationMember.
model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  passwordHash        String    @map("password_hash")
  status              String    @default("ACTIVE") // ACTIVE, SUSPENDED
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  memberships                OrganizationMember[]
  sessions                   Session[]
  auditLogs                  AuditLog[]
  expenseClaimants           ExpenseClaimant[]
  expenseReceipts            ExpenseReceipt[]
  loginAttempts              LoginAttempt[]
  securityEvents             SecurityEvent[]
  // M38 — Observability
  ownedIncidents             OperationalIncident[]    @relation("IncidentOwner")
  // M39 — Integration Platform
  createdApiKeys             ApiKey[]
  // M40 — Workflow Automation
  createdWorkflowDefinitions WorkflowDefinition[]     @relation("WorkflowDefinitionCreator")
  publishedWorkflowVersions  WorkflowVersion[]        @relation("WorkflowVersionPublisher")
  workflowApprovalActions    WorkflowApprovalAction[] @relation("ApprovalActor")
  delegatedApprovalActions   WorkflowApprovalAction[] @relation("ApprovalDelegator")
  // M43 — Notifications
  notificationRecipients     NotificationRecipient[]
  notificationPreferences    NotificationPreference[]
  pushDevices                PushDevice[]
  // M44 — Unified Search, Discovery & Saved Views
  searchHistories            SearchHistory[]
  recentItems                RecentItem[]
  favoriteItems              FavoriteItem[]
  ownedSavedViews            SavedView[]              @relation("SavedViewOwner")
  searchAlerts               SearchAlert[]
  // M45 — Analytics, Reporting & BI Foundation
  ownedSavedReports          SavedReport[]            @relation("ReportOwner")
  ownedDashboards            Dashboard[]              @relation("DashboardOwner")
  // M46 — Data Export, Import & Bulk Operations Platform
  dataOperationJobs          DataOperationJob[]       @relation("DataOperationJobUser")
  // M47.1 — Governance Foundation
  dsarSubjectRequests        DsarRequest[]            @relation("DsarSubject")
  dsarSubmittedRequests      DsarRequest[]            @relation("DsarRequester")
  dsarVerifiedRequests       DsarRequest[]            @relation("DsarVerifier")
  dsarReviewedRequests       DsarRequest[]            @relation("DsarReviewer")
  dsarApprovedRequests       DsarRequest[]            @relation("DsarApprover")
  legalHoldsCreated          LegalHold[]              @relation("LegalHoldCreator")
  legalHoldsReleased         LegalHold[]              @relation("LegalHoldReleaser")

  @@map("users")
}

/// Active user sessions for JWT token rotation, refresh tokens, and revocation.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  deviceInfo       String?   @map("device_info")
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?   @map("revoked_reason")
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

/// Global System Permissions defining granular actions across resources.
/// Example naming convention: 'resource.action' (e.g. 'users.view', 'roles.manage').
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Role definition supporting both Global System Roles and Custom Tenant Roles.
/// - Global System Roles: organizationId IS NULL, isSystem = true.
/// - Custom Tenant Roles: organizationId IS NOT NULL, isSystem = false.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  memberRoles     MemberRole[]

  @@index([organizationId])
  @@map("roles")
}

/// Associative mapping between Roles and Permissions.
model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Global currency reference data (ISO-4217 currency definitions).
model Currency {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique @db.VarChar(10)
  name          String   @db.VarChar(100)
  symbol        String?  @db.VarChar(10)
  decimalPlaces Int      @default(2) @map("decimal_places")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  pricingTiers            PricingTier[]
  suppliers               Supplier[]
  purchaseOrders          PurchaseOrder[]
  purchaseCostAllocations PurchaseCostAllocation[]
  customers               Customer[]
  customerPrices          CustomerPrice[]
  quotations              Quotation[]
  salesOrders             SalesOrder[]
  supplierInvoices        SupplierInvoice[]
  customerInvoices        CustomerInvoice[]
  paymentAccounts         PaymentAccount[]
  payments                Payment[]
  bankAccountProfiles     BankAccountProfile[]
  bankStatements          BankStatement[]
  customerCreditNotes     CustomerCreditNote[]
