// ------------------------------------------------------------------------------
// MATERIAL REQUIREMENTS PLANNING (MRP) & SUPPLY PLANNING MODELS (M26)
// ------------------------------------------------------------------------------

/// Tenant MRP and supply planning general configuration.
model PlanningConfiguration {
  id                         String   @id @default(uuid()) @db.Uuid
  organizationId             String   @unique @map("organization_id") @db.Uuid
  defaultPlanningHorizonDays Int      @default(30) @map("default_planning_horizon_days")
  defaultLeadTimeDays        Int      @default(7) @map("default_lead_time_days")
  defaultSafetyStock         Decimal  @default(0.0000) @map("default_safety_stock") @db.Decimal(18, 4)
  includeSalesOrders         Boolean  @default(true) @map("include_sales_orders")
  includeProductionOrders    Boolean  @default(true) @map("include_production_orders")
  includeSafetyStock         Boolean  @default(true) @map("include_safety_stock")
  defaultLocationId          String?  @map("default_location_id") @db.Uuid
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultLocation Location?    @relation(fields: [defaultLocationId], references: [id], onDelete: SetNull)

  @@map("planning_configurations")
}

/// Tenant item/variant-level planning parameters (safety stock, lead time, MOQ, order multiple).
model ItemPlanningProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  itemId              String   @map("item_id") @db.Uuid
  variantId           String?  @map("variant_id") @db.Uuid
  leadTimeDays        Int      @default(7) @map("lead_time_days")
  safetyStock         Decimal  @default(0.0000) @map("safety_stock") @db.Decimal(18, 4)
  reorderPoint        Decimal  @default(0.0000) @map("reorder_point") @db.Decimal(18, 4)
  minOrderQuantity    Decimal  @default(1.0000) @map("min_order_quantity") @db.Decimal(18, 4)
  maxOrderQuantity    Decimal? @map("max_order_quantity") @db.Decimal(18, 4)
  orderMultiple       Decimal  @default(1.0000) @map("order_multiple") @db.Decimal(18, 4)
  preferredSupplierId String?  @map("preferred_supplier_id") @db.Uuid
  preferredBomId      String?  @map("preferred_bom_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item              Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variant           ItemVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  preferredSupplier Supplier?       @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  preferredBom      BillOfMaterial? @relation(fields: [preferredBomId], references: [id], onDelete: SetNull)

  @@index([organizationId, itemId])
  @@map("item_planning_profiles")
}

/// Tenant MRP planning run execution header.
model PlanningRun {
  id                      String            @id @default(uuid()) @db.Uuid
  organizationId          String            @map("organization_id") @db.Uuid
  runNumber               String            @map("run_number") @db.VarChar(50)
  name                    String            @db.VarChar(200)
  startDate               DateTime          @map("start_date") @db.Date
  endDate                 DateTime          @map("end_date") @db.Date
  locationId              String?           @map("location_id") @db.Uuid
  itemId                  String?           @map("item_id") @db.Uuid
  status                  PlanningRunStatus @default(DRAFT)
  includeSalesOrders      Boolean           @default(true) @map("include_sales_orders")
  includeProductionOrders Boolean           @default(true) @map("include_production_orders")
  includeSafetyStock      Boolean           @default(true) @map("include_safety_stock")
  totalDemandCount        Int               @default(0) @map("total_demand_count")
  totalSupplyCount        Int               @default(0) @map("total_supply_count")
  totalResultCount        Int               @default(0) @map("total_result_count")
  totalShortageCount      Int               @default(0) @map("total_shortage_count")
  totalPlannedOrderCount  Int               @default(0) @map("total_planned_order_count")
  executionStartedAt      DateTime?         @map("execution_started_at") @db.Timestamptz(6)
  executionCompletedAt    DateTime?         @map("execution_completed_at") @db.Timestamptz(6)
  errorMessage            String?           @map("error_message")
  createdByUserId         String            @map("created_by_user_id") @db.Uuid
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location             Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  item                 Item?                 @relation(fields: [itemId], references: [id], onDelete: SetNull)
  demands              PlanningDemand[]
  supplies             PlanningSupply[]
  results              PlanningResult[]
  plannedOrders        PlannedOrder[]
  purchaseRequisitions PurchaseRequisition[]

  @@unique([organizationId, runNumber])
  @@index([organizationId, status])
  @@map("planning_runs")
}

/// Tenant immutable snapshot of demand inputs for a planning run.
model PlanningDemand {
  id             String               @id @default(uuid()) @db.Uuid
  planningRunId  String               @map("planning_run_id") @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  sourceType     PlanningDemandSource @map("source_type")
  sourceId       String?              @map("source_id") @db.Uuid
  sourceNumber   String?              @map("source_number") @db.VarChar(100)
  itemId         String               @map("item_id") @db.Uuid
  variantId      String?              @map("variant_id") @db.Uuid
  locationId     String?              @map("location_id") @db.Uuid
  requiredDate   DateTime             @map("required_date") @db.Date
  quantity       Decimal              @db.Decimal(18, 4)
  uomId          String?              @map("uom_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  planningRun  PlanningRun    @relation(fields: [planningRunId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant      ItemVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  location     Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  uom          UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: SetNull)

  @@index([organizationId, planningRunId])
  @@index([organizationId, itemId])
  @@map("planning_demands")
}

/// Tenant immutable snapshot of supply inputs for a planning run.
model PlanningSupply {
  id             String               @id @default(uuid()) @db.Uuid
  planningRunId  String               @map("planning_run_id") @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  sourceType     PlanningSupplySource @map("source_type")
  sourceId       String?              @map("source_id") @db.Uuid
  sourceNumber   String?              @map("source_number") @db.VarChar(100)
  itemId         String               @map("item_id") @db.Uuid
  variantId      String?              @map("variant_id") @db.Uuid
  locationId     String?              @map("location_id") @db.Uuid
  availableDate  DateTime             @map("available_date") @db.Date
  quantity       Decimal              @db.Decimal(18, 4)
  uomId          String?              @map("uom_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  planningRun  PlanningRun    @relation(fields: [planningRunId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant      ItemVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  location     Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  uom          UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: SetNull)

  @@index([organizationId, planningRunId])
  @@index([organizationId, itemId])
  @@map("planning_supplies")
}

/// Tenant calculated MRP net requirements snapshot.
model PlanningResult {
  id                     String             @id @default(uuid()) @db.Uuid
  planningRunId          String             @map("planning_run_id") @db.Uuid
  organizationId         String             @map("organization_id") @db.Uuid
  itemId                 String             @map("item_id") @db.Uuid
  variantId              String?            @map("variant_id") @db.Uuid
  locationId             String?            @map("location_id") @db.Uuid
  grossRequirement       Decimal            @default(0.0000) @map("gross_requirement") @db.Decimal(18, 4)
  onHandQuantity         Decimal            @default(0.0000) @map("on_hand_quantity") @db.Decimal(18, 4)
  reservedQuantity       Decimal            @default(0.0000) @map("reserved_quantity") @db.Decimal(18, 4)
  availableQuantity      Decimal            @default(0.0000) @map("available_quantity") @db.Decimal(18, 4)
  expectedSupplyQuantity Decimal            @default(0.0000) @map("expected_supply_quantity") @db.Decimal(18, 4)
  safetyStockQuantity    Decimal            @default(0.0000) @map("safety_stock_quantity") @db.Decimal(18, 4)
  netRequirement         Decimal            @default(0.0000) @map("net_requirement") @db.Decimal(18, 4)
  requiredDate           DateTime           @map("required_date") @db.Date
  suggestedAction        PlannedOrderAction @map("suggested_action")
  suggestedQuantity      Decimal            @default(0.0000) @map("suggested_quantity") @db.Decimal(18, 4)
  plannedOrderDate       DateTime?          @map("planned_order_date") @db.Date
  plannedReceiptDate     DateTime?          @map("planned_receipt_date") @db.Date
  explosionLevel         Int                @default(0) @map("explosion_level")
  sourceReferences       Json?              @map("source_references")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  planningRun              PlanningRun               @relation(fields: [planningRunId], references: [id], onDelete: Cascade)
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item                     Item                      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant                  ItemVariant?              @relation(fields: [variantId], references: [id], onDelete: SetNull)
  location                 Location?                 @relation(fields: [locationId], references: [id], onDelete: SetNull)
  purchaseRequisitionLines PurchaseRequisitionLine[]

  @@index([organizationId, planningRunId])
  @@index([organizationId, itemId])
  @@map("planning_results")
}

/// Actionable procurement or production recommendation generated by MRP run.
model PlannedOrder {
  id                 String             @id @default(uuid()) @db.Uuid
  planningRunId      String             @map("planning_run_id") @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  orderNumber        String             @map("order_number") @db.VarChar(50)
  action             PlannedOrderAction
  itemId             String             @map("item_id") @db.Uuid
  variantId          String?            @map("variant_id") @db.Uuid
  locationId         String?            @map("location_id") @db.Uuid
  quantity           Decimal            @db.Decimal(18, 4)
  requiredDate       DateTime           @map("required_date") @db.Date
  plannedOrderDate   DateTime           @map("planned_order_date") @db.Date
  plannedReceiptDate DateTime           @map("planned_receipt_date") @db.Date
  supplierId         String?            @map("supplier_id") @db.Uuid
  bomId              String?            @map("bom_id") @db.Uuid
  status             PlannedOrderStatus @default(SUGGESTED)
  reason             String?
  sourceDemandRef    String?            @map("source_demand_ref")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  planningRun          PlanningRun           @relation(fields: [planningRunId], references: [id], onDelete: Cascade)
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item                 Item                  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant              ItemVariant?          @relation(fields: [variantId], references: [id], onDelete: SetNull)
  location             Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  supplier             Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  bom                  BillOfMaterial?       @relation(fields: [bomId], references: [id], onDelete: SetNull)
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, planningRunId])
  @@index([organizationId, itemId])
  @@map("planned_orders")
}

// ------------------------------------------------------------------------------
// PROCUREMENT & PURCHASE REQUISITION / RETURN MODELS (Milestone M27)
// ------------------------------------------------------------------------------

/// Tenant purchase requisition header.
model PurchaseRequisition {
  id                   String                    @id @default(uuid()) @db.Uuid
  organizationId       String                    @map("organization_id") @db.Uuid
  requisitionNumber    String                    @map("requisition_number") @db.VarChar(50)
  requesterId          String                    @map("requester_id") @db.Uuid
  departmentId         String?                   @map("department_id") @db.Uuid
  supplierId           String?                   @map("supplier_id") @db.Uuid
  locationId           String?                   @map("location_id") @db.Uuid
  currencyId           String?                   @map("currency_id") @db.Uuid
  requiredDate         DateTime                  @map("required_date") @db.Date
  status               PurchaseRequisitionStatus @default(DRAFT)
  notes                String?
  sourcePlannedOrderId String?                   @map("source_planned_order_id") @db.Uuid
  sourcePlanningRunId  String?                   @map("source_planning_run_id") @db.Uuid
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department         Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  supplier           Supplier?                 @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  location           Location?                 @relation(fields: [locationId], references: [id], onDelete: SetNull)
  currency           Currency?                 @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  sourcePlannedOrder PlannedOrder?             @relation(fields: [sourcePlannedOrderId], references: [id], onDelete: SetNull)
  sourcePlanningRun  PlanningRun?              @relation(fields: [sourcePlanningRunId], references: [id], onDelete: SetNull)
  lines              PurchaseRequisitionLine[]
  purchaseOrders     PurchaseOrder[]

  @@unique([organizationId, requisitionNumber])
  @@index([organizationId, status])
  @@index([organizationId, sourcePlannedOrderId])
  @@map("purchase_requisitions")
}

/// Tenant purchase requisition line item.
model PurchaseRequisitionLine {
  id                     String   @id @default(uuid()) @db.Uuid
  requisitionId          String   @map("requisition_id") @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  itemId                 String   @map("item_id") @db.Uuid
  variantId              String?  @map("variant_id") @db.Uuid
  quantity               Decimal  @db.Decimal(18, 4)
  estimatedUnitPrice     Decimal  @default(0.0000) @map("estimated_unit_price") @db.Decimal(18, 4)
  estimatedTotal         Decimal  @default(0.0000) @map("estimated_total") @db.Decimal(18, 4)
  requiredDate           DateTime @map("required_date") @db.Date
  sourcePlanningResultId String?  @map("source_planning_result_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  requisition          PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item                 Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant              ItemVariant?        @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sourcePlanningResult PlanningResult?     @relation(fields: [sourcePlanningResultId], references: [id], onDelete: SetNull)

  @@index([organizationId, requisitionId])
  @@index([organizationId, itemId])
  @@map("purchase_requisition_lines")
}

/// Tenant purchase return header for returning received items to suppliers.
model PurchaseReturn {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  returnNumber    String               @map("return_number") @db.VarChar(50)
  supplierId      String               @map("supplier_id") @db.Uuid
  purchaseOrderId String               @map("purchase_order_id") @db.Uuid
  goodsReceiptId  String               @map("goods_receipt_id") @db.Uuid
  locationId      String               @map("location_id") @db.Uuid
  returnDate      DateTime             @default(now()) @map("return_date") @db.Timestamptz(6)
  status          PurchaseReturnStatus @default(DRAFT)
  reason          String?
  notes           String?
  createdById     String               @map("created_by_id") @db.Uuid
  postedAt        DateTime?            @map("posted_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier      Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  goodsReceipt  GoodsReceipt         @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  location      Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines         PurchaseReturnLine[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId, status])
  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, goodsReceiptId])
  @@map("purchase_returns")
}

/// Tenant purchase return line item.
model PurchaseReturnLine {
  id                  String   @id @default(uuid()) @db.Uuid
  purchaseReturnId    String   @map("purchase_return_id") @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  goodsReceiptLineId  String   @map("goods_receipt_line_id") @db.Uuid
  itemId              String   @map("item_id") @db.Uuid
  variantId           String?  @map("variant_id") @db.Uuid
  quantity            Decimal  @db.Decimal(18, 4)
  unitCost            Decimal  @map("unit_cost") @db.Decimal(18, 4)
  inventoryMovementId String?  @map("inventory_movement_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  purchaseReturn   PurchaseReturn   @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goodsReceiptLine GoodsReceiptLine @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Restrict)
  item             Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant          ItemVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([organizationId, purchaseReturnId])
  @@map("purchase_return_lines")
}

// ------------------------------------------------------------------------------
// SHIPMENT & LOGISTICS MANAGEMENT MODELS (M29)
// ------------------------------------------------------------------------------

/// Tenant-scoped logistics carrier master.
model ShipmentCarrier {
  id                  String      @id @default(uuid()) @db.Uuid
  organizationId      String      @map("organization_id") @db.Uuid
  code                String      @db.VarChar(50)
  name                String      @db.VarChar(200)
  carrierType         CarrierType @default(COURIER) @map("carrier_type")
  contactName         String?     @map("contact_name")
  phone               String?
  email               String?
  address             String?
  trackingUrlTemplate String?     @map("tracking_url_template")
  isActive            Boolean     @default(true) @map("is_active")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipments    Shipment[]
  vehicles     ShipmentVehicle[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("shipment_carriers")
}

/// Tenant vehicle / transport reference for logistics assignment.
model ShipmentVehicle {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  carrierId          String?  @map("carrier_id") @db.Uuid
  registrationNumber String   @map("registration_number") @db.VarChar(100)
  vehicleType        String   @map("vehicle_type") @db.VarChar(50)
  driverName         String?  @map("driver_name")
  driverPhone        String?  @map("driver_phone")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  carrier      ShipmentCarrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  shipments    Shipment[]

  @@unique([organizationId, registrationNumber])
  @@index([organizationId, carrierId])
  @@map("shipment_vehicles")
}

/// Tenant shipment header orchestrating transport and delivery tracking.
model Shipment {
  id                    String         @id @default(uuid()) @db.Uuid
  organizationId        String         @map("organization_id") @db.Uuid
  shipmentNumber        String         @map("shipment_number") @db.VarChar(50)
  deliveryOrderId       String         @map("delivery_order_id") @db.Uuid
  salesOrderId          String         @map("sales_order_id") @db.Uuid
  customerId            String         @map("customer_id") @db.Uuid
  carrierId             String?        @map("carrier_id") @db.Uuid
  vehicleId             String?        @map("vehicle_id") @db.Uuid
  status                ShipmentStatus @default(DRAFT)
  serviceType           String?        @map("service_type") @db.VarChar(50)
  shipFromAddress       String?        @map("ship_from_address")
  shipToAddress         String?        @map("ship_to_address")
  plannedShipDate       DateTime?      @map("planned_ship_date") @db.Timestamptz(6)
  actualShipDate        DateTime?      @map("actual_ship_date") @db.Timestamptz(6)
  estimatedDeliveryDate DateTime?      @map("estimated_delivery_date") @db.Timestamptz(6)
  actualDeliveryDate    DateTime?      @map("actual_delivery_date") @db.Timestamptz(6)
  trackingNumber        String?        @map("tracking_number") @db.VarChar(100)
  externalReference     String?        @map("external_reference") @db.VarChar(100)
  shippingCost          Decimal        @default(0) @map("shipping_cost") @db.Decimal(18, 4)
  insuranceCost         Decimal        @default(0) @map("insurance_cost") @db.Decimal(18, 4)
  otherCost             Decimal        @default(0) @map("other_cost") @db.Decimal(18, 4)
  totalLogisticsCost    Decimal        @default(0) @map("total_logistics_cost") @db.Decimal(18, 4)
  specialInstructions   String?        @map("special_instructions")
  failureReason         String?        @map("failure_reason")
  returnReason          String?        @map("return_reason")
  cancellationReason    String?        @map("cancellation_reason")
  createdByUserId       String         @map("created_by_user_id") @db.Uuid
  updatedByUserId       String?        @map("updated_by_user_id") @db.Uuid
  dispatchedByUserId    String?        @map("dispatched_by_user_id") @db.Uuid
  dispatchedAt          DateTime?      @map("dispatched_at") @db.Timestamptz(6)
  deliveredByUserId     String?        @map("delivered_by_user_id") @db.Uuid
  deliveredAt           DateTime?      @map("delivered_at") @db.Timestamptz(6)
  cancelledByUserId     String?        @map("cancelled_by_user_id") @db.Uuid
  cancelledAt           DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryOrder          DeliveryOrder           @relation(fields: [deliveryOrderId], references: [id], onDelete: Restrict)
  salesOrder             SalesOrder              @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  customer               Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  carrier                ShipmentCarrier?        @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  vehicle                ShipmentVehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  lines                  ShipmentLine[]
  packages               ShipmentPackage[]
  trackingEvents         ShipmentTrackingEvent[]
  qualityInspectionLots  QualityInspectionLot[]
  customerQualityIssues  CustomerQualityIssue[]
  originalReturnRequests ReturnRequest[]         @relation("OriginalShipment")
  reverseReturnRequests  ReturnRequest[]         @relation("ReverseShipment")
  customerAssets         CustomerAsset[]

  @@unique([organizationId, shipmentNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, deliveryOrderId])
  @@index([organizationId, carrierId])
  @@index([organizationId, trackingNumber])
  @@index([organizationId, plannedShipDate])
  @@index([organizationId, estimatedDeliveryDate])
  @@map("shipments")
}

/// Tenant shipment line item tracking logistics quantities against delivery order lines.
model ShipmentLine {
  id                  String   @id @default(uuid()) @db.Uuid
  shipmentId          String   @map("shipment_id") @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  deliveryOrderLineId String   @map("delivery_order_line_id") @db.Uuid
  salesOrderLineId    String   @map("sales_order_line_id") @db.Uuid
  itemId              String   @map("item_id") @db.Uuid
  variantId           String?  @map("variant_id") @db.Uuid
  packageId           String?  @map("package_id") @db.Uuid
  quantity            Decimal  @db.Decimal(18, 4)
  unitOfMeasure       String?  @map("unit_of_measure") @db.VarChar(20)
  packageReference    String?  @map("package_reference")
  batchReference      String?  @map("batch_reference")
  serialReference     String?  @map("serial_reference")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  shipment          Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryOrderLine DeliveryOrderLine @relation(fields: [deliveryOrderLineId], references: [id], onDelete: Restrict)
  salesOrderLine    SalesOrderLine    @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)
  item              Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant           ItemVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  package           ShipmentPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([organizationId, shipmentId])
  @@index([organizationId, deliveryOrderLineId])
  @@map("shipment_lines")
}

/// Tenant shipment package tracking dimensions and weights.
model ShipmentPackage {
  id             String   @id @default(uuid()) @db.Uuid
  shipmentId     String   @map("shipment_id") @db.Uuid
