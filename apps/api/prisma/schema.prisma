  @@index([organizationId, isActive])
  @@map("warranty_policies")
}

/// Association between a CustomerAsset and a WarrantyPolicy with effective date ranges and claim tracking.
model CustomerAssetWarranty {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  customerAssetId  String         @map("customer_asset_id") @db.Uuid
  warrantyPolicyId String         @map("warranty_policy_id") @db.Uuid
  startDate        DateTime       @map("start_date") @db.Date
  endDate          DateTime       @map("end_date") @db.Date
  status           WarrantyStatus @default(ACTIVE)
  claimLimitAmount Decimal?       @map("claim_limit_amount") @db.Decimal(20, 4)
  claimedAmount    Decimal        @default(0) @map("claimed_amount") @db.Decimal(20, 4)
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
