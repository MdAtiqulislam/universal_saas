/// Tenant payment accounts (cash drawers, bank accounts, mobile wallets) mapped to GL accounts.
model PaymentAccount {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @map("organization_id") @db.Uuid
  code                String             @db.VarChar(50)
  name                String             @db.VarChar(100)
  type                PaymentAccountType
  currencyId          String             @map("currency_id") @db.Uuid
  accountingAccountId String             @map("accounting_account_id") @db.Uuid
  isActive            Boolean            @default(true) @map("is_active")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?          @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  organization                        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currency                            Currency               @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  accountingAccount                   Account                @relation(fields: [accountingAccountId], references: [id], onDelete: Restrict)
  payments                            Payment[]
  bankAccountProfile                  BankAccountProfile?
  bankStatements                      BankStatement[]
  bankReconciliations                 BankReconciliation[]
  customerRefunds                     CustomerRefund[]
  expenseClaimants                    ExpenseClaimant[]
  employeeDefaultPaymentAccounts      Employee[]             @relation("EmployeeDefaultPaymentAccount")
  employeeCompensationPaymentAccounts EmployeeCompensation[] @relation("EmployeeCompensationPaymentAccount")

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([organizationId, type])
  @@map("payment_accounts")
}

/// Tenant payment transactions (Customer Receipts and Supplier Payments).
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  paymentNumber     String        @map("payment_number") @db.VarChar(50)
  type              PaymentType
  paymentAccountId  String        @map("payment_account_id") @db.Uuid
  currencyId        String        @map("currency_id") @db.Uuid
  customerId        String?       @map("customer_id") @db.Uuid
  supplierId        String?       @map("supplier_id") @db.Uuid
  claimantId        String?       @map("claimant_id") @db.Uuid
  paymentDate       DateTime      @map("payment_date") @db.Date
  amount            Decimal       @db.Decimal(20, 4)
  allocatedAmount   Decimal       @default(0) @map("allocated_amount") @db.Decimal(20, 4)
  unallocatedAmount Decimal       @default(0) @map("unallocated_amount") @db.Decimal(20, 4)
  reference         String?       @db.VarChar(100)
  notes             String?
  status            PaymentStatus @default(DRAFT)
  createdByUserId   String        @map("created_by_user_id") @db.Uuid
  postedByUserId    String?       @map("posted_by_user_id") @db.Uuid
  postedAt          DateTime?     @map("posted_at") @db.Timestamptz(6)
  voidedAt          DateTime?     @map("voided_at") @db.Timestamptz(6)
  journalEntryId    String?       @map("journal_entry_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  organization            Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentAccount          PaymentAccount             @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)
  currency                Currency                   @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  customer                Customer?                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier                Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  claimant                ExpenseClaimant?           @relation(fields: [claimantId], references: [id], onDelete: Restrict)
  journalEntry            JournalEntry?              @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  allocations             PaymentAllocation[]
  matchedBankTransactions BankStatementTransaction[]
  customerRefunds         CustomerRefund[]
  payrollRuns             PayrollRun[]
  payrollEmployees        PayrollEmployee[]

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerId])
  @@index([organizationId, supplierId])
  @@index([organizationId, claimantId])
  @@index([organizationId, paymentAccountId])
  @@index([organizationId, paymentDate])
  @@map("payments")
}

/// Tenant payment allocation linking payments to specific customer or supplier invoices.
model PaymentAllocation {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  paymentId         String   @map("payment_id") @db.Uuid
  customerInvoiceId String?  @map("customer_invoice_id") @db.Uuid
  supplierInvoiceId String?  @map("supplier_invoice_id") @db.Uuid
  expenseClaimId    String?  @map("expense_claim_id") @db.Uuid
  amount            Decimal  @db.Decimal(20, 4)
  allocatedAt       DateTime @default(now()) @map("allocated_at") @db.Timestamptz(6)
  createdByUserId   String   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment         Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  customerInvoice CustomerInvoice? @relation(fields: [customerInvoiceId], references: [id], onDelete: Restrict)
  supplierInvoice SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id], onDelete: Restrict)
  expenseClaim    ExpenseClaim?    @relation(fields: [expenseClaimId], references: [id], onDelete: Restrict)

  @@index([organizationId, paymentId])
  @@index([organizationId, customerInvoiceId])
  @@index([organizationId, supplierInvoiceId])
  @@index([organizationId, expenseClaimId])
  @@map("payment_allocations")
}

// ------------------------------------------------------------------------------
// BANK RECONCILIATION & CASH MANAGEMENT MODELS (M16)
// ------------------------------------------------------------------------------

/// Bank-specific metadata for a tenant payment account.
model BankAccountProfile {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  paymentAccountId    String    @unique @map("payment_account_id") @db.Uuid
  bankName            String    @map("bank_name") @db.VarChar(100)
  branchName          String?   @map("branch_name") @db.VarChar(100)
  accountNumberMasked String    @map("account_number_masked") @db.VarChar(50)
  accountHolderName   String    @map("account_holder_name") @db.VarChar(100)
  routingNumber       String?   @map("routing_number") @db.VarChar(50)
  currencyId          String    @map("currency_id") @db.Uuid
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentAccount PaymentAccount @relation(fields: [paymentAccountId], references: [id], onDelete: Cascade)
  currency       Currency       @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@unique([organizationId, paymentAccountId])
  @@unique([organizationId, accountNumberMasked])
  @@map("bank_account_profiles")
}

/// Tenant bank statement header.
model BankStatement {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  paymentAccountId String              @map("payment_account_id") @db.Uuid
  statementNumber  String              @map("statement_number") @db.VarChar(50)
  statementDate    DateTime            @map("statement_date") @db.Date
  openingBalance   Decimal             @map("opening_balance") @db.Decimal(20, 4)
  closingBalance   Decimal             @map("closing_balance") @db.Decimal(20, 4)
  currencyId       String              @map("currency_id") @db.Uuid
  status           BankStatementStatus @default(DRAFT)
  source           String?             @db.VarChar(50)
  createdByUserId  String              @map("created_by_user_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentAccount  PaymentAccount             @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)
  currency        Currency                   @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  transactions    BankStatementTransaction[]
  reconciliations BankReconciliation[]

  @@unique([organizationId, statementNumber])
  @@index([organizationId, paymentAccountId])
  @@index([organizationId, statementDate])
  @@index([organizationId, status])
  @@map("bank_statements")
}

/// Tenant bank statement individual debit/credit transactions.
model BankStatementTransaction {
  id                    String                @id @default(uuid()) @db.Uuid
  organizationId        String                @map("organization_id") @db.Uuid
  bankStatementId       String                @map("bank_statement_id") @db.Uuid
  transactionDate       DateTime              @map("transaction_date") @db.Date
  valueDate             DateTime?             @map("value_date") @db.Date
  description           String                @db.VarChar(255)
  reference             String?               @db.VarChar(100)
  externalTransactionId String?               @map("external_transaction_id") @db.VarChar(100)
  debitAmount           Decimal               @default(0) @map("debit_amount") @db.Decimal(20, 4)
  creditAmount          Decimal               @default(0) @map("credit_amount") @db.Decimal(20, 4)
  amount                Decimal               @db.Decimal(20, 4)
  runningBalance        Decimal?              @map("running_balance") @db.Decimal(20, 4)
  status                BankTransactionStatus @default(UNMATCHED)
  matchedPaymentId      String?               @map("matched_payment_id") @db.Uuid
  matchedJournalEntryId String?               @map("matched_journal_entry_id") @db.Uuid
  reconciliationDate    DateTime?             @map("reconciliation_date") @db.Timestamptz(6)
  reconciledByUserId    String?               @map("reconciled_by_user_id") @db.Uuid
  metadata              Json?
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankStatement       BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)
  matchedPayment      Payment?      @relation(fields: [matchedPaymentId], references: [id], onDelete: SetNull)
  matchedJournalEntry JournalEntry? @relation(fields: [matchedJournalEntryId], references: [id], onDelete: SetNull)

  @@index([organizationId, bankStatementId])
  @@index([bankStatementId, transactionDate])
  @@index([bankStatementId, status])
  @@index([organizationId, matchedPaymentId])
  @@index([organizationId, externalTransactionId])
  @@map("bank_statement_transactions")
}

/// Tenant bank reconciliation session.
model BankReconciliation {
  id                   String                   @id @default(uuid()) @db.Uuid
  organizationId       String                   @map("organization_id") @db.Uuid
  reconciliationNumber String                   @map("reconciliation_number") @db.VarChar(50)
  paymentAccountId     String                   @map("payment_account_id") @db.Uuid
  statementId          String                   @unique @map("statement_id") @db.Uuid
  periodStart          DateTime                 @map("period_start") @db.Date
  periodEnd            DateTime                 @map("period_end") @db.Date
  bookBalance          Decimal                  @map("book_balance") @db.Decimal(20, 4)
  statementBalance     Decimal                  @map("statement_balance") @db.Decimal(20, 4)
  reconciledBalance    Decimal                  @map("reconciled_balance") @db.Decimal(20, 4)
  difference           Decimal                  @map("difference") @db.Decimal(20, 4)
  status               BankReconciliationStatus @default(OPEN)
  startedByUserId      String                   @map("started_by_user_id") @db.Uuid
  completedByUserId    String?                  @map("completed_by_user_id") @db.Uuid
  completedAt          DateTime?                @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentAccount PaymentAccount @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)
  statement      BankStatement  @relation(fields: [statementId], references: [id], onDelete: Restrict)

  @@unique([organizationId, reconciliationNumber])
  @@unique([organizationId, statementId])
  @@index([organizationId, paymentAccountId])
  @@index([organizationId, status])
  @@map("bank_reconciliations")
}

// ------------------------------------------------------------------------------
// CREDIT NOTES, DEBIT NOTES & REFUNDS MODELS (M18)
// ------------------------------------------------------------------------------

/// Tenant customer credit note header.
model CustomerCreditNote {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  creditNoteNumber  String           @map("credit_note_number") @db.VarChar(50)
  customerId        String           @map("customer_id") @db.Uuid
  customerInvoiceId String?          @map("customer_invoice_id") @db.Uuid
  salesOrderId      String?          @map("sales_order_id") @db.Uuid
  deliveryOrderId   String?          @map("delivery_order_id") @db.Uuid
  currencyId        String           @map("currency_id") @db.Uuid
  creditDate        DateTime         @map("credit_date") @db.Date
  reason            String?          @db.VarChar(255)
  notes             String?
  subtotal          Decimal          @default(0) @db.Decimal(20, 4)
  discountAmount    Decimal          @default(0) @map("discount_amount") @db.Decimal(20, 4)
  taxAmount         Decimal          @default(0) @map("tax_amount") @db.Decimal(20, 4)
  grandTotal        Decimal          @default(0) @map("grand_total") @db.Decimal(20, 4)
  appliedAmount     Decimal          @default(0) @map("applied_amount") @db.Decimal(20, 4)
  remainingAmount   Decimal          @default(0) @map("remaining_amount") @db.Decimal(20, 4)
  status            CreditNoteStatus @default(DRAFT)
  createdByUserId   String           @map("created_by_user_id") @db.Uuid
  approvedByUserId  String?          @map("approved_by_user_id") @db.Uuid
  approvedAt        DateTime?        @map("approved_at") @db.Timestamptz(6)
  postedByUserId    String?          @map("posted_by_user_id") @db.Uuid
  postedAt          DateTime?        @map("posted_at") @db.Timestamptz(6)
  voidedAt          DateTime?        @map("voided_at") @db.Timestamptz(6)
  journalEntryId    String?          @map("journal_entry_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerInvoice   CustomerInvoice?            @relation(fields: [customerInvoiceId], references: [id], onDelete: SetNull)
  salesOrder        SalesOrder?                 @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  deliveryOrder     DeliveryOrder?              @relation(fields: [deliveryOrderId], references: [id], onDelete: SetNull)
  currency          Currency                    @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  journalEntry      JournalEntry?               @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  lines             CustomerCreditNoteLine[]
  applications      CustomerCreditApplication[]
  refunds           CustomerRefund[]
  returnResolutions ReturnResolution[]

  @@unique([organizationId, creditNoteNumber])
  @@index([organizationId, customerId])
  @@index([organizationId, status])
  @@index([organizationId, customerInvoiceId])
  @@index([organizationId, creditDate])
  @@map("customer_credit_notes")
}

/// Line items for customer credit notes with optional return-to-inventory.
model CustomerCreditNoteLine {
  id                    String             @id @default(uuid()) @db.Uuid
  creditNoteId          String             @map("credit_note_id") @db.Uuid
  organizationId        String             @map("organization_id") @db.Uuid
  itemId                String             @map("item_id") @db.Uuid
  variantId             String?            @map("variant_id") @db.Uuid
  customerInvoiceLineId String?            @map("customer_invoice_line_id") @db.Uuid
  description           String?            @db.VarChar(255)
  quantity              Decimal            @db.Decimal(18, 4)
  unitPrice             Decimal            @map("unit_price") @db.Decimal(20, 4)
  discountAmount        Decimal            @default(0) @map("discount_amount") @db.Decimal(20, 4)
  taxRate               Decimal            @default(0) @map("tax_rate") @db.Decimal(12, 4)
  taxAmount             Decimal            @default(0) @map("tax_amount") @db.Decimal(20, 4)
  lineTotal             Decimal            @map("line_total") @db.Decimal(20, 4)
  returnToInventory     Boolean            @default(false) @map("return_to_inventory")
  disposition           ReturnDisposition?
  locationId            String?            @map("location_id") @db.Uuid
  batchNumber           String?            @map("batch_number") @db.VarChar(100)
  serialNumbers         String[]           @map("serial_numbers")
  lineNumber            Int                @map("line_number")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  creditNote          CustomerCreditNote   @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item                Item                 @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant             ItemVariant?         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  customerInvoiceLine CustomerInvoiceLine? @relation(fields: [customerInvoiceLineId], references: [id], onDelete: SetNull)
  location            Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([organizationId, creditNoteId])
  @@index([organizationId, itemId])
  @@index([organizationId, locationId])
  @@map("customer_credit_note_lines")
}

/// Tenant customer credit application against customer invoices.
model CustomerCreditApplication {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  creditNoteId      String   @map("credit_note_id") @db.Uuid
  customerInvoiceId String   @map("customer_invoice_id") @db.Uuid
  amount            Decimal  @db.Decimal(20, 4)
  appliedAt         DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)
  createdByUserId   String   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditNote      CustomerCreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  customerInvoice CustomerInvoice    @relation(fields: [customerInvoiceId], references: [id], onDelete: Restrict)

  @@index([organizationId, creditNoteId])
  @@index([organizationId, customerInvoiceId])
  @@map("customer_credit_applications")
}

/// Tenant customer refund against credit notes or invoice overpayment.
model CustomerRefund {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  refundNumber     String       @map("refund_number") @db.VarChar(50)
  customerId       String       @map("customer_id") @db.Uuid
  creditNoteId     String?      @map("credit_note_id") @db.Uuid
  paymentAccountId String       @map("payment_account_id") @db.Uuid
  currencyId       String       @map("currency_id") @db.Uuid
  refundDate       DateTime     @map("refund_date") @db.Date
  amount           Decimal      @db.Decimal(20, 4)
  reason           String?      @db.VarChar(255)
  reference        String?      @db.VarChar(100)
  notes            String?
  status           RefundStatus @default(DRAFT)
  paymentId        String?      @map("payment_id") @db.Uuid
  journalEntryId   String?      @map("journal_entry_id") @db.Uuid
  createdByUserId  String       @map("created_by_user_id") @db.Uuid
  postedByUserId   String?      @map("posted_by_user_id") @db.Uuid
  postedAt         DateTime?    @map("posted_at") @db.Timestamptz(6)
  voidedAt         DateTime?    @map("voided_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creditNote        CustomerCreditNote? @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)
  paymentAccount    PaymentAccount      @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)
  currency          Currency            @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  payment           Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  journalEntry      JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  returnResolutions ReturnResolution[]

  @@unique([organizationId, refundNumber])
  @@index([organizationId, customerId])
  @@index([organizationId, creditNoteId])
  @@index([organizationId, status])
  @@index([organizationId, paymentAccountId])
  @@map("customer_refunds")
}

