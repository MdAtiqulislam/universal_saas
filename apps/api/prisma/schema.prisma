/// Tenant Chart of Accounts defining the general ledger account hierarchy.
model Account {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  code           String      @db.VarChar(50)
  name           String      @db.VarChar(200)
  type           AccountType
  parentId       String?     @map("parent_id") @db.Uuid
  description    String?
  isActive       Boolean     @default(true) @map("is_active")
  isSystem       Boolean     @default(false) @map("is_system")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  organization                        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent                              Account?                     @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                            Account[]                    @relation("AccountHierarchy")
  journalLines                        JournalLine[]
  accountingAccountMappings           AccountingAccountMapping[]
  paymentAccounts                     PaymentAccount[]
  expenseCategories                   ExpenseCategory[]
  expenseClaimLines                   ExpenseClaimLine[]
  assetCategoryAssetAccounts          AssetCategory[]              @relation("AssetCategoryAssetAccount")
  assetCategoryAccumulatedDepAccounts AssetCategory[]              @relation("AssetCategoryAccumulatedDepAccount")
  assetCategoryDepExpenseAccounts     AssetCategory[]              @relation("AssetCategoryDepExpenseAccount")
  fixedAssetAssetAccounts             FixedAsset[]                 @relation("FixedAssetAssetAccount")
  fixedAssetAccumulatedDepAccounts    FixedAsset[]                 @relation("FixedAssetAccumulatedDepAccount")
  fixedAssetDepExpenseAccounts        FixedAsset[]                 @relation("FixedAssetDepExpenseAccount")
  budgetLines                         BudgetLine[]
  payrollExpenseConfigs               PayrollConfiguration[]       @relation("PayrollExpenseAccount")
  payrollPayableConfigs               PayrollConfiguration[]       @relation("PayrollPayableAccount")
  payrollTaxPayableConfigs            PayrollConfiguration[]       @relation("PayrollTaxPayableAccount")
  overtimeExpenseConfigs              PayrollConfiguration[]       @relation("OvertimeExpenseAccount")
  payrollComponentExpenseAccounts     PayrollComponent[]           @relation("PayrollComponentExpenseAccount")
  payrollComponentLiabilityAccounts   PayrollComponent[]           @relation("PayrollComponentLiabilityAccount")
  wipManufacturingConfigs             ManufacturingConfiguration[] @relation("WipAccount")
  rawMaterialManufacturingConfigs     ManufacturingConfiguration[] @relation("RawMaterialAccount")
  finishedGoodsManufacturingConfigs   ManufacturingConfiguration[] @relation("FinishedGoodsAccount")
  laborManufacturingConfigs           ManufacturingConfiguration[] @relation("LaborAccount")
  overheadManufacturingConfigs        ManufacturingConfiguration[] @relation("OverheadAccount")
  varianceManufacturingConfigs        ManufacturingConfiguration[] @relation("VarianceAccount")
  configServiceRevenueAccounts        ServiceConfiguration[]       @relation("ConfigServiceRevenueAccount")
  configWarrantyExpenseAccounts       ServiceConfiguration[]       @relation("ConfigWarrantyExpenseAccount")
  configServicePartsExpenseAccounts   ServiceConfiguration[]       @relation("ConfigServicePartsExpenseAccount")

  @@unique([organizationId, code])
  @@index([organizationId, type])
  @@index([organizationId, parentId])
  @@map("accounts")
}

/// Tenant accounting fiscal periods with locking mechanisms.
model FiscalPeriod {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  name             String             @db.VarChar(100)
  fiscalYear       Int?               @map("fiscal_year")
  periodNumber     Int?               @map("period_number")
  startDate        DateTime           @map("start_date") @db.Date
  endDate          DateTime           @map("end_date") @db.Date
  status           FiscalPeriodStatus @default(OPEN)
  closedAt         DateTime?          @map("closed_at") @db.Timestamptz(6)
  closedByUserId   String?            @map("closed_by_user_id") @db.Uuid
  reopenedAt       DateTime?          @map("reopened_at") @db.Timestamptz(6)
  reopenedByUserId String?            @map("reopened_by_user_id") @db.Uuid
  reopenReason     String?            @map("reopen_reason")
  closeRunId       String?            @map("close_run_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalEntries           JournalEntry[]
  assetDepreciationEntries AssetDepreciationEntry[]
  budgetLines              BudgetLine[]
  closeRuns                PeriodCloseRun[]
  reportSnapshots          FinancialReportSnapshot[]

  @@unique([organizationId, name])
  @@unique([organizationId, fiscalYear, periodNumber])
  @@index([organizationId, status])
  @@index([organizationId, startDate, endDate])
  @@map("fiscal_periods")
}

/// Tenant accounting period close execution record with validation diagnostics.
model PeriodCloseRun {
  id                 String               @id @default(uuid()) @db.Uuid
  organizationId     String               @map("organization_id") @db.Uuid
  fiscalPeriodId     String               @map("fiscal_period_id") @db.Uuid
  initiatedByUserId  String               @map("initiated_by_user_id") @db.Uuid
  status             PeriodCloseRunStatus @default(PENDING)
  startedAt          DateTime             @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?            @map("completed_at") @db.Timestamptz(6)
  validationSummary  String?              @map("validation_summary")
  failureInformation Json?                @map("failure_information")
  idempotencyKey     String?              @map("idempotency_key") @db.VarChar(100)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalPeriod FiscalPeriod       @relation(fields: [fiscalPeriodId], references: [id], onDelete: Cascade)
  checks       PeriodCloseCheck[]

  @@index([organizationId, fiscalPeriodId])
  @@index([organizationId, status])
  @@map("period_close_runs")
}

/// Individual verification and subledger reconciliation check evaluated during period close.
model PeriodCloseCheck {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  closeRunId     String                 @map("close_run_id") @db.Uuid
  checkType      PeriodCloseCheckType   @map("check_type")
  status         PeriodCloseCheckStatus @default(PASSED)
  severity       String                 @default("BLOCKING") @db.VarChar(20) // BLOCKING, WARNING, INFO
  message        String
  affectedCount  Int                    @default(0) @map("affected_count")
  metadata       Json?
  evaluatedAt    DateTime               @default(now()) @map("evaluated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  closeRun     PeriodCloseRun @relation(fields: [closeRunId], references: [id], onDelete: Cascade)

  @@index([organizationId, closeRunId])
  @@index([organizationId, checkType])
  @@map("period_close_checks")
}

/// Immutable historical financial report snapshots with checksum.
model FinancialReportSnapshot {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  fiscalPeriodId    String?            @map("fiscal_period_id") @db.Uuid
  reportType        ReportSnapshotType @map("report_type")
  generatedByUserId String             @map("generated_by_user_id") @db.Uuid
  generatedAt       DateTime           @default(now()) @map("generated_at") @db.Timestamptz(6)
  reportParameters  Json?              @map("report_parameters")
  reportData        Json               @map("report_data")
  checksum          String?            @db.VarChar(64)
  isImmutable       Boolean            @default(true) @map("is_immutable")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalPeriod FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id], onDelete: SetNull)

  @@index([organizationId, reportType])
  @@index([organizationId, fiscalPeriodId])
  @@map("financial_report_snapshots")
}

/// Tenant journal entry representing balanced financial transactions.
model JournalEntry {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  fiscalPeriodId  String             @map("fiscal_period_id") @db.Uuid
  entryNumber     String             @map("entry_number") @db.VarChar(50)
  entryDate       DateTime           @map("entry_date") @db.Date
  description     String?
  status          JournalEntryStatus @default(DRAFT)
  sourceType      String?            @map("source_type") @db.VarChar(50)
  sourceId        String?            @map("source_id") @db.Uuid
  createdByUserId String             @map("created_by_user_id") @db.Uuid
  postedAt        DateTime?          @map("posted_at") @db.Timestamptz(6)
  postedByUserId  String?            @map("posted_by_user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization               Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalPeriod               FiscalPeriod               @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  lines                      JournalLine[]
  payments                   Payment[]
  matchedBankTransactions    BankStatementTransaction[]
  customerCreditNotes        CustomerCreditNote[]
  supplierDebitNotes         SupplierDebitNote[]
  customerRefunds            CustomerRefund[]
  cogsRecords                CostOfGoodsSoldRecord[]
  taxTransactions            TaxTransaction[]
  expenseClaims              ExpenseClaim[]
  fixedAssetsCapitalization  FixedAsset[]               @relation("FixedAssetCapitalizationJournal")
  fixedAssetsDisposal        FixedAsset[]               @relation("FixedAssetDisposalJournal")
  assetDepreciationEntries   AssetDepreciationEntry[]
  payrollRuns                PayrollRun[]
  productionIssueOrders      ProductionOrder[]          @relation("ProductionIssueJournal")
  productionCompletionOrders ProductionOrder[]          @relation("ProductionCompletionJournal")
  productionVarianceOrders   ProductionOrder[]          @relation("ProductionVarianceJournal")

  @@unique([organizationId, entryNumber])
  @@index([organizationId, status])
  @@index([organizationId, fiscalPeriodId])
  @@index([organizationId, entryDate])
  @@index([organizationId, sourceType, sourceId])
  @@map("journal_entries")
}

/// Tenant journal entry line with exact decimal debit and credit values.
model JournalLine {
  id             String   @id @default(uuid()) @db.Uuid
  journalEntryId String   @map("journal_entry_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  description    String?
  debit          Decimal  @default(0) @db.Decimal(20, 4)
  credit         Decimal  @default(0) @db.Decimal(20, 4)
  lineNumber     Int      @map("line_number")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([organizationId, journalEntryId])
  @@index([organizationId, accountId])
  @@map("journal_lines")
}

