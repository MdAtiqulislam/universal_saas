  reportedAt       DateTime               @default(now()) @map("reported_at") @db.Timestamptz(6)
  severity         NonConformanceSeverity @default(MEDIUM)
  status           QualityIssueStatus     @default(REPORTED)
  nonConformanceId String?                @map("non_conformance_id") @db.Uuid
  resolvedAt       DateTime?              @map("resolved_at") @db.Timestamptz(6)
  resolutionNotes  String?                @map("resolution_notes")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder     SalesOrder?      @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  shipment       Shipment?        @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  item           Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant        ItemVariant?     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  batch          InventoryBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  serial         InventorySerial? @relation(fields: [serialId], references: [id], onDelete: SetNull)
  nonConformance NonConformance?  @relation(fields: [nonConformanceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, issueNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, itemId])
  @@map("customer_quality_issues")
}

