// ==============================================================================
// M38 — PLATFORM OBSERVABILITY, RELIABILITY & OPERATIONAL EXCELLENCE
// Enums for incidents, alerting, SLOs, health, and error taxonomy
// ==============================================================================

/// INV-326: Every incident must have a valid severity level.
enum IncidentSeverity {
  SEV1 // Critical — total outage
  SEV2 // Major — significant degradation
  SEV3 // Minor — limited impact
  SEV4 // Low — negligible impact
}

/// INV-332: Incident lifecycle transitions must follow OPEN → ACKNOWLEDGED → INVESTIGATING → MITIGATED → RESOLVED → CLOSED.
enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  MITIGATED
  RESOLVED
  CLOSED
}

/// Operational incident source classification.
enum IncidentSource {
  ALERT
  MANUAL
  AUTOMATED
  EXTERNAL
}

/// Alert rule active/inactive state.
enum AlertRuleStatus {
  ACTIVE
  INACTIVE
}

/// INV-337: Alert lifecycle transitions must follow NORMAL → TRIGGERED → ACKNOWLEDGED → RESOLVED.
enum AlertEventStatus {
  NORMAL
  TRIGGERED
  ACKNOWLEDGED
  RESOLVED
}

/// Alert severity levels for threshold-based rules.
enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

/// INV-348: SLO target must be a valid percentage or threshold.
enum SloStatus {
  HEALTHY
  AT_RISK
  BREACHED
}

/// SLO scope — PLATFORM records are operator-only, TENANT records are tenant-scoped.
/// INV-350: TENANT-scoped SLO records must not leak cross-tenant measurements.
enum SloScope {
  PLATFORM
  TENANT
}

/// INV-328: Operational error severity must use a valid category from this enum.
enum OperationalErrorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// INV-328: Operational error category must be one of these canonical values.
enum OperationalErrorCategory {
  VALIDATION
  AUTHENTICATION
  AUTHORIZATION
  TENANT
  NOT_FOUND
  CONFLICT
  BUSINESS_RULE
  CONCURRENCY
  DATABASE
  EXTERNAL_SERVICE
  BACKGROUND_JOB
  SECURITY
  INTERNAL
}

/// INV-339: Health status must use one of these canonical values.
enum HealthStatus {
  UP
  DEGRADED
  DOWN
  UNKNOWN
}

/// Metric scope — PLATFORM metrics require privileged access. INV-344.
enum MetricScope {
  PLATFORM
  TENANT
}

