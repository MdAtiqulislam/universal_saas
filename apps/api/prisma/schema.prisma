  expectedDate          DateTime?           @map("expected_date") @db.Timestamptz(6)
  paymentTermsDays      Int                 @default(0) @map("payment_terms_days")
  notes                 String?
  supplierReference     String?             @map("supplier_reference") @db.VarChar(100)
  requisitionId         String?             @map("requisition_id") @db.Uuid
  plannedOrderId        String?             @map("planned_order_id") @db.Uuid
  shippingTerms         String?             @map("shipping_terms") @db.VarChar(100)
  subtotal              Decimal             @default(0) @db.Decimal(18, 4)
  taxTotal              Decimal             @default(0) @map("tax_total") @db.Decimal(18, 4)
  discountTotal         Decimal             @default(0) @map("discount_total") @db.Decimal(18, 4)
  shippingTotal         Decimal             @default(0) @map("shipping_total") @db.Decimal(18, 4)
  grandTotal            Decimal             @default(0) @map("grand_total") @db.Decimal(18, 4)
  createdByUserId       String              @map("created_by_user_id") @db.Uuid
