/// Tenant return reasons with inspection & default disposition policy.
model ReturnReason {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  code               String                @db.VarChar(50)
  name               String                @db.VarChar(100)
  description        String?
  requiresInspection Boolean               @default(true) @map("requires_inspection")
  defaultDisposition ReturnDispositionType @default(RESTOCK) @map("default_disposition")
  isActive           Boolean               @default(true) @map("is_active")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  returns      ReturnRequest[]
  lines        ReturnRequestLine[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("return_reasons")
}

/// Tenant configuration for return policy rules and defaults.
model ReturnPolicy {
  id                      String   @id @default(uuid()) @db.Uuid
  organizationId          String   @unique @map("organization_id") @db.Uuid
  returnWindowDays        Int      @default(30) @map("return_window_days")
  requireOriginalShipment Boolean  @default(false) @map("require_original_shipment")
  requireOriginalInvoice  Boolean  @default(false) @map("require_original_invoice")
  allowPartialReturns     Boolean  @default(true) @map("allow_partial_returns")
  requireInspection       Boolean  @default(true) @map("require_inspection")
  autoQuarantine          Boolean  @default(true) @map("auto_quarantine")
  maxReplacementQty       Decimal  @default(100) @map("max_replacement_qty") @db.Decimal(18, 4)
  allowRestocking         Boolean  @default(true) @map("allow_restocking")
  autoCreateCreditNote    Boolean  @default(false) @map("auto_create_credit_note")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("return_policies")
}

/// Tenant Return Merchandise Authorization (RMA) & Return Request Header.
model ReturnRequest {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  returnNumber       String       @map("return_number") @db.VarChar(50)
  returnType         ReturnType   @default(CUSTOMER_RETURN) @map("return_type")
  status             ReturnStatus @default(DRAFT)
  customerId         String?      @map("customer_id") @db.Uuid
  supplierId         String?      @map("supplier_id") @db.Uuid
  salesOrderId       String?      @map("sales_order_id") @db.Uuid
  deliveryOrderId    String?      @map("delivery_order_id") @db.Uuid
  shipmentId         String?      @map("shipment_id") @db.Uuid
  reverseShipmentId  String?      @map("reverse_shipment_id") @db.Uuid
  customerInvoiceId  String?      @map("customer_invoice_id") @db.Uuid
  purchaseOrderId    String?      @map("purchase_order_id") @db.Uuid
  goodsReceiptId     String?      @map("goods_receipt_id") @db.Uuid
  supplierInvoiceId  String?      @map("supplier_invoice_id") @db.Uuid
  inspectionLotId    String?      @map("inspection_lot_id") @db.Uuid
  reasonId           String       @map("reason_id") @db.Uuid
  requestedAt        DateTime     @default(now()) @map("requested_at") @db.Timestamptz(6)
  authorizedAt       DateTime?    @map("authorized_at") @db.Timestamptz(6)
  authorizedByUserId String?      @map("authorized_by_user_id") @db.Uuid
  receivedAt         DateTime?    @map("received_at") @db.Timestamptz(6)
  resolvedAt         DateTime?    @map("resolved_at") @db.Timestamptz(6)
  closedAt           DateTime?    @map("closed_at") @db.Timestamptz(6)
  isImmutable        Boolean      @default(false) @map("is_immutable")
  notes              String?
  authorizationNotes String?      @map("authorization_notes")
  rejectionReason    String?      @map("rejection_reason")
  createdByUserId    String       @map("created_by_user_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier        Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  salesOrder      SalesOrder?           @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  deliveryOrder   DeliveryOrder?        @relation(fields: [deliveryOrderId], references: [id], onDelete: SetNull)
  shipment        Shipment?             @relation("OriginalShipment", fields: [shipmentId], references: [id], onDelete: SetNull)
  reverseShipment Shipment?             @relation("ReverseShipment", fields: [reverseShipmentId], references: [id], onDelete: SetNull)
  customerInvoice CustomerInvoice?      @relation(fields: [customerInvoiceId], references: [id], onDelete: SetNull)
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceipt    GoodsReceipt?         @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  supplierInvoice SupplierInvoice?      @relation(fields: [supplierInvoiceId], references: [id], onDelete: SetNull)
  inspectionLot   QualityInspectionLot? @relation(fields: [inspectionLotId], references: [id], onDelete: SetNull)
  reason          ReturnReason          @relation(fields: [reasonId], references: [id], onDelete: Restrict)

  lines           ReturnRequestLine[]
  dispositions    ReturnDispositionRecord[]
  resolutions     ReturnResolution[]
  serviceRequests ServiceRequest[]
  serviceOrders   ServiceOrder[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, supplierId])
  @@index([organizationId, salesOrderId])
  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, requestedAt])
  @@index([organizationId, status, createdAt])
  @@map("return_requests")
}

/// Tenant Return Request Line item tracking returned material quantities and status.
model ReturnRequestLine {
  id                          String           @id @default(uuid()) @db.Uuid
  organizationId              String           @map("organization_id") @db.Uuid
  returnRequestId             String           @map("return_request_id") @db.Uuid
  itemId                      String           @map("item_id") @db.Uuid
  variantId                   String?          @map("variant_id") @db.Uuid
  sourceLineId                String?          @map("source_line_id") @db.Uuid
  requestedQuantity           Decimal          @map("requested_quantity") @db.Decimal(18, 4)
  authorizedQuantity          Decimal          @default(0) @map("authorized_quantity") @db.Decimal(18, 4)
  shippedReturnQuantity       Decimal          @default(0) @map("shipped_return_quantity") @db.Decimal(18, 4)
  receivedQuantity            Decimal          @default(0) @map("received_quantity") @db.Decimal(18, 4)
  inspectedQuantity           Decimal          @default(0) @map("inspected_quantity") @db.Decimal(18, 4)
  acceptedQuantity            Decimal          @default(0) @map("accepted_quantity") @db.Decimal(18, 4)
  rejectedQuantity            Decimal          @default(0) @map("rejected_quantity") @db.Decimal(18, 4)
  replacementQuantity         Decimal          @default(0) @map("replacement_quantity") @db.Decimal(18, 4)
  financialResolutionQuantity Decimal          @default(0) @map("financial_resolution_quantity") @db.Decimal(18, 4)
  unitPrice                   Decimal          @default(0) @map("unit_price") @db.Decimal(20, 4)
  taxAmount                   Decimal          @default(0) @map("tax_amount") @db.Decimal(20, 4)
  lineAmount                  Decimal          @default(0) @map("line_amount") @db.Decimal(20, 4)
  reasonId                    String?          @map("reason_id") @db.Uuid
  status                      ReturnLineStatus @default(PENDING)
  createdAt                   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest             @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  item          Item                      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant       ItemVariant?              @relation(fields: [variantId], references: [id], onDelete: Restrict)
  reason        ReturnReason?             @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  dispositions  ReturnDispositionRecord[]
  resolutions   ReturnResolution[]

  @@index([organizationId, returnRequestId])
  @@index([organizationId, itemId])
  @@map("return_request_lines")
}

/// Tenant Return Disposition action recorded per return line.
model ReturnDispositionRecord {
  id                String                @id @default(uuid()) @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  returnRequestId   String                @map("return_request_id") @db.Uuid
  returnLineId      String                @map("return_line_id") @db.Uuid
  dispositionType   ReturnDispositionType @map("disposition_type")
  quantity          Decimal               @db.Decimal(18, 4)
  warehouseId       String                @map("warehouse_id") @db.Uuid
  locationId        String                @map("location_id") @db.Uuid
  inspectionLotId   String?               @map("inspection_lot_id") @db.Uuid
  referenceNotes    String?               @map("reference_notes")
  processedByUserId String                @map("processed_by_user_id") @db.Uuid
  processedAt       DateTime              @default(now()) @map("processed_at") @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest         @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  returnLine    ReturnRequestLine     @relation(fields: [returnLineId], references: [id], onDelete: Cascade)
  warehouse     Location              @relation("DispositionWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  location      Location              @relation("DispositionLocation", fields: [locationId], references: [id], onDelete: Restrict)
  inspectionLot QualityInspectionLot? @relation(fields: [inspectionLotId], references: [id], onDelete: SetNull)

  @@index([organizationId, returnRequestId])
  @@index([organizationId, returnLineId])
  @@index([organizationId, dispositionType])
  @@map("return_dispositions")
}

/// Tenant Return Financial / Replacement Resolution linking to M18 Credit/Debit Notes, M15 Refunds, and M28 Replacements.
model ReturnResolution {
  id                      String               @id @default(uuid()) @db.Uuid
  organizationId          String               @map("organization_id") @db.Uuid
  returnRequestId         String               @map("return_request_id") @db.Uuid
  returnLineId            String?              @map("return_line_id") @db.Uuid
  resolutionType          ReturnResolutionType @map("resolution_type")
  amount                  Decimal              @default(0) @db.Decimal(20, 4)
  quantity                Decimal              @default(0) @db.Decimal(18, 4)
  customerCreditNoteId    String?              @map("customer_credit_note_id") @db.Uuid
  customerRefundId        String?              @map("customer_refund_id") @db.Uuid
  supplierDebitNoteId     String?              @map("supplier_debit_note_id") @db.Uuid
  replacementSalesOrderId String?              @map("replacement_sales_order_id") @db.Uuid
  replacementReference    String?              @map("replacement_reference") @db.VarChar(100)
  notes                   String?
  processedByUserId       String               @map("processed_by_user_id") @db.Uuid
  processedAt             DateTime             @default(now()) @map("processed_at") @db.Timestamptz(6)
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  returnRequest         ReturnRequest       @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  returnLine            ReturnRequestLine?  @relation(fields: [returnLineId], references: [id], onDelete: SetNull)
  customerCreditNote    CustomerCreditNote? @relation(fields: [customerCreditNoteId], references: [id], onDelete: SetNull)
  customerRefund        CustomerRefund?     @relation(fields: [customerRefundId], references: [id], onDelete: SetNull)
  supplierDebitNote     SupplierDebitNote?  @relation(fields: [supplierDebitNoteId], references: [id], onDelete: SetNull)
  replacementSalesOrder SalesOrder?         @relation(fields: [replacementSalesOrderId], references: [id], onDelete: SetNull)

  @@index([organizationId, returnRequestId])
  @@index([organizationId, resolutionType])
  @@index([organizationId, customerCreditNoteId])
  @@index([organizationId, customerRefundId])
  @@index([organizationId, supplierDebitNoteId])
  @@map("return_resolutions")
}

