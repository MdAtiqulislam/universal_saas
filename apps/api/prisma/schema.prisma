enum DashboardWidgetType {
  METRIC_CARD
  CHART_LINE
  CHART_BAR
  CHART_PIE
  TABLE
  KPI_SUMMARY
}

/// INV-511: Supported bounded export formats.
enum ExportFormat {
  CSV
  JSON
}

// ==============================================================================
// M45 — ANALYTICS, REPORTING & BUSINESS INTELLIGENCE MODELS
// INV-501: Authorized dataset definitions with immutable key and allowed catalog.
// INV-506: Saved report query configurations with AST filters and limits.
// INV-508: Explicit fine-grained report sharing per user/role/team.
// INV-509: Immutable execution history records with performance telemetry.
// INV-510: Background report schedule configurations with delivery channels.
// INV-512: Composable analytics dashboards with grid layouts.
// INV-513: Dashboard widgets linked to saved reports or direct queries.
// INV-515: Structured audit telemetry for analytics operations.
// ==============================================================================

/// Authoritative metadata definitions for queryable domain datasets.
/// INV-501: definitionKey is unique and acts as registry identifier.
model AnalyticsDefinition {
  id                    String   @id @default(uuid()) @db.Uuid
  definitionKey         String   @unique @map("definition_key") @db.VarChar(100)
  name                  String   @db.VarChar(200)
  domain                String   @db.VarChar(100)
  description           String?  @db.Text
  allowedDimensions     Json     @map("allowed_dimensions")
  allowedMeasures       Json     @map("allowed_measures")
  supportedAggregations String[] @default(["COUNT", "SUM", "AVG", "MIN", "MAX"]) @map("supported_aggregations")
  allowedFilterFields   String[] @default([]) @map("allowed_filter_fields")
  requiredPermissions   String[] @default([]) @map("required_permissions")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  savedReports SavedReport[]

  @@index([domain, isActive])
  @@map("analytics_definitions")
}

/// Tenant-scoped saved report definition.
/// INV-506: Preserves query parameters, AST filters, sorting, and pagination.
model SavedReport {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  definitionKey   String           @map("definition_key") @db.VarChar(100)
  name            String           @db.VarChar(200)
  description     String?          @db.Text
  dimensions      String[]         @default([])
  measures        String[]         @default([])
  filterAst       Json?            @map("filter_ast")
  timeDimension   String?          @map("time_dimension") @db.VarChar(100)
  timeGranularity String?          @map("time_granularity") @db.VarChar(50)
  timeZone        String           @default("UTC") @map("time_zone") @db.VarChar(50)
  limit           Int              @default(50)
  offset          Int              @default(0)
  sortBy          String?          @map("sort_by") @db.VarChar(100)
  sortDirection   String           @default("asc") @map("sort_direction") @db.VarChar(10)
  visibility      ReportVisibility @default(PRIVATE)
  isSystem        Boolean          @default(false) @map("is_system")
  ownerUserId     String           @map("owner_user_id") @db.Uuid
  lastExecutedAt  DateTime?        @map("last_executed_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerUser    User                @relation("ReportOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  definition   AnalyticsDefinition @relation(fields: [definitionKey], references: [definitionKey], onDelete: Restrict)
  shares       ReportShare[]
  schedules    ReportSchedule[]
  executions   ReportExecution[]
  widgets      DashboardWidget[]

  @@index([organizationId, visibility])
  @@index([organizationId, ownerUserId])
  @@index([organizationId, definitionKey])
  @@map("saved_reports")
}

/// Tenant-scoped explicit sharing of saved reports.
/// INV-508: Unique per (savedReportId, shareType, targetId) to eliminate duplicate grants.
model ReportShare {
  id             String          @id @default(uuid()) @db.Uuid
  savedReportId  String          @map("saved_report_id") @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  shareType      ReportShareType @map("share_type")
  targetId       String          @map("target_id") @db.VarChar(128)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  savedReport  SavedReport  @relation(fields: [savedReportId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([savedReportId, shareType, targetId])
  @@index([organizationId, shareType, targetId])
  @@map("report_shares")
}

/// Historical record of report executions.
/// INV-509: Execution tracking with performance metrics and execution ID.
model ReportExecution {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  savedReportId    String?               @map("saved_report_id") @db.Uuid
  executedByUserId String?               @map("executed_by_user_id") @db.Uuid
  executionId      String                @unique @map("execution_id") @db.VarChar(128)
  status           ReportExecutionStatus @default(RUNNING)
  rowCount         Int                   @default(0) @map("row_count")
  durationMs       Int                   @default(0) @map("duration_ms")
  errorMessage     String?               @map("error_message") @db.Text
  snapshotData     Json?                 @map("snapshot_data")
  executedAt       DateTime              @default(now()) @map("executed_at") @db.Timestamptz(6)

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  savedReport  SavedReport? @relation(fields: [savedReportId], references: [id], onDelete: SetNull)

  @@index([organizationId, executedAt])
  @@index([organizationId, status])
  @@index([savedReportId, executedAt])
  @@map("report_executions")
}

/// Scheduled background generation and distribution of reports.
/// INV-510: Cron/frequency configuration with recipient lists and export format.
model ReportSchedule {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  savedReportId  String                  @map("saved_report_id") @db.Uuid
  frequency      ReportScheduleFrequency
  cronExpression String?                 @map("cron_expression") @db.VarChar(100)
  recipients     String[]                @default([])
  channels       String[]                @default(["IN_APP"])
  exportFormat   ExportFormat            @default(CSV) @map("export_format")
  isActive       Boolean                 @default(true) @map("is_active")
  lastRunAt      DateTime?               @map("last_run_at") @db.Timestamptz(6)
  nextRunAt      DateTime?               @map("next_run_at") @db.Timestamptz(6)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  savedReport  SavedReport  @relation(fields: [savedReportId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive, nextRunAt])
  @@map("report_schedules")
}

/// Multi-widget visual business intelligence dashboard.
/// INV-512: Composable layouts with tenant isolation and owner attribution.
model Dashboard {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  name           String              @db.VarChar(200)
  description    String?             @db.Text
  layout         Json?
  visibility     DashboardVisibility @default(PRIVATE)
  isDefault      Boolean             @default(false) @map("is_default")
  ownerUserId    String              @map("owner_user_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerUser    User              @relation("DashboardOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  shares       DashboardShare[]
  widgets      DashboardWidget[]

  @@index([organizationId, visibility])
  @@index([organizationId, ownerUserId])
  @@map("dashboards")
}

/// Tenant-scoped explicit sharing of dashboards.
/// INV-512: Unique per (dashboardId, shareType, targetId).
model DashboardShare {
  id             String          @id @default(uuid()) @db.Uuid
  dashboardId    String          @map("dashboard_id") @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  shareType      ReportShareType @map("share_type")
  targetId       String          @map("target_id") @db.VarChar(128)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  dashboard    Dashboard    @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, shareType, targetId])
  @@index([organizationId, shareType, targetId])
  @@map("dashboard_shares")
}

/// Visual widget placed on a dashboard.
/// INV-513: Links to saved report or direct definition query with grid position.
model DashboardWidget {
  id             String              @id @default(uuid()) @db.Uuid
  dashboardId    String              @map("dashboard_id") @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  savedReportId  String?             @map("saved_report_id") @db.Uuid
  title          String              @db.VarChar(200)
  widgetType     DashboardWidgetType @map("widget_type")
  position       Json
  config         Json?
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  dashboard    Dashboard    @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  savedReport  SavedReport? @relation(fields: [savedReportId], references: [id], onDelete: SetNull)

  @@index([dashboardId])
  @@index([organizationId])
  @@map("dashboard_widgets")
}

/// Audit and operational usage event log for analytics queries and report runs.
/// INV-515: Structured telemetry for usage, performance, and compliance tracking.
model AnalyticsUsageEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  eventType      String   @map("event_type") @db.VarChar(100)
  resourceType   String   @map("resource_type") @db.VarChar(100)
  resourceId     String?  @map("resource_id") @db.VarChar(128)
  durationMs     Int      @default(0) @map("duration_ms")
  rowCount       Int      @default(0) @map("row_count")
  metadata       Json?
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, eventType, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("analytics_usage_events")
}

// ==============================================================================
// M46 — DATA EXPORT, IMPORT & BULK OPERATIONS PLATFORM
// Enums and models for centralized bulk data processing, preview, and tracking
// ==============================================================================

/// INV-526: Distinct data operation types.
enum DataOperationType {
  EXPORT
  IMPORT
}

/// INV-544: State-machine protected lifecycle status.
enum DataOperationStatus {
  PENDING
  PREVIEWING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  PARTIALLY_COMPLETED
}

/// INV-538: Supported import modes.
enum DataImportMode {
  CREATE_ONLY
  UPDATE_ONLY
  UPSERT
}

/// INV-538: Supported duplicate resolution strategies.
enum DataDuplicateStrategy {
  FAIL
  SKIP
  UPDATE
}

/// Centralized execution job record for data exports, imports, and bulk operations.
/// INV-526: Authoritative operationKey.
/// INV-527: Tenant-owned bulk operation jobs.
/// INV-539: Resumable idempotency and completed batch protection.
/// INV-540: Bounded batch execution.
/// INV-541: Tenant-scoped job history and artifact isolation.
model DataOperationJob {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  operationKey     String               @map("operation_key") @db.VarChar(100)
  operationType    DataOperationType    @map("operation_type")
  status           DataOperationStatus  @default(PENDING)
  format           ExportFormat         @default(CSV)
  mode             DataImportMode?
  dryRun           Boolean              @default(false) @map("dry_run")
  totalRows        Int                  @default(0) @map("total_rows")
  processedRows    Int                  @default(0) @map("processed_rows")
  successfulRows   Int                  @default(0) @map("successful_rows")
  failedRows       Int                  @default(0) @map("failed_rows")
  skippedRows      Int                  @default(0) @map("skipped_rows")
  fileKey          String?              @map("file_key") @db.VarChar(500)
  fileSize         Int?                 @map("file_size")
  fileName         String?              @map("file_name") @db.VarChar(255)
  fileMime         String?              @map("file_mime") @db.VarChar(100)
  idempotencyKey   String?              @map("idempotency_key") @db.VarChar(128)
  parameters       Json?
  metadata         Json?
  errorSummary     String?              @map("error_summary") @db.Text
  resultSummary    Json?                @map("result_summary")
  completedBatches Int[]                @default([]) @map("completed_batches")
  startedAt        DateTime?            @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?            @map("completed_at") @db.Timestamptz(6)
  createdById      String?              @map("created_by_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User?                @relation("DataOperationJobUser", fields: [createdById], references: [id], onDelete: SetNull)
  batches       DataOperationBatch[]
  errors        DataOperationError[]

  @@index([organizationId, status])
  @@index([organizationId, operationType, createdAt])
  @@index([organizationId, idempotencyKey])
  @@map("data_operation_jobs")
}

/// Bounded batch execution slice for chunked processing.
/// INV-540: Bounded batch concurrency and size.
model DataOperationBatch {
  id              String           @id @default(uuid()) @db.Uuid
  jobId           String           @map("job_id") @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  batchIndex      Int              @map("batch_index")
  status          String           @default("PENDING") @db.VarChar(30)
  startRow        Int              @map("start_row")
  endRow          Int              @map("end_row")
  rowCount        Int              @map("row_count")
  successfulCount Int              @default(0) @map("successful_count")
  failedCount     Int              @default(0) @map("failed_count")
  error           String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(6)

  // Relationships
  job          DataOperationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([jobId, batchIndex])
  @@index([organizationId, jobId])
  @@map("data_operation_batches")
}

/// Row-level error record for audit, reporting, and forensic review.
/// INV-542: Tenant-scoped and access-controlled error tracking.
model DataOperationError {
  id             String           @id @default(uuid()) @db.Uuid
  jobId          String           @map("job_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  rowNumber      Int              @map("row_number")
  fieldName      String?          @map("field_name") @db.VarChar(100)
  errorCode      String           @map("error_code") @db.VarChar(100)
  errorMessage   String           @map("error_message") @db.Text
  rawValues      Json?            @map("raw_values")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  job          DataOperationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([jobId, rowNumber])
  @@index([organizationId, jobId])
  @@map("data_operation_errors")
}

/// Reusable mapping and configuration template for exports and imports.
model DataOperationTemplate {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  operationKey      String       @map("operation_key") @db.VarChar(100)
  name              String       @db.VarChar(200)
  description       String?      @db.Text
  fieldMappings     Json?        @map("field_mappings")
  defaultParameters Json?        @map("default_parameters")
  createdById       String?      @map("created_by_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, operationKey])
  @@map("data_operation_templates")
}

// ------------------------------------------------------------------------------
// M47.1 — GOVERNANCE FOUNDATION
// Persistent policy/catalog structures only. Runtime governance services are
// intentionally deferred to later M47 phases.
// ------------------------------------------------------------------------------

/// Platform-owned catalog of datasets that may participate in governance.
/// Dataset rows are not tenant data; tenant policy attaches through datasetId.
model GovernanceDataset {
  id                    String                    @id @default(uuid()) @db.Uuid
  datasetKey            String                    @unique @map("dataset_key") @db.VarChar(150)
  displayName           String                    @map("display_name") @db.VarChar(200)
  modelName             String?                   @map("model_name") @db.VarChar(150)
  classification        GovernanceClassification @default(INTERNAL)
  deletionStrategy      GovernanceDeletionStrategy
  retentionApplicable   Boolean                   @default(true) @map("retention_applicable")
  containsPii           Boolean                   @default(false) @map("contains_pii")
  containsSensitiveData Boolean                   @default(false) @map("contains_sensitive_data")
  metadata              Json?
  version               Int                       @default(1)
  isActive              Boolean                   @default(true) @map("is_active")
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  retentionPolicies DataRetentionPolicy[]
  residencyPolicies DataResidencyPolicy[]
  legalHolds        LegalHold[]
  executionBatches DsarExecutionBatch[]

  @@index([isActive, classification])
  @@map("governance_datasets")
}

/// Organization-scoped logical residency policy. This does not imply physical
/// region routing or legal compliance by itself.
model DataResidencyPolicy {
  id                    String                   @id @default(uuid()) @db.Uuid
  organizationId        String                   @map("organization_id") @db.Uuid
  datasetId             String                   @map("dataset_id") @db.Uuid
  jurisdictionCode      String                   @map("jurisdiction_code") @db.VarChar(100)
  residencyTier         GovernanceResidencyTier @default(STANDARD) @map("residency_tier")
  transferPolicy         GovernanceTransferPolicy @default(RESTRICTED) @map("transfer_policy")
  transferConfiguration Json?                    @map("transfer_configuration")
  version               Int                      @default(1)
  effectiveAt           DateTime                 @default(now()) @map("effective_at") @db.Timestamptz(6)
  effectiveMarker       String?                  @map("effective_marker") @db.VarChar(20)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dataset      GovernanceDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict)

  @@unique([organizationId, datasetId, version])
  @@unique([organizationId, datasetId, effectiveMarker])
  @@index([organizationId, datasetId, effectiveAt])
  @@index([jurisdictionCode, residencyTier])
  @@map("data_residency_policies")
}

/// Organization and dataset-specific retention policy definition.
model DataRetentionPolicy {
  id                   String         @id @default(uuid()) @db.Uuid
  organizationId       String         @map("organization_id") @db.Uuid
  datasetId            String         @map("dataset_id") @db.Uuid
  retentionDurationDays Int           @map("retention_duration_days")
  anchor               RetentionAnchor
  enabled              Boolean        @default(true)
  metadata             Json?
  version              Int            @default(1)
  effectiveAt          DateTime       @default(now()) @map("effective_at") @db.Timestamptz(6)
  /// Nullable single-slot marker: later runtime services set this to a
  /// constant only for the current policy and NULL for historical versions.
  effectiveMarker      String?        @map("effective_marker") @db.VarChar(20)
  supersededAt         DateTime?      @map("superseded_at") @db.Timestamptz(6)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dataset      GovernanceDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict)

  @@unique([organizationId, datasetId, version])
  @@unique([organizationId, datasetId, effectiveMarker])
  @@index([organizationId, datasetId, enabled, effectiveAt])
  @@map("data_retention_policies")
}

/// Organization-scoped protection declaration for covered governance targets.
model LegalHold {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  datasetId       String?           @map("dataset_id") @db.Uuid
  targetType      LegalHoldTargetType @map("target_type")
  targetId        String?           @map("target_id") @db.VarChar(255)
  coverage        Json              @default("{}")
  status          LegalHoldStatus   @default(ACTIVE)
  reason          String            @db.Text
  reference       String?           @db.VarChar(255)
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  releasedByUserId String?          @map("released_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  releasedAt      DateTime?         @map("released_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dataset       GovernanceDataset? @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  createdByUser User?             @relation("LegalHoldCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  releasedByUser User?            @relation("LegalHoldReleaser", fields: [releasedByUserId], references: [id], onDelete: SetNull)
  blockedDsars  DsarRequest[]      @relation("DsarBlockedByHold")

  @@index([organizationId, status, targetType])
  @@index([organizationId, datasetId, status])
  @@index([organizationId, targetId])
  @@map("legal_holds")
}

/// Tenant-scoped data-subject request lifecycle foundation.
model DsarRequest {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  requestType       DsarRequestType  @map("request_type")
  status            DsarRequestStatus @default(SUBMITTED)
  subjectUserId     String?          @map("subject_user_id") @db.Uuid
  subjectReference  String?          @map("subject_reference") @db.VarChar(255)
  requesterUserId   String           @map("requester_user_id") @db.Uuid
  verificationData  Json?            @map("verification_data")
  verifiedAt        DateTime?        @map("verified_at") @db.Timestamptz(6)
  verifiedByUserId  String?          @map("verified_by_user_id") @db.Uuid
  reviewedAt        DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  reviewedByUserId  String?          @map("reviewed_by_user_id") @db.Uuid
  approvedAt        DateTime?        @map("approved_at") @db.Timestamptz(6)
  approvedByUserId  String?          @map("approved_by_user_id") @db.Uuid
  idempotencyKey    String           @map("idempotency_key") @db.VarChar(255)
  requestMetadata   Json?            @map("request_metadata")
  failureCode       String?          @map("failure_code") @db.VarChar(100)
  failureMessage    String?          @map("failure_message") @db.Text
  blockedByHoldId   String?          @map("blocked_by_hold_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt       DateTime?        @map("completed_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subject      User?              @relation("DsarSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  requester    User               @relation("DsarRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  verifier     User?              @relation("DsarVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  reviewer     User?              @relation("DsarReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  approver     User?              @relation("DsarApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  blockedByHold LegalHold?        @relation("DsarBlockedByHold", fields: [blockedByHoldId], references: [id], onDelete: SetNull)
  executionBatches DsarExecutionBatch[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, requestType, status])
  @@index([organizationId, subjectUserId])
  @@map("dsar_requests")
}

/// Bounded, resumable execution unit for a DSAR request.
model DsarExecutionBatch {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  dsarRequestId   String          @map("dsar_request_id") @db.Uuid
  datasetId       String?         @map("dataset_id") @db.Uuid
  batchSequence   Int             @map("batch_sequence")
  status          DsarBatchStatus @default(PENDING)
  totalItems      Int             @default(0) @map("total_items")
  processedItems  Int             @default(0) @map("processed_items")
  retryCount      Int             @default(0) @map("retry_count")
  cursor          Json?
  failureCode     String?         @map("failure_code") @db.VarChar(100)
  failureMessage  String?         @map("failure_message") @db.Text
  startedAt       DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request      DsarRequest       @relation(fields: [dsarRequestId], references: [id], onDelete: Cascade)
  dataset      GovernanceDataset? @relation(fields: [datasetId], references: [id], onDelete: Restrict)

  @@unique([dsarRequestId, batchSequence])
  @@index([organizationId, status, createdAt])
  @@index([dsarRequestId, status])
  @@index([organizationId, datasetId])
  @@map("dsar_execution_batches")
}
