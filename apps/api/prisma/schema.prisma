  @@index([organizationId, itemId, locationId])
  @@index([organizationId, itemId, variantId, locationId])
  @@map("inventory_valuations")
}

/// Immutable record of Cost of Goods Sold and inventory issue valuation.
model CostOfGoodsSoldRecord {
