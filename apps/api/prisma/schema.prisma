// ------------------------------------------------------------------------------
// TAX, VAT & COMPLIANCE MODELS (M20)
// ------------------------------------------------------------------------------

/// Tenant tax jurisdictions (Country, State/Province, City, Special Economic Zone).
model TaxJurisdiction {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  code                 String           @db.VarChar(50)
  name                 String           @db.VarChar(100)
  countryCode          String           @map("country_code") @db.VarChar(2)
  type                 JurisdictionType @default(COUNTRY)
  parentJurisdictionId String?          @map("parent_jurisdiction_id") @db.Uuid
  isActive             Boolean          @default(true) @map("is_active")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentJurisdiction TaxJurisdiction?  @relation("JurisdictionHierarchy", fields: [parentJurisdictionId], references: [id], onDelete: SetNull)
  childJurisdictions TaxJurisdiction[] @relation("JurisdictionHierarchy")
  taxCodes           TaxCode[]
  taxRules           TaxRule[]
  taxTransactions    TaxTransaction[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([organizationId, parentJurisdictionId])
  @@map("tax_jurisdictions")
}

/// Tenant tax codes (STANDARD_VAT, ZERO_RATED, EXEMPT, OUT_OF_SCOPE, etc.).
model TaxCode {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(50)
  name           String   @db.VarChar(100)
  description    String?
  taxType        TaxType  @default(VAT) @map("tax_type")
  taxScope       TaxScope @default(BOTH) @map("tax_scope")
  jurisdictionId String?  @map("jurisdiction_id") @db.Uuid
  isExempt       Boolean  @default(false) @map("is_exempt")
  isZeroRated    Boolean  @default(false) @map("is_zero_rated")
  isSystem       Boolean  @default(false) @map("is_system")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jurisdiction      TaxJurisdiction?   @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  rates             EffectiveTaxRate[]
  rules             TaxRule[]
  taxTransactions   TaxTransaction[]
  expenseCategories ExpenseCategory[]
  expenseClaimLines ExpenseClaimLine[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([organizationId, taxType])
  @@map("tax_codes")
}

/// Tenant effective-dated tax rates for historical and future rate scheduling.
model EffectiveTaxRate {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  taxCodeId      String    @map("tax_code_id") @db.Uuid
  rate           Decimal   @db.Decimal(12, 4) // e.g. 0.2000 for 20%
  effectiveFrom  DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo    DateTime? @map("effective_to") @db.Timestamptz(6)
  isInclusive    Boolean   @default(false) @map("is_inclusive")
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxCode      TaxCode      @relation(fields: [taxCodeId], references: [id], onDelete: Cascade)

  @@index([organizationId, taxCodeId])
  @@index([organizationId, effectiveFrom, effectiveTo])
  @@map("effective_tax_rates")
}

/// Tenant deterministic tax determination rules.
model TaxRule {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  name            String                 @db.VarChar(100)
  priority        Int                    @default(100) // Lower number = higher precedence
  transactionType TaxRuleTransactionType @default(BOTH) @map("transaction_type")
  taxCodeId       String                 @map("tax_code_id") @db.Uuid
  jurisdictionId  String?                @map("jurisdiction_id") @db.Uuid
  customerGroupId String?                @map("customer_group_id") @db.Uuid
  customerId      String?                @map("customer_id") @db.Uuid
  supplierId      String?                @map("supplier_id") @db.Uuid
  itemCategoryId  String?                @map("item_category_id") @db.Uuid
  itemId          String?                @map("item_id") @db.Uuid
  effectiveFrom   DateTime?              @map("effective_from") @db.Timestamptz(6)
  effectiveTo     DateTime?              @map("effective_to") @db.Timestamptz(6)
  isActive        Boolean                @default(true) @map("is_active")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxCode       TaxCode          @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  jurisdiction  TaxJurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  customerGroup CustomerGroup?   @relation(fields: [customerGroupId], references: [id], onDelete: SetNull)
  customer      Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier      Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  itemCategory  Category?        @relation(fields: [itemCategoryId], references: [id], onDelete: SetNull)
  item          Item?            @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([organizationId, priority])
  @@index([organizationId, transactionType])
  @@index([organizationId, isActive])
  @@map("tax_rules")
}

/// Tenant authoritative immutable tax transaction ledger.
model TaxTransaction {
  id                         String   @id @default(uuid()) @db.Uuid
  organizationId             String   @map("organization_id") @db.Uuid
  taxCodeId                  String   @map("tax_code_id") @db.Uuid
  jurisdictionId             String?  @map("jurisdiction_id") @db.Uuid
  journalEntryId             String?  @map("journal_entry_id") @db.Uuid
  taxPeriodId                String?  @map("tax_period_id") @db.Uuid
  transactionDate            DateTime @map("transaction_date") @db.Timestamptz(6)
  taxScope                   TaxScope @map("tax_scope") // INPUT or OUTPUT
  sourceType                 String   @map("source_type") @db.VarChar(50)
  sourceId                   String   @map("source_id") @db.VarChar(100)
  sourceNumber               String?  @map("source_number") @db.VarChar(100)
  currencyCode               String   @default("USD") @map("currency_code") @db.VarChar(3)
  taxableAmount              Decimal  @map("taxable_amount") @db.Decimal(20, 4)
  taxRate                    Decimal  @map("tax_rate") @db.Decimal(12, 4)
  taxAmount                  Decimal  @map("tax_amount") @db.Decimal(20, 4)
  isReversal                 Boolean  @default(false) @map("is_reversal")
  reversalOfTaxTransactionId String?  @map("reversal_of_tax_transaction_id") @db.Uuid
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxCode               TaxCode          @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  jurisdiction          TaxJurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  journalEntry          JournalEntry?    @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  taxPeriod             TaxPeriod?       @relation(fields: [taxPeriodId], references: [id], onDelete: SetNull)
  reversalOfTransaction TaxTransaction?  @relation("TaxReversalHistory", fields: [reversalOfTaxTransactionId], references: [id], onDelete: SetNull)
  reversals             TaxTransaction[] @relation("TaxReversalHistory")

  @@unique([organizationId, sourceType, sourceId, taxCodeId, isReversal])
  @@index([organizationId, transactionDate])
  @@index([organizationId, taxScope])
  @@index([organizationId, taxPeriodId])
  @@index([organizationId, taxCodeId])
  @@map("tax_transactions")
}

/// Tenant generic tax filing period and compliance summaries.
model TaxPeriod {
  id                    String          @id @default(uuid()) @db.Uuid
  organizationId        String          @map("organization_id") @db.Uuid
  name                  String          @db.VarChar(100) // e.g. "2026-07", "2026-Q3"
  startDate             DateTime        @map("start_date") @db.Timestamptz(6)
  endDate               DateTime        @map("end_date") @db.Timestamptz(6)
  status                TaxPeriodStatus @default(OPEN)
  totalTaxableSales     Decimal         @default(0) @map("total_taxable_sales") @db.Decimal(20, 4)
  totalOutputTax        Decimal         @default(0) @map("total_output_tax") @db.Decimal(20, 4)
  totalTaxablePurchases Decimal         @default(0) @map("total_taxable_purchases") @db.Decimal(20, 4)
  totalInputTax         Decimal         @default(0) @map("total_input_tax") @db.Decimal(20, 4)
  netTaxPayable         Decimal         @default(0) @map("net_tax_payable") @db.Decimal(20, 4)
  preparedAt            DateTime?       @map("prepared_at") @db.Timestamptz(6)
  preparedByUserId      String?         @map("prepared_by_user_id") @db.Uuid
  lockedAt              DateTime?       @map("locked_at") @db.Timestamptz(6)
  lockedByUserId        String?         @map("locked_by_user_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxTransactions TaxTransaction[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([organizationId, startDate, endDate])
  @@map("tax_periods")
}

// ------------------------------------------------------------------------------
// EXPENSE MANAGEMENT & EMPLOYEE REIMBURSEMENTS MODELS (M21)
// ------------------------------------------------------------------------------

/// Tenant expense categories with default GL account and tax mapping.
model ExpenseCategory {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String    @db.VarChar(50)
  name           String    @db.VarChar(100)
  description    String?
  glAccountId    String?   @map("gl_account_id") @db.Uuid
  taxCodeId      String?   @map("tax_code_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  glAccount    Account?           @relation(fields: [glAccountId], references: [id], onDelete: SetNull)
  taxCode      TaxCode?           @relation(fields: [taxCodeId], references: [id], onDelete: SetNull)
