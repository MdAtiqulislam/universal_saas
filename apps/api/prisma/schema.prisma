/// Tenant installed customer asset / equipment registry for after-sales service and warranty tracking.
model CustomerAsset {
  id                   String                     @id @default(uuid()) @db.Uuid
  organizationId       String                     @map("organization_id") @db.Uuid
  assetNumber          String                     @map("asset_number") @db.VarChar(50)
  customerId           String                     @map("customer_id") @db.Uuid
  itemId               String                     @map("item_id") @db.Uuid
  variantId            String?                    @map("variant_id") @db.Uuid
  serialId             String?                    @map("serial_id") @db.Uuid
  serialNumber         String?                    @map("serial_number") @db.VarChar(100)
  originalSalesOrderId String?                    @map("original_sales_order_id") @db.Uuid
  deliveryOrderId      String?                    @map("delivery_order_id") @db.Uuid
  shipmentId           String?                    @map("shipment_id") @db.Uuid
  customerInvoiceId    String?                    @map("customer_invoice_id") @db.Uuid
  installationDate     DateTime?                  @map("installation_date") @db.Date
  purchaseDate         DateTime                   @map("purchase_date") @db.Date
  warrantyStartDate    DateTime                   @map("warranty_start_date") @db.Date
  warrantyEndDate      DateTime                   @map("warranty_end_date") @db.Date
  warrantyStatus       WarrantyStatus             @default(ACTIVE) @map("warranty_status")
  serviceStatus        CustomerAssetServiceStatus @default(OPERATIONAL) @map("service_status")
  locationAddress      String?                    @map("location_address")
  notes                String?
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  item               Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant            ItemVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  serial             InventorySerial? @relation(fields: [serialId], references: [id], onDelete: SetNull)
  originalSalesOrder SalesOrder?      @relation("CustomerAssetSalesOrder", fields: [originalSalesOrderId], references: [id], onDelete: SetNull)
  deliveryOrder      DeliveryOrder?   @relation(fields: [deliveryOrderId], references: [id], onDelete: SetNull)
  shipment           Shipment?        @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  customerInvoice    CustomerInvoice? @relation(fields: [customerInvoiceId], references: [id], onDelete: SetNull)

  warranties       CustomerAssetWarranty[]
  serviceRequests  ServiceRequest[]
  serviceTickets   ServiceTicket[]
  serviceEstimates ServiceEstimate[]
  serviceOrders    ServiceOrder[]

  @@unique([organizationId, assetNumber])
  @@index([organizationId, customerId])
  @@index([organizationId, itemId])
  @@index([organizationId, serialNumber])
  @@index([organizationId, warrantyStatus])
  @@index([organizationId, serviceStatus])
