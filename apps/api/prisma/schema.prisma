// M44 — UNIFIED SEARCH, DISCOVERY & SAVED VIEWS FOUNDATION
// Enums for search scopes, saved view visibility, sharing, and alert triggers
// ==============================================================================

enum SearchScope {
  GLOBAL
  CRM
  SALES
  INVENTORY
  WAREHOUSE
  QUALITY
  RETURNS
  SERVICE
  FINANCE
  WORKFLOW
  NOTIFICATIONS
  DEVELOPER
  BILLING
  ADMIN
}

enum SavedViewVisibility {
  PERSONAL
  SHARED
  TENANT
}

enum SavedViewShareType {
  USER
  ROLE
  TEAM
  TENANT
}

enum SearchAlertTriggerType {
  NEW_MATCH
  STATUS_CHANGE
  THRESHOLD_CROSSED
}

enum SearchAlertStatus {
  ACTIVE
  PAUSED
  TRIGGERED
  FAILED
}

// ==============================================================================
// M44 — UNIFIED SEARCH MODELS
// INV-476: Search definitions are globally unique by authoritative key.
// INV-477: Tenant-owned search configuration belongs to exactly one organization.
// INV-478: Search execution cannot return records outside the caller's tenant.
// INV-479: Search execution cannot return records the caller is unauthorized to access.
// INV-486: Search history belongs to exactly one user within one tenant.
// INV-488: Recent items are tenant and user scoped.
// INV-489: Favorites are unique per user, tenant, and resource identity.
// INV-491: Personal saved views are accessible only by their owner.
// INV-492: Shared saved views can only be shared with valid same-tenant principals.
// INV-495: Search alerts are tenant/user scoped and reference valid saved searches.
// INV-496: Search alert executions are idempotent.
// ==============================================================================

model SearchDefinition {
  id                 String      @id @default(uuid()) @db.Uuid
  key                String      @unique @db.VarChar(100)
  scope              SearchScope
  displayName        String      @map("display_name") @db.VarChar(200)
  resourceType       String      @map("resource_type") @db.VarChar(100)
  tableName          String      @map("table_name") @db.VarChar(100)
  searchableFields   String[]    @map("searchable_fields") @default([])
  filterableFields   String[]    @map("filterable_fields") @default([])
  defaultSortField   String      @default("createdAt") @map("default_sort_field") @db.VarChar(100)
  requiredPermission String      @map("required_permission") @db.VarChar(100)
  icon               String?     @db.VarChar(50)
  isEnabled          Boolean     @default(true) @map("is_enabled")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([scope, isEnabled])
  @@map("search_definitions")
}

