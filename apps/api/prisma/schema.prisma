  requestNumber        String               @map("request_number") @db.VarChar(50)
  customerId           String               @map("customer_id") @db.Uuid
  customerAssetId      String?              @map("customer_asset_id") @db.Uuid
  itemId               String               @map("item_id") @db.Uuid
  variantId            String?              @map("variant_id") @db.Uuid
  serialNumber         String?              @map("serial_number") @db.VarChar(100)
  requestType          ServiceRequestType   @default(REPAIR) @map("request_type")
  priority             ServicePriority      @default(NORMAL)
  issueCategory        String               @map("issue_category") @db.VarChar(100)
  subject              String               @db.VarChar(255)
  description          String
  sourceRmaId          String?              @map("source_rma_id") @db.Uuid
  requestedAt          DateTime             @default(now()) @map("requested_at") @db.Timestamptz(6)
  preferredServiceDate DateTime?            @map("preferred_service_date") @db.Date
  warrantyEligibility  Json?                @map("warranty_eligibility")
  status               ServiceRequestStatus @default(SUBMITTED)
  createdByUserId      String               @map("created_by_user_id") @db.Uuid
  triagedByUserId      String?              @map("triaged_by_user_id") @db.Uuid
  triagedAt            DateTime?            @map("triaged_at") @db.Timestamptz(6)
  triageNotes          String?              @map("triage_notes")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerAsset CustomerAsset?  @relation(fields: [customerAssetId], references: [id], onDelete: SetNull)
  item          Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant       ItemVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sourceRma     ReturnRequest?  @relation(fields: [sourceRmaId], references: [id], onDelete: SetNull)
  tickets       ServiceTicket[]

  @@unique([organizationId, requestNumber])
  @@index([organizationId, customerId])
  @@index([organizationId, customerAssetId])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, sourceRmaId])
  @@map("service_requests")
}

/// Tenant service ticket tracking SLA, triage, technician assignment, diagnosis, and progression.
model ServiceTicket {
  id                   String              @id @default(uuid()) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  ticketNumber         String              @map("ticket_number") @db.VarChar(50)
  serviceRequestId     String?             @map("service_request_id") @db.Uuid
  customerId           String              @map("customer_id") @db.Uuid
  customerAssetId      String?             @map("customer_asset_id") @db.Uuid
  itemId               String              @map("item_id") @db.Uuid
  variantId            String?             @map("variant_id") @db.Uuid
  priority             ServicePriority     @default(NORMAL)
  status               ServiceTicketStatus @default(OPEN)
  slaStatus            ServiceSlaStatus    @default(ON_TRACK) @map("sla_status")
  openedAt             DateTime            @default(now()) @map("opened_at") @db.Timestamptz(6)
  firstResponseDueAt   DateTime?           @map("first_response_due_at") @db.Timestamptz(6)
  firstResponseAt      DateTime?           @map("first_response_at") @db.Timestamptz(6)
  resolutionDueAt      DateTime?           @map("resolution_due_at") @db.Timestamptz(6)
  resolvedAt           DateTime?           @map("resolved_at") @db.Timestamptz(6)
  breachReason         String?             @map("breach_reason")
  assignedTechnicianId String?             @map("assigned_technician_id") @db.Uuid
  assignedAt           DateTime?           @map("assigned_at") @db.Timestamptz(6)
  subject              String              @db.VarChar(255)
  description          String
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceRequest     ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  customer           Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerAsset      CustomerAsset?  @relation(fields: [customerAssetId], references: [id], onDelete: SetNull)
  item               Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant            ItemVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  assignedTechnician Employee?       @relation("TicketTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)

  assignments   ServiceAssignment[]
  diagnoses     ServiceDiagnosis[]
  estimates     ServiceEstimate[]
  serviceOrders ServiceOrder[]

  @@unique([organizationId, ticketNumber])
  @@index([organizationId, customerId])
  @@index([organizationId, customerAssetId])
  @@index([organizationId, status])
  @@index([organizationId, slaStatus])
  @@index([organizationId, assignedTechnicianId])
  @@map("service_tickets")
}

/// Tenant technician service assignment record for ticket or service order.
