  sourceReference String?               @map("source_reference") @db.VarChar(100)
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  postedByUserId  String?               @map("posted_by_user_id") @db.Uuid
  postedAt        DateTime?             @map("posted_at") @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier           Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  currency           Currency                   @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  purchaseOrder      PurchaseOrder?             @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
