# ==============================================================================
# Environment Configuration Template (Universal Business Operations SaaS)
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# DO NOT commit real production credentials or secrets to version control.
# ==============================================================================

# Application Environment (development | test | production)
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=universal_saas
DATABASE_SCHEMA=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/universal_saas?schema=public"

# ------------------------------------------------------------------------------
# Cache & Queues (Redis - optional / future architecture)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# Authentication / JWT Configuration
# ------------------------------------------------------------------------------
JWT_SECRET="change-this-jwt-secret-in-production-min-32-chars"
JWT_REFRESH_SECRET="change-this-jwt-refresh-secret-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# Ports & Application URLs
# ------------------------------------------------------------------------------
PORT=3001
API_PORT=3001
WEB_PORT=3000
API_URL="http://localhost:3001/api/v1"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Next.js Public Variables (exposed to browser)
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_APP_NAME="Universal SaaS"

# ------------------------------------------------------------------------------
# Object Storage (S3 / MinIO - placeholder for file attachments / documents)
# ------------------------------------------------------------------------------
S3_ENDPOINT="localhost"
S3_PORT=9000
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="universal-saas"
S3_REGION="us-east-1"
S3_USE_SSL="false"
